  <bpmn:error id="Error_TREATMENT_REQUEST_UNAUTHORISED" name="Treatment booking request is not authorised" errorCode="TREATMENT_REQUEST_UNAUTHORISED" />
  <bpmn:error id="Error_CHARGE_CALCULATION_FAILED" name="Applicable charge could not be calculated" errorCode="CHARGE_CALCULATION_FAILED" />
  <bpmn:collaboration id="Collaboration_HospitalPatientPathway">
    <bpmn:participant id="P_Patient" name="Patient or authorised representative" />
    <bpmn:participant id="P_ReferringOrg" name="Referring Organisation (GP surgery or other hospital)" />
    <bpmn:participant id="P_MedicalSecretaries" name="Medical Secretaries" processRef="medical-secretaries" />
    <bpmn:participant id="P_Consultants" name="Consultants" processRef="consultants" />
    <bpmn:participant id="P_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team" processRef="treatment-bookings" />
    <bpmn:participant id="P_ExternalClinicalServices" name="External Treatment, Laboratory and Imaging Services" />
    <bpmn:participant id="P_Finance" name="Finance Team" processRef="finance-team" />
    <bpmn:participant id="P_OutpatientBookings" name="Outpatient Bookings Team" processRef="outpatient-bookings" />
    <bpmn:participant id="P_PathwayCoordinators" name="Patient Pathway Coordinators" processRef="patient-pathway-coordinators" />
    <bpmn:participant id="P_CallHandling" name="Call Handling Team" processRef="call-handling" />
    <bpmn:participant id="P_ClinicalNurseSpecialist" name="Clinical Nurse Specialist Team" processRef="clinical-nurse-specialists" />
    <bpmn:participant id="P_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="P_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:participant id="P_ExternalScheduling" name="External Scheduling Service" />
    <bpmn:participant id="P_AdministrativeManagement" name="Administrative Management Team" processRef="administrative-management" />
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="P_ReferringOrg" targetRef="SEC_Start_Referral" />
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="P_ReferringOrg" targetRef="SEC_Catch_InfoReceived" />
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="SEC_Throw_InfoRequested" targetRef="P_ReferringOrg" />
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="SEC_Throw_OutcomeToReferrer" targetRef="P_ReferringOrg" />
    <bpmn:messageFlow id="MessageFlow_05" sourceRef="SUB_Secretaries_Dispatch" targetRef="P_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_06" sourceRef="CON_Throw_Accepted" targetRef="OUT_Start_ReferralAccepted" />
    <bpmn:messageFlow id="MessageFlow_07" sourceRef="CON_Throw_Rejected" targetRef="SEC_Start_Outcome" />
    <bpmn:messageFlow id="MessageFlow_08" sourceRef="CON_Throw_Redirected" targetRef="SEC_Start_Outcome" />
    <bpmn:messageFlow id="MessageFlow_09" sourceRef="CON_Throw_MoreInfoNeeded" targetRef="SEC_Start_Outcome" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="CON_Throw_BookingRequested" targetRef="TRT_Start_BookingRequest" />
    <bpmn:messageFlow id="MessageFlow_11" sourceRef="CON_Throw_TreatmentDeclined" targetRef="OUT_Start_TreatmentDeclined" />
    <bpmn:messageFlow id="MessageFlow_12" sourceRef="CON_Throw_CycleApproved" targetRef="TRT_Start_CycleApproved" />
    <bpmn:messageFlow id="MessageFlow_13" sourceRef="CON_Throw_CycleDelayed" targetRef="TRT_Start_CycleDelayed" />
    <bpmn:messageFlow id="MessageFlow_14" sourceRef="CON_Throw_PlanChanged" targetRef="TRT_Start_Modification" />
    <bpmn:messageFlow id="MessageFlow_15" sourceRef="CON_Throw_ModificationUrgent" targetRef="TRT_Start_ModificationAuthorised" />
    <bpmn:messageFlow id="MessageFlow_16" sourceRef="CON_Throw_ModificationRoutine" targetRef="TRT_Start_ModificationAuthorised" />
    <bpmn:messageFlow id="MessageFlow_17" sourceRef="CON_Throw_ModificationFinance" targetRef="FIN_Start_ImpactReview" />
    <bpmn:messageFlow id="MessageFlow_18" sourceRef="CON_Throw_LetterApproved" targetRef="SEC_Start_LetterApproved" />
    <bpmn:messageFlow id="MessageFlow_19" sourceRef="CON_Throw_LetterOverdue" targetRef="PCW_Start_LetterOverdue" />
    <bpmn:messageFlow id="MessageFlow_20" sourceRef="CON_Throw_LetterReapproved" targetRef="SEC_Start_LetterApproved" />
    <bpmn:messageFlow id="MessageFlow_21" sourceRef="CON_Throw_UrgencyDecision" targetRef="TRT_Catch_UrgencyDecision" />
    <bpmn:messageFlow id="MessageFlow_22" sourceRef="CON_Throw_FollowUpRequested" targetRef="OUT_Start_FollowUp" />
    <bpmn:messageFlow id="MessageFlow_23" sourceRef="CON_Throw_ClinicalReviewOutcome" targetRef="CNS_Catch_ClinicalReview" />
    <bpmn:messageFlow id="MessageFlow_24" sourceRef="P_Patient" targetRef="CON_Start_AppointmentAttended" />
    <bpmn:messageFlow id="MessageFlow_25" sourceRef="OUT_Throw_PhoneContact" targetRef="CALL_Start_PhoneContact" />
    <bpmn:messageFlow id="MessageFlow_26" sourceRef="OUT_Throw_NoSlotEscalation" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_27" sourceRef="P_Patient" targetRef="OUT_Start_Cancelled" />
    <bpmn:messageFlow id="MessageFlow_28" sourceRef="OUT_Throw_FollowUpEscalation" targetRef="PCW_Start_FollowUpDelay" />
    <bpmn:messageFlow id="MessageFlow_29" sourceRef="OUT_Throw_ClinicalReviewOfPathway" targetRef="CON_Start_PathwayReview" />
    <bpmn:messageFlow id="MessageFlow_30" sourceRef="OUT_Throw_ReferrerNotified" targetRef="P_ReferringOrg" />
    <bpmn:messageFlow id="MessageFlow_31" sourceRef="OUT_Throw_FinanceReview" targetRef="FIN_Start_Refund" />
    <bpmn:messageFlow id="MessageFlow_32" sourceRef="OUT_Throw_DeclineToClinical" targetRef="CON_Start_PathwayReview" />
    <bpmn:messageFlow id="MessageFlow_33" sourceRef="OUT_Throw_EnquiryAnswered" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:messageFlow id="MessageFlow_34" sourceRef="TRT_Throw_FundingCheck" targetRef="FIN_Start_FundingCheck" />
    <bpmn:messageFlow id="MessageFlow_35" sourceRef="TRT_Throw_UrgencyAuthorisation" targetRef="CON_Start_UrgencyAuthorisation" />
    <bpmn:messageFlow id="MessageFlow_36" sourceRef="TRT_Throw_PaymentUnresolved" targetRef="P_Finance" />
    <bpmn:messageFlow id="MessageFlow_37" sourceRef="TRT_Throw_Investigation" targetRef="FIN_Start_PaymentInvestigation" />
    <bpmn:messageFlow id="MessageFlow_38" sourceRef="TRT_Throw_LetterDraftRequested" targetRef="CON_Start_LetterDraft" />
    <bpmn:messageFlow id="MessageFlow_39" sourceRef="TRT_Throw_BookingPending" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_40" sourceRef="TRT_Throw_NextReviewDue" targetRef="CON_Start_CycleReview" />
    <bpmn:messageFlow id="MessageFlow_41" sourceRef="TRT_Throw_CycleCapacityIssue" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_42" sourceRef="TRT_Throw_DelayNotified" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_43" sourceRef="TRT_Throw_ModificationToClinical" targetRef="CON_Start_ChangeRequest" />
    <bpmn:messageFlow id="MessageFlow_44" sourceRef="TRT_Throw_ModificationFinance" targetRef="FIN_Start_ImpactReview" />
    <bpmn:messageFlow id="MessageFlow_45" sourceRef="FIN_Throw_FundingDecision" targetRef="TRT_Catch_FundingDecision" />
    <bpmn:messageFlow id="MessageFlow_46" sourceRef="FIN_Throw_InvestigationResolved" targetRef="P_TreatmentBookings" />
    <bpmn:messageFlow id="MessageFlow_47" sourceRef="FIN_Throw_RefundDelayed" targetRef="P_Patient" />
    <bpmn:messageFlow id="MessageFlow_48" sourceRef="FIN_Throw_NoRefund" targetRef="P_Patient" />
    <bpmn:messageFlow id="MessageFlow_49" sourceRef="FIN_Throw_FinanceOutcome" targetRef="P_TreatmentBookings" />
    <bpmn:messageFlow id="MessageFlow_50" sourceRef="FIN_Throw_EnquiryAnswered" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:messageFlow id="MessageFlow_51" sourceRef="CNS_Throw_ToConsultant" targetRef="CON_Start_ClinicalReview" />
    <bpmn:messageFlow id="MessageFlow_52" sourceRef="CNS_Throw_Resolved" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:messageFlow id="MessageFlow_53" sourceRef="CNS_Throw_UrgentEscalation" targetRef="P_PathwayCoordinators" />
    <bpmn:messageFlow id="MessageFlow_54" sourceRef="CALL_Throw_UrgentClinical" targetRef="CNS_Start_UrgentEnquiry" />
    <bpmn:messageFlow id="MessageFlow_55" sourceRef="CALL_Throw_Clinical" targetRef="CNS_Start_Enquiry" />
    <bpmn:messageFlow id="MessageFlow_56" sourceRef="CALL_Throw_Finance" targetRef="FIN_Start_Enquiry" />
    <bpmn:messageFlow id="MessageFlow_57" sourceRef="CALL_Throw_AdminTeam" targetRef="OUT_Start_AdminEnquiry" />
    <bpmn:messageFlow id="MessageFlow_58" sourceRef="P_Patient" targetRef="CALL_Start_Enquiry" />
    <bpmn:messageFlow id="MessageFlow_59" sourceRef="CALL_Throw_ContactFinished" targetRef="OUT_Catch_PhoneContact" />
    <bpmn:messageFlow id="MessageFlow_60" sourceRef="SUB_CallHandling_Contact" targetRef="OUT_Catch_PhoneContact" />
    <bpmn:messageFlow id="MessageFlow_61" sourceRef="PCW_Throw_Reminder" targetRef="CON_Bnd_LetterReminder" />
    <bpmn:messageFlow id="MessageFlow_62" sourceRef="PCW_Throw_EscalateManager" targetRef="ADM_Start_ManagerEscalation" />
    <bpmn:messageFlow id="MessageFlow_63" sourceRef="PCW_Throw_EscalateHigher" targetRef="ADM_Start_HigherEscalation" />
    <bpmn:messageFlow id="MessageFlow_64" sourceRef="PCW_Throw_DelayToClinical" targetRef="CON_Start_PathwayReview" />
    <bpmn:messageFlow id="MessageFlow_65" sourceRef="TRT_Throw_BookingPending2" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_66" sourceRef="TRT_Throw_FundingDelay" targetRef="PCW_Start_FundingDelay" />
    <bpmn:textAnnotation id="Note_SEC_1">
      <bpmn:text>Check referral pack against the document checklist - Secretaries check the pack and chase what is missing. They never record a view on whether the referral is clinically suitable.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_SEC_2">
      <bpmn:text>Is the referral pack complete? - Nothing reaches a clinician without a complete pack, and nothing reaches a patient without an authorised clinical decision behind it.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_CON_1">
      <bpmn:text>What is the clinical decision? - Accept, reject, redirect or ask for more clinical detail. The reason and the deciding clinician are recorded and cannot be edited afterwards.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_CON_2">
      <bpmn:text>Draft and approve the clinic letter - The seven day letter target runs from the appointment, not from when drafting starts.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_1">
      <bpmn:text>Check the request is complete and authorised - A request without a named authorising clinician is turned away before anything is booked.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_2">
      <bpmn:text>What did the provider report? - Money never leaves the patient's account twice. A repeated attempt gets a new reference, and a duplicate report stops the booking.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_3">
      <bpmn:text>Release the provisional appointment series - Compensation. If external capacity never arrives, the provisional series is released instead of being left held.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_FIN_1">
      <bpmn:text>Decide whether a refund is due - Finance decides funding and refunds. Clinical staff may explain a treatment decision but cannot approve money.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PCW_1">
      <bpmn:text>How far overdue is the letter? - Seven days, one month and three months are the three escalation points for an outstanding clinic letter.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="medical-secretaries" name="Medical Secretaries" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="medical-secretaries_lanes">
      <bpmn:lane id="medical-secretaries_L1" name="Clinic correspondence">
        <bpmn:flowNodeRef>SEC_Start_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Task_NotifyReferrer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_OutcomeToReferrer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_OutcomeRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Start_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Task_ProcessLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_GW_LetterCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_ClinicalError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_LetterReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_LetterFiled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_Secretaries_Dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="medical-secretaries_L0" name="Referral intake">
        <bpmn:flowNodeRef>SEC_Start_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Task_CheckPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Auto_ValidateDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_GW_PackComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_ReviewRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_ReviewRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_InfoRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_EGW_InfoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Catch_InfoReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Catch_InfoTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_InfoNotReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_PackIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Bnd_PackIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Bnd_DocumentsUnreadable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SEC_Start_Referral" name="Referral received from GP or other hospital">
      <bpmn:documentation>Triggered by the referring organisation. Medical Secretaries own intake only; they must not judge clinical suitability.</bpmn:documentation>
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_001" messageRef="Message_referral_received" />
    </bpmn:startEvent>
    <bpmn:userTask id="SEC_Task_CheckPack" name="Check referral pack against the document checklist">
      <bpmn:documentation>Captures what was received and what is missing. The task never records a view on whether the referral is clinically appropriate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="check-referral-pack" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SEC_Auto_ValidateDocuments" name="Validate supporting documents and flag missing items">
      <bpmn:documentation>Reads the document list, matches it against the speciality checklist and returns referralPackComplete plus the missingDocuments collection.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.check-supporting-documents" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SEC_GW_PackComplete" name="Is the referral pack complete?" default="Flow_005">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="SEC_Throw_ReviewRequested" name="Referral to Consultant">
      <bpmn:documentation>Only an authorised Consultant may accept or reject a referral, so the pack is handed over without any administrative recommendation attached.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.review-requested" />
          <zeebe:header key="businessEvent" value="REFERRAL_READY_FOR_REVIEW" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_002" messageRef="Message_referral_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_ReviewRequested" name="Referral awaiting clinical decision">
      <bpmn:incoming>Flow_006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="SEC_Throw_InfoRequested" name="Request the missing information">
      <bpmn:documentation>Reached from the completeness gateway and from the unreadable-document error boundary, so a corrupted upload follows the same route as a missing document.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.info-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-info&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_003" messageRef="Message_referral_info_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="SEC_EGW_InfoRequest" name="Waiting for the missing information">
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoReceived" name="Information received">
      <bpmn:documentation>The referral stays open for 14 days. If nothing arrives the referral is closed rather than left in limbo.</bpmn:documentation>
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_004" messageRef="Message_referral_info_received" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoTimeout" name="No response after 14 days">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_001">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="SEC_End_InfoNotReceived" name="Referral closed - information not received">
      <bpmn:incoming>Flow_011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SEC_End_PackIncomplete" name="Referral held - checklist not satisfied">
      <bpmn:documentation>Raised when the worker cannot parse the pack at all, for example a corrupt PDF. The case sits with the secretaries instead of reaching a clinician.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:startEvent id="SEC_Start_Outcome" name="Referral outcome returned by the Consultant">
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_005" messageRef="Message_referral_outcome_returned" />
    </bpmn:startEvent>
    <bpmn:userTask id="SEC_Task_NotifyReferrer" name="Record the decision and notify the referring organisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="notify-referrer-outcome" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="SEC_Throw_OutcomeToReferrer" name="Outcome to the referrer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-sent" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_006" messageRef="Message_referral_outcome_sent" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_OutcomeRecorded" name="Outcome recorded and referrer informed">
      <bpmn:incoming>Flow_016</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SEC_Start_LetterApproved" name="Clinic letter approved by the Consultant">
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_007" messageRef="Message_clinic_letter_approved" />
    </bpmn:startEvent>
    <bpmn:userTask id="SEC_Task_ProcessLetter" name="Check and process the approved clinic letter">
      <bpmn:documentation>Administrative checks only. Formatting and administrative errors may be corrected; the clinical meaning must not be altered.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="process-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SEC_GW_LetterCheck" name="Does the letter need a clinical correction?" default="Flow_021">
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="SEC_Throw_ClinicalError" name="Return the letter to the Consultant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.clinical-error-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_008" messageRef="Message_letter_clinical_error_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_LetterReturned" name="Returned for amendment">
      <bpmn:incoming>Flow_020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SEC_End_LetterFiled" name="Letter filed with distribution evidence">
      <bpmn:incoming>Flow_022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SUB_Secretaries_Dispatch" name="Dispatch the clinic letter">
      <bpmn:documentation>Contained so the main line stays readable. The steps inside are ordinary tasks and use the same forms as before.</bpmn:documentation>
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
      <bpmn:startEvent id="SUB_Secretaries_Dispatch_Start">
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_S_Prepare</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SUB_Secretaries_Dispatch_Prepare" name="Prepare the letter for distribution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="correspondence.prepare-dispatch" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_S_Prepare</bpmn:incoming>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Chase_Prepare</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Prepare_Send</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SUB_Secretaries_Dispatch_Send" name="Send the letter through the correspondence service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Prepare_Send</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Send_E</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SUB_Secretaries_Dispatch_Chase" name="Resolve the distribution problem and pick another channel">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
          <zeebe:formDefinition formId="resolve-dispatch-problem" bindingType="deployment" />
        </bpmn:extensionElements>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Chase_Prepare</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SUB_Secretaries_Dispatch_End">
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Send_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_S_Prepare" sourceRef="SUB_Secretaries_Dispatch_Start" targetRef="SUB_Secretaries_Dispatch_Prepare" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Prepare_Send" sourceRef="SUB_Secretaries_Dispatch_Prepare" targetRef="SUB_Secretaries_Dispatch_Send" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Send_E" sourceRef="SUB_Secretaries_Dispatch_Send" targetRef="SUB_Secretaries_Dispatch_End" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Chase_Prepare" sourceRef="SUB_Secretaries_Dispatch_Chase" targetRef="SUB_Secretaries_Dispatch_Prepare" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SEC_Bnd_PackIncomplete" name="Incomplete" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_002" errorRef="Error_REFERRAL_PACK_INCOMPLETE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="SEC_Bnd_DocumentsUnreadable" name="Unreadable" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_001" errorRef="Error_REFERRAL_PACK_UNREADABLE" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="SEC_Start_Referral" targetRef="SEC_Task_CheckPack" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="SEC_Catch_InfoReceived" targetRef="SEC_Task_CheckPack" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="SEC_Task_CheckPack" targetRef="SEC_Auto_ValidateDocuments" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="SEC_Auto_ValidateDocuments" targetRef="SEC_GW_PackComplete" />
    <bpmn:sequenceFlow id="Flow_004" name="All expected documents present" sourceRef="SEC_GW_PackComplete" targetRef="SEC_Throw_ReviewRequested">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralPackComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_005" name="Something is missing" sourceRef="SEC_GW_PackComplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_006" sourceRef="SEC_Throw_ReviewRequested" targetRef="SEC_End_ReviewRequested" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="SEC_Bnd_DocumentsUnreadable" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="SEC_Bnd_PackIncomplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="SEC_Throw_InfoRequested" targetRef="SEC_EGW_InfoRequest" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoReceived" />
    <bpmn:sequenceFlow id="Flow_009" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoTimeout" />
    <bpmn:sequenceFlow id="Flow_011" sourceRef="SEC_Catch_InfoTimeout" targetRef="SEC_End_InfoNotReceived" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="SEC_Start_Outcome" targetRef="SEC_Task_NotifyReferrer" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="SEC_Task_NotifyReferrer" targetRef="SEC_Throw_OutcomeToReferrer" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="SEC_Throw_OutcomeToReferrer" targetRef="SEC_End_OutcomeRecorded" />
    <bpmn:sequenceFlow id="Flow_017" sourceRef="SEC_Start_LetterApproved" targetRef="SEC_Task_ProcessLetter" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="SEC_Task_ProcessLetter" targetRef="SEC_GW_LetterCheck" />
    <bpmn:sequenceFlow id="Flow_019" name="Suspected clinical error" sourceRef="SEC_GW_LetterCheck" targetRef="SEC_Throw_ClinicalError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalErrorSuspected = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_021" name="Administrative checks passed" sourceRef="SEC_GW_LetterCheck" targetRef="SUB_Secretaries_Dispatch" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="SEC_Throw_ClinicalError" targetRef="SEC_End_LetterReturned" />
    <bpmn:sequenceFlow id="Flow_022" sourceRef="SUB_Secretaries_Dispatch" targetRef="SEC_End_LetterFiled" />
  </bpmn:process>
  <bpmn:process id="consultants" name="Consultants" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="consultants_lanes">
      <bpmn:lane id="consultants_L2" name="Requests from other teams">
        <bpmn:flowNodeRef>CON_Start_UrgencyAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_PathwayReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ClinicalReviewOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_FollowUpRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_ClinicalReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="consultants_L1" name="Correspondence">
        <bpmn:flowNodeRef>CON_Start_LetterDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_DraftLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_RecordReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_ReminderRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_LetterCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_CorrectLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterReapproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterReapproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Bnd_LetterReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Bnd_LetterOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="consultants_L0" name="Clinical decisions and authorisations">
        <bpmn:flowNodeRef>CON_Start_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_ReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuditDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_MoreInfoNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_OutcomeReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_AppointmentAttended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_RecordConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_ConsentGiven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuthoriseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_BookingRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_BookingRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_TreatmentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_TreatmentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_CycleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_ReviewCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuditCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_CycleOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_PlanChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_PlanChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_AuthoriseModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_ModificationUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationRoutine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CON_Start_Review" name="Referral waiting for clinical review">
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_009" messageRef="Message_referral_review_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_ReviewReferral" name="Review the referral and record the clinical decision">
      <bpmn:documentation>Accept, reject, redirect or ask for more information. The reason and the deciding clinician are recorded for audit and cannot be edited afterwards.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="review-referral" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_Auto_AuditDecision" name="Write the clinical decision to the audit trail">
      <bpmn:documentation>Immutable record of who decided what, when and why.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-clinical-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_024</bpmn:incoming>
      <bpmn:outgoing>Flow_025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_GW_Decision" name="What is the clinical decision?" default="Flow_029">
      <bpmn:incoming>Flow_025</bpmn:incoming>
      <bpmn:outgoing>Flow_026</bpmn:outgoing>
      <bpmn:outgoing>Flow_027</bpmn:outgoing>
      <bpmn:outgoing>Flow_028</bpmn:outgoing>
      <bpmn:outgoing>Flow_029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CON_Throw_Accepted" name="Referral accepted">
      <bpmn:documentation>A new patient appointment may only be arranged after an authorised Consultant has accepted the referral.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.accepted" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-accepted&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_026</bpmn:incoming>
      <bpmn:outgoing>Flow_030</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_010" messageRef="Message_referral_accepted" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_Accepted" name="Referral accepted">
      <bpmn:incoming>Flow_030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_Rejected" name="Referral rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
          <zeebe:input source="=&#34;REJECTED&#34;" target="referralOutcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_027</bpmn:incoming>
      <bpmn:outgoing>Flow_031</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_011" messageRef="Message_referral_outcome_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_Redirected" name="Referral redirected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
          <zeebe:input source="=&#34;REDIRECTED&#34;" target="referralOutcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_028</bpmn:incoming>
      <bpmn:outgoing>Flow_032</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_012" messageRef="Message_referral_outcome_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_MoreInfoNeeded" name="Further clinical information requested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
          <zeebe:input source="=&#34;CLINICAL_INFO_REQUESTED&#34;" target="referralOutcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_029</bpmn:incoming>
      <bpmn:outgoing>Flow_033</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_013" messageRef="Message_referral_outcome_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_OutcomeReturned" name="Outcome returned to Medical Secretaries">
      <bpmn:incoming>Flow_031</bpmn:incoming>
      <bpmn:incoming>Flow_032</bpmn:incoming>
      <bpmn:incoming>Flow_033</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_AppointmentAttended" name="Patient attended the new patient appointment">
      <bpmn:outgoing>Flow_034</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_014" messageRef="Message_appointment_attended" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_RecordConsent" name="Record consent and complete the treatment booking request">
      <bpmn:documentation>The Consultant explains the options, records whether the patient agrees to proceed and, if so, completes the treatment booking request in full.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="record-consent-and-treatment-request" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_034</bpmn:incoming>
      <bpmn:outgoing>Flow_035</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_GW_ConsentGiven" name="Has the patient agreed to proceed?" default="Flow_037">
      <bpmn:incoming>Flow_035</bpmn:incoming>
      <bpmn:outgoing>Flow_036</bpmn:outgoing>
      <bpmn:outgoing>Flow_037</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_Auto_AuthoriseRequest" name="Authorise the treatment booking request">
      <bpmn:documentation>Stamps the request with the authorising clinician. Administrative teams cannot process a request that has not been through this step.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.authorise-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_036</bpmn:incoming>
      <bpmn:outgoing>Flow_038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="CON_Throw_BookingRequested" name="Authorised treatment booking request issued">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-booking&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_038</bpmn:incoming>
      <bpmn:outgoing>Flow_039</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_015" messageRef="Message_treatment_booking_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_BookingRequested" name="Booking request issued">
      <bpmn:incoming>Flow_039</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_TreatmentDeclined" name="Patient declined treatment at this time">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.declined" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-declined&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_037</bpmn:incoming>
      <bpmn:outgoing>Flow_040</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_016" messageRef="Message_treatment_declined" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_TreatmentDeclined" name="Declined - pathway reviewed">
      <bpmn:incoming>Flow_040</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_CycleReview" name="Chemotherapy cycle review requested">
      <bpmn:outgoing>Flow_041</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_017" messageRef="Message_chemotherapy_review_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_ReviewCycle" name="Review blood results and decide on the next cycle">
      <bpmn:documentation>Clinical decision only. The bookings, finance and administrative teams cannot make or change this call.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="review-chemotherapy-cycle" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_041</bpmn:incoming>
      <bpmn:outgoing>Flow_042</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_Auto_AuditCycle" name="Record the cycle review decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-clinical-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_042</bpmn:incoming>
      <bpmn:outgoing>Flow_043</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_GW_CycleOutcome" name="Is the patient fit to continue?" default="Flow_046">
      <bpmn:incoming>Flow_043</bpmn:incoming>
      <bpmn:outgoing>Flow_044</bpmn:outgoing>
      <bpmn:outgoing>Flow_045</bpmn:outgoing>
      <bpmn:outgoing>Flow_046</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CON_Throw_CycleApproved" name="Continue with the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="chemotherapy.cycle-approved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-chemotherapy-cycle&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_044</bpmn:incoming>
      <bpmn:outgoing>Flow_047</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_018" messageRef="Message_chemotherapy_cycle_approved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_CycleApproved" name="Next cycle authorised">
      <bpmn:incoming>Flow_047</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_CycleDelayed" name="Delay the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="chemotherapy.cycle-delayed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-chemotherapy-cycle&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_045</bpmn:incoming>
      <bpmn:outgoing>Flow_048</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_019" messageRef="Message_chemotherapy_cycle_delayed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_CycleDelayed" name="Cycle delayed for clinical reasons">
      <bpmn:incoming>Flow_048</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_PlanChanged" name="Change the treatment plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.modification-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-modification&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_046</bpmn:incoming>
      <bpmn:outgoing>Flow_049</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_020" messageRef="Message_treatment_modification_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_PlanChanged" name="Treatment change raised for authorisation">
      <bpmn:incoming>Flow_049</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_Modification" name="Treatment change raised">
      <bpmn:outgoing>Flow_050</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_021" messageRef="Message_treatment_modification_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_AuthoriseModification" name="Authorise the treatment modification">
      <bpmn:documentation>A change requested only by email or telephone is not processed. It has to be formally authorised here so it stays traceable.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="authorise-treatment-modification" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_050</bpmn:incoming>
      <bpmn:incoming>Flow_074</bpmn:incoming>
      <bpmn:outgoing>Flow_051</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_GW_ModificationUrgent" name="Is this an urgent patient-safety change?" default="Flow_053">
      <bpmn:incoming>Flow_051</bpmn:incoming>
      <bpmn:outgoing>Flow_052</bpmn:outgoing>
      <bpmn:outgoing>Flow_053</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CON_Throw_ModificationUrgent" name="Urgent change authorised">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.modification-authorised" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-modification&#34;" target="correlationKey" />
          <zeebe:input source="=true" target="modificationUrgent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_052</bpmn:incoming>
      <bpmn:outgoing>Flow_055</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_022" messageRef="Message_treatment_modification_authorised" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_ModificationRoutine" name="Treatment change authorised">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.modification-authorised" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-modification&#34;" target="correlationKey" />
          <zeebe:input source="=false" target="modificationUrgent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_053</bpmn:incoming>
      <bpmn:outgoing>Flow_054</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_023" messageRef="Message_treatment_modification_authorised" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_ModificationFinance" name="Financial impact to Finance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="finance.impact-review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-finance-impact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_055</bpmn:incoming>
      <bpmn:outgoing>Flow_056</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_024" messageRef="Message_finance_impact_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_Modification" name="Change applied">
      <bpmn:incoming>Flow_054</bpmn:incoming>
      <bpmn:incoming>Flow_056</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_LetterDraft" name="Clinic letter to be written">
      <bpmn:outgoing>Flow_059</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_025" messageRef="Message_clinic_letter_draft_required" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_DraftLetter" name="Draft and approve the clinic letter">
      <bpmn:documentation>The Consultant owns the clinical content and signs it off. The seven day target starts from the appointment date, not from when drafting begins.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="draft-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_059</bpmn:incoming>
      <bpmn:incoming>Flow_062</bpmn:incoming>
      <bpmn:outgoing>Flow_060</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="CON_Throw_LetterOverdue" name="Flag the letter as delayed">
      <bpmn:documentation>Reaching the pathway monitoring queue, not a blocking reminder, so drafting continues.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.overdue-flagged" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_063</bpmn:incoming>
      <bpmn:outgoing>Flow_064</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_026" messageRef="Message_letter_overdue_flagged" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_LetterOverdue" name="Letter flagged for pathway monitoring">
      <bpmn:incoming>Flow_064</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CON_GW_LetterApproved" name="Has the Consultant approved the letter?" default="Flow_062">
      <bpmn:incoming>Flow_060</bpmn:incoming>
      <bpmn:outgoing>Flow_061</bpmn:outgoing>
      <bpmn:outgoing>Flow_062</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CON_Throw_LetterApproved" name="Clinic letter approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinic.letter-approved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_061</bpmn:incoming>
      <bpmn:outgoing>Flow_065</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_027" messageRef="Message_clinic_letter_approved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_LetterApproved" name="Letter released to Medical Secretaries">
      <bpmn:incoming>Flow_065</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CON_Auto_RecordReminder" name="Record the reminder against the letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="letter.record-reminder" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_057</bpmn:incoming>
      <bpmn:outgoing>Flow_058</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CON_End_ReminderRecorded" name="Reminder recorded">
      <bpmn:incoming>Flow_058</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_LetterCorrection" name="Letter returned for clinical correction">
      <bpmn:outgoing>Flow_066</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_028" messageRef="Message_letter_clinical_error_returned" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_CorrectLetter" name="Correct and re-approve the clinic letter">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="correct-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_066</bpmn:incoming>
      <bpmn:outgoing>Flow_067</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="CON_Throw_LetterReapproved" name="Corrected letter approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinic.letter-approved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_067</bpmn:incoming>
      <bpmn:outgoing>Flow_068</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_029" messageRef="Message_clinic_letter_approved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_LetterReapproved" name="Corrected letter released">
      <bpmn:incoming>Flow_068</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_UrgencyAuthorisation" name="Urgent treatment authorisation requested">
      <bpmn:outgoing>Flow_069</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_030" messageRef="Message_treatment_urgency_authorisation_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_AuthoriseUrgentTreatment" name="Authorise urgent treatment without confirmed payment">
      <bpmn:documentation>Only a clinician may take this call. The clinical reason for proceeding is recorded and the case is passed to Finance to resolve afterwards.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="authorise-urgent-treatment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_069</bpmn:incoming>
      <bpmn:outgoing>Flow_070</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="CON_Throw_UrgencyDecision" name="Urgency decision returned">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.urgency-authorisation-result" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-urgency-authorisation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_070</bpmn:incoming>
      <bpmn:outgoing>Flow_071</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_031" messageRef="Message_treatment_urgency_authorisation_result" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_UrgencyDecision" name="Urgent treatment decision recorded">
      <bpmn:incoming>Flow_071</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CON_Start_ClinicalReview" name="Clinical review requested">
      <bpmn:outgoing>Flow_072</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_032" messageRef="Message_clinical_review_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="CON_Start_PathwayReview" name="Pathway review requested by another team">
      <bpmn:outgoing>Flow_073</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_033" messageRef="Message_pathway_review_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="CON_Start_ChangeRequest" name="Treatment change forwarded">
      <bpmn:outgoing>Flow_074</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_034" messageRef="Message_treatment_change_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="CON_Task_ClinicalReview" name="Provide the clinical review outcome">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="clinical-review-advice" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_072</bpmn:incoming>
      <bpmn:incoming>Flow_073</bpmn:incoming>
      <bpmn:outgoing>Flow_075</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="CON_Throw_ClinicalReviewOutcome" name="Clinical review outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinical.review-outcome" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinical-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_075</bpmn:incoming>
      <bpmn:outgoing>Flow_076</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_035" messageRef="Message_clinical_review_outcome" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CON_Throw_FollowUpRequested" name="Ask for a follow-up appointment">
      <bpmn:documentation>Raised when the reviewing clinician wants to see the patient again, with the period within which that should happen.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="follow-up.appointment-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-follow-up&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_076</bpmn:incoming>
      <bpmn:outgoing>Flow_077</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_036" messageRef="Message_follow_up_appointment_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CON_End_ClinicalReview" name="Clinical review closed">
      <bpmn:incoming>Flow_077</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="CON_Bnd_LetterReminder" name="Reminder" cancelActivity="false" attachedToRef="CON_Task_DraftLetter">
      <bpmn:documentation>The reminder lands on the drafting task without interrupting it, and repeated reminders stop once the letter has been approved.</bpmn:documentation>
      <bpmn:outgoing>Flow_057</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_037" messageRef="Message_letter_reminder" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="CON_Bnd_LetterOverdue" name="Day 7" cancelActivity="false" attachedToRef="CON_Task_DraftLetter">
      <bpmn:outgoing>Flow_063</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_002">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_023" sourceRef="CON_Start_Review" targetRef="CON_Task_ReviewReferral" />
    <bpmn:sequenceFlow id="Flow_024" sourceRef="CON_Task_ReviewReferral" targetRef="CON_Auto_AuditDecision" />
    <bpmn:sequenceFlow id="Flow_025" sourceRef="CON_Auto_AuditDecision" targetRef="CON_GW_Decision" />
    <bpmn:sequenceFlow id="Flow_026" name="Accept" sourceRef="CON_GW_Decision" targetRef="CON_Throw_Accepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalDecision = "ACCEPT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_027" name="Reject" sourceRef="CON_GW_Decision" targetRef="CON_Throw_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalDecision = "REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_028" name="Redirect" sourceRef="CON_GW_Decision" targetRef="CON_Throw_Redirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalDecision = "REDIRECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_029" name="Needs more clinical detail" sourceRef="CON_GW_Decision" targetRef="CON_Throw_MoreInfoNeeded" />
    <bpmn:sequenceFlow id="Flow_030" sourceRef="CON_Throw_Accepted" targetRef="CON_End_Accepted" />
    <bpmn:sequenceFlow id="Flow_031" sourceRef="CON_Throw_Rejected" targetRef="CON_End_OutcomeReturned" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="CON_Throw_Redirected" targetRef="CON_End_OutcomeReturned" />
    <bpmn:sequenceFlow id="Flow_033" sourceRef="CON_Throw_MoreInfoNeeded" targetRef="CON_End_OutcomeReturned" />
    <bpmn:sequenceFlow id="Flow_034" sourceRef="CON_Start_AppointmentAttended" targetRef="CON_Task_RecordConsent" />
    <bpmn:sequenceFlow id="Flow_035" sourceRef="CON_Task_RecordConsent" targetRef="CON_GW_ConsentGiven" />
    <bpmn:sequenceFlow id="Flow_036" name="Consent recorded" sourceRef="CON_GW_ConsentGiven" targetRef="CON_Auto_AuthoriseRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=consentGiven = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_037" name="Not proceeding" sourceRef="CON_GW_ConsentGiven" targetRef="CON_Throw_TreatmentDeclined" />
    <bpmn:sequenceFlow id="Flow_038" sourceRef="CON_Auto_AuthoriseRequest" targetRef="CON_Throw_BookingRequested" />
    <bpmn:sequenceFlow id="Flow_039" sourceRef="CON_Throw_BookingRequested" targetRef="CON_End_BookingRequested" />
    <bpmn:sequenceFlow id="Flow_040" sourceRef="CON_Throw_TreatmentDeclined" targetRef="CON_End_TreatmentDeclined" />
    <bpmn:sequenceFlow id="Flow_041" sourceRef="CON_Start_CycleReview" targetRef="CON_Task_ReviewCycle" />
    <bpmn:sequenceFlow id="Flow_042" sourceRef="CON_Task_ReviewCycle" targetRef="CON_Auto_AuditCycle" />
    <bpmn:sequenceFlow id="Flow_043" sourceRef="CON_Auto_AuditCycle" targetRef="CON_GW_CycleOutcome" />
    <bpmn:sequenceFlow id="Flow_044" name="Fit to continue" sourceRef="CON_GW_CycleOutcome" targetRef="CON_Throw_CycleApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cycleReviewOutcome = "FIT_TO_CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_045" name="Delay" sourceRef="CON_GW_CycleOutcome" targetRef="CON_Throw_CycleDelayed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cycleReviewOutcome = "DELAY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_046" name="Change the plan" sourceRef="CON_GW_CycleOutcome" targetRef="CON_Throw_PlanChanged" />
    <bpmn:sequenceFlow id="Flow_047" sourceRef="CON_Throw_CycleApproved" targetRef="CON_End_CycleApproved" />
    <bpmn:sequenceFlow id="Flow_048" sourceRef="CON_Throw_CycleDelayed" targetRef="CON_End_CycleDelayed" />
    <bpmn:sequenceFlow id="Flow_049" sourceRef="CON_Throw_PlanChanged" targetRef="CON_End_PlanChanged" />
    <bpmn:sequenceFlow id="Flow_050" sourceRef="CON_Start_Modification" targetRef="CON_Task_AuthoriseModification" />
    <bpmn:sequenceFlow id="Flow_074" sourceRef="CON_Start_ChangeRequest" targetRef="CON_Task_AuthoriseModification" />
    <bpmn:sequenceFlow id="Flow_051" sourceRef="CON_Task_AuthoriseModification" targetRef="CON_GW_ModificationUrgent" />
    <bpmn:sequenceFlow id="Flow_052" name="Patient safety - act now" sourceRef="CON_GW_ModificationUrgent" targetRef="CON_Throw_ModificationUrgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=modificationUrgent = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_053" name="Normal change" sourceRef="CON_GW_ModificationUrgent" targetRef="CON_Throw_ModificationRoutine" />
    <bpmn:sequenceFlow id="Flow_055" sourceRef="CON_Throw_ModificationUrgent" targetRef="CON_Throw_ModificationFinance" />
    <bpmn:sequenceFlow id="Flow_054" sourceRef="CON_Throw_ModificationRoutine" targetRef="CON_End_Modification" />
    <bpmn:sequenceFlow id="Flow_056" sourceRef="CON_Throw_ModificationFinance" targetRef="CON_End_Modification" />
    <bpmn:sequenceFlow id="Flow_059" sourceRef="CON_Start_LetterDraft" targetRef="CON_Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_062" name="Still in progress" sourceRef="CON_GW_LetterApproved" targetRef="CON_Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_060" sourceRef="CON_Task_DraftLetter" targetRef="CON_GW_LetterApproved" />
    <bpmn:sequenceFlow id="Flow_063" sourceRef="CON_Bnd_LetterOverdue" targetRef="CON_Throw_LetterOverdue" />
    <bpmn:sequenceFlow id="Flow_064" sourceRef="CON_Throw_LetterOverdue" targetRef="CON_End_LetterOverdue" />
    <bpmn:sequenceFlow id="Flow_061" name="Approved" sourceRef="CON_GW_LetterApproved" targetRef="CON_Throw_LetterApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=letterApproved = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_065" sourceRef="CON_Throw_LetterApproved" targetRef="CON_End_LetterApproved" />
    <bpmn:sequenceFlow id="Flow_057" sourceRef="CON_Bnd_LetterReminder" targetRef="CON_Auto_RecordReminder" />
    <bpmn:sequenceFlow id="Flow_058" sourceRef="CON_Auto_RecordReminder" targetRef="CON_End_ReminderRecorded" />
    <bpmn:sequenceFlow id="Flow_066" sourceRef="CON_Start_LetterCorrection" targetRef="CON_Task_CorrectLetter" />
    <bpmn:sequenceFlow id="Flow_067" sourceRef="CON_Task_CorrectLetter" targetRef="CON_Throw_LetterReapproved" />
    <bpmn:sequenceFlow id="Flow_068" sourceRef="CON_Throw_LetterReapproved" targetRef="CON_End_LetterReapproved" />
    <bpmn:sequenceFlow id="Flow_069" sourceRef="CON_Start_UrgencyAuthorisation" targetRef="CON_Task_AuthoriseUrgentTreatment" />
    <bpmn:sequenceFlow id="Flow_070" sourceRef="CON_Task_AuthoriseUrgentTreatment" targetRef="CON_Throw_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_071" sourceRef="CON_Throw_UrgencyDecision" targetRef="CON_End_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_072" sourceRef="CON_Start_ClinicalReview" targetRef="CON_Task_ClinicalReview" />
    <bpmn:sequenceFlow id="Flow_073" sourceRef="CON_Start_PathwayReview" targetRef="CON_Task_ClinicalReview" />
    <bpmn:sequenceFlow id="Flow_075" sourceRef="CON_Task_ClinicalReview" targetRef="CON_Throw_ClinicalReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_076" sourceRef="CON_Throw_ClinicalReviewOutcome" targetRef="CON_Throw_FollowUpRequested" />
    <bpmn:sequenceFlow id="Flow_077" sourceRef="CON_Throw_FollowUpRequested" targetRef="CON_End_ClinicalReview" />
  </bpmn:process>
  <bpmn:process id="treatment-bookings" name="Treatment and Chemotherapy Bookings Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="treatment-bookings_lanes">
      <bpmn:lane id="treatment-bookings_L2" name="Treatment changes">
        <bpmn:flowNodeRef>TRT_Start_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_ModificationAuthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ApplyModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_ModificationFinancial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_ModificationFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_ModificationApplied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_ModificationToClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_ModificationForwarded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treatment-bookings_L1" name="Chemotherapy cycles">
        <bpmn:flowNodeRef>TRT_Start_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ScheduleCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_FindCycleSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_CycleSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_NextReviewDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_MoreCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CycleScheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CourseComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CycleCapacityIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CyclePending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_RecordDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_DelayNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_DelayRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Comp_ReleaseCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CompCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CompCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CycleNoSlots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treatment-bookings_L0" name="Treatment booking and funding">
        <bpmn:flowNodeRef>TRT_Start_BookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ValidateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_RequestRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_RequestRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_EGW_Funding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_FundingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_FundingTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_FundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_PreparePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_IGW_ReadyToBook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_Deduplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewDeclinedPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_DeclinedAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_NextAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_PaymentUnresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_PaymentUnresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_Investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_UrgencyAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewFundingTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_FundingTimeoutAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingTimeoutEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_FundingPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_CreateSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_CheckExternalResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_ExternalAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ConfirmAppointments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_TreatmentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_PGW_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_LetterDraftRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_SendTreatmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_PGW_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_Scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_BookingPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_RetryTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Comp_ReleaseSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CompSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_RecordRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_CapacityCap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_BookingPending2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_RetryTimer2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CompSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ExternalUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ConfirmationLost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ProviderUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_NotAuthorised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="TRT_Start_BookingRequest" name="Booking request received">
      <bpmn:outgoing>Flow_078</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_038" messageRef="Message_treatment_booking_requested" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="TRT_Auto_ValidateRequest" name="Check the request is complete and authorised">
      <bpmn:documentation>Rejects anything without an authorising clinician. A request that only arrived by email or telephone is not in the system at all, so it cannot reach this step.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.validate-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_078</bpmn:incoming>
      <bpmn:outgoing>Flow_079</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_RequestRejected" name="Return the request to the clinical team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.request-invalid" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-request-invalid&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_080</bpmn:incoming>
      <bpmn:outgoing>Flow_081</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_039" messageRef="Message_treatment_request_invalid" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_RequestRejected" name="Request returned for authorisation">
      <bpmn:incoming>Flow_081</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingCheck" name="Ask Finance how this treatment is funded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.check-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_079</bpmn:incoming>
      <bpmn:incoming>Flow_108</bpmn:incoming>
      <bpmn:outgoing>Flow_082</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_040" messageRef="Message_funding_check_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="TRT_EGW_Funding" name="Waiting on the funding decision">
      <bpmn:incoming>Flow_082</bpmn:incoming>
      <bpmn:outgoing>Flow_083</bpmn:outgoing>
      <bpmn:outgoing>Flow_084</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TRT_Catch_FundingDecision" name="Funding decision received">
      <bpmn:incoming>Flow_083</bpmn:incoming>
      <bpmn:outgoing>Flow_085</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_041" messageRef="Message_funding_decision_received" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_FundingTimeout" name="Funding decision overdue">
      <bpmn:incoming>Flow_084</bpmn:incoming>
      <bpmn:outgoing>Flow_106</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_003">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="TRT_GW_FundingRoute" name="Who is paying for this treatment?" default="Flow_087">
      <bpmn:incoming>Flow_085</bpmn:incoming>
      <bpmn:outgoing>Flow_086</bpmn:outgoing>
      <bpmn:outgoing>Flow_087</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_PreparePayment" name="Prepare the secure payment request">
      <bpmn:documentation>Creates the payment reference and the secure link. Card details are never held in the hospital system.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.prepare-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=1" target="paymentAttempt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_086</bpmn:incoming>
      <bpmn:incoming>Flow_099</bpmn:incoming>
      <bpmn:outgoing>Flow_088</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_ProcessPayment" name="Take the payment through the payment provider">
      <bpmn:documentation>Outbound call to the external payment provider. Only the status, reference, date and amount come back - never card data.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-transaction" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_088</bpmn:incoming>
      <bpmn:outgoing>Flow_089</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_PaymentOutcome" name="What did the provider report?" default="Flow_094">
      <bpmn:incoming>Flow_089</bpmn:incoming>
      <bpmn:outgoing>Flow_092</bpmn:outgoing>
      <bpmn:outgoing>Flow_093</bpmn:outgoing>
      <bpmn:outgoing>Flow_094</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="TRT_IGW_ReadyToBook" name="Booking prerequisites satisfied">
      <bpmn:incoming>Flow_087</bpmn:incoming>
      <bpmn:incoming>Flow_092</bpmn:incoming>
      <bpmn:incoming>Flow_095</bpmn:incoming>
      <bpmn:incoming>Flow_104</bpmn:incoming>
      <bpmn:outgoing>Flow_110</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_Deduplicate" name="Check the charge has not already been taken">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.check-duplicate-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_093</bpmn:incoming>
      <bpmn:outgoing>Flow_095</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TRT_Task_ReviewDeclinedPayment" name="Decide how to handle the failed payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-declined-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_094</bpmn:incoming>
      <bpmn:outgoing>Flow_096</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TRT_GW_DeclinedAction" name="Try again or hand it over?" default="Flow_098">
      <bpmn:incoming>Flow_096</bpmn:incoming>
      <bpmn:outgoing>Flow_097</bpmn:outgoing>
      <bpmn:outgoing>Flow_098</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_NextAttempt" name="Record the next payment attempt">
      <bpmn:documentation>A new attempt gets a new payment reference, so the provider is never asked to take the same charge twice.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.prepare-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=paymentAttempt + 1" target="paymentAttempt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_097</bpmn:incoming>
      <bpmn:outgoing>Flow_099</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_PaymentUnresolved" name="Leave the payment with the Finance Team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.unresolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-unresolved&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_090</bpmn:incoming>
      <bpmn:incoming>Flow_098</bpmn:incoming>
      <bpmn:outgoing>Flow_100</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_042" messageRef="Message_payment_unresolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_PaymentUnresolved" name="Payment unresolved - booking not confirmed">
      <bpmn:incoming>Flow_100</bpmn:incoming>
      <bpmn:incoming>Flow_105</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_Investigation" name="Mark the transaction for investigation">
      <bpmn:documentation>Money may have left the patient's account without a confirmation reaching us.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.investigation-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-investigation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_091</bpmn:incoming>
      <bpmn:outgoing>Flow_101</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_043" messageRef="Message_payment_investigation_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_UrgencyAuthorisation" name="Ask a clinician about proceeding anyway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.urgency-authorisation-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-urgency-authorisation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_101</bpmn:incoming>
      <bpmn:outgoing>Flow_102</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_044" messageRef="Message_treatment_urgency_authorisation_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_UrgencyDecision" name="Urgency decision returned">
      <bpmn:incoming>Flow_102</bpmn:incoming>
      <bpmn:outgoing>Flow_103</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_045" messageRef="Message_treatment_urgency_authorisation_result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="TRT_GW_UrgencyDecision" name="May treatment go ahead without confirmed payment?" default="Flow_105">
      <bpmn:incoming>Flow_103</bpmn:incoming>
      <bpmn:outgoing>Flow_104</bpmn:outgoing>
      <bpmn:outgoing>Flow_105</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TRT_Task_ReviewFundingTimeout" name="Chase the outstanding funding approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="chase-funding-approval" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_106</bpmn:incoming>
      <bpmn:outgoing>Flow_107</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TRT_GW_FundingTimeoutAction" name="Has the approval come through?" default="Flow_109">
      <bpmn:incoming>Flow_107</bpmn:incoming>
      <bpmn:outgoing>Flow_108</bpmn:outgoing>
      <bpmn:outgoing>Flow_109</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingTimeoutEscalation" name="Record the funding delay">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.delay-recorded" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding-delay&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_109</bpmn:incoming>
      <bpmn:outgoing>Flow_153</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_046" messageRef="Message_funding_delay_recorded" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_FundingPending" name="Booking held pending funding approval">
      <bpmn:incoming>Flow_154</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_CreateSeries" name="Create the provisional appointment series">
      <bpmn:documentation>One appointment per cycle, all keyed on the treatment booking reference so a retry cannot create a second series.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.create-appointment-series" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_110</bpmn:incoming>
      <bpmn:incoming>Flow_152</bpmn:incoming>
      <bpmn:outgoing>Flow_111</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_CheckExternalResources" name="Check external treatment and diagnostic capacity">
      <bpmn:documentation>Outbound call to the external treatment, laboratory and imaging services. If the booking cannot be held the case stays pending instead of being lost.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external-resources.check-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_111</bpmn:incoming>
      <bpmn:incoming>Flow_147</bpmn:incoming>
      <bpmn:outgoing>Flow_112</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_ExternalAvailable" name="Is everything available?" default="Flow_115">
      <bpmn:incoming>Flow_112</bpmn:incoming>
      <bpmn:outgoing>Flow_114</bpmn:outgoing>
      <bpmn:outgoing>Flow_115</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_ConfirmAppointments" name="Confirm the treatment appointments">
      <bpmn:documentation>Runs once per booking reference. Re-running after a retry updates the same appointments instead of adding new ones.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.confirm-appointments" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_114</bpmn:incoming>
      <bpmn:outgoing>Flow_116</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_TreatmentConfirmed" name="Treatment schedule confirmed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.confirmed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-confirmed&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_116</bpmn:incoming>
      <bpmn:outgoing>Flow_117</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_047" messageRef="Message_treatment_confirmed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="TRT_PGW_NotifySplit" name="Tell the patient and start the clinic letter">
      <bpmn:documentation>Once treatment is confirmed both of these have to happen, so they run in parallel rather than as a choice.</bpmn:documentation>
      <bpmn:incoming>Flow_117</bpmn:incoming>
      <bpmn:outgoing>Flow_118</bpmn:outgoing>
      <bpmn:outgoing>Flow_119</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_LetterDraftRequested" name="Clinic letter requested">
      <bpmn:documentation>Raised once treatment is confirmed so the seven day correspondence target starts from a recorded point in the pathway.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinic.letter-draft-required" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_118</bpmn:incoming>
      <bpmn:outgoing>Flow_120</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_048" messageRef="Message_clinic_letter_draft_required" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="TRT_Auto_SendTreatmentLetter" name="Send the treatment confirmation letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;patient&#34;]" target="letterRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_119</bpmn:incoming>
      <bpmn:outgoing>Flow_121</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="TRT_PGW_NotifyJoin" name="Both notifications issued">
      <bpmn:incoming>Flow_120</bpmn:incoming>
      <bpmn:incoming>Flow_121</bpmn:incoming>
      <bpmn:outgoing>Flow_122</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="TRT_End_Scheduled" name="Schedule confirmed">
      <bpmn:incoming>Flow_122</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_BookingPending" name="Booking pending">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_123</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_049" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_RetryTimer" name="Retry external capacity">
      <bpmn:incoming>Flow_123</bpmn:incoming>
      <bpmn:outgoing>Flow_145</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_004">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="TRT_Start_CycleApproved" name="Next chemotherapy cycle authorised">
      <bpmn:outgoing>Flow_124</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_050" messageRef="Message_chemotherapy_cycle_approved" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="TRT_Auto_ScheduleCycle" name="Schedule the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.schedule-next-cycle" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_124</bpmn:incoming>
      <bpmn:outgoing>Flow_125</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_FindCycleSlots" name="Look for a slot for the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_125</bpmn:incoming>
      <bpmn:outgoing>Flow_126</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CycleSlots" name="Was a cycle slot found?" default="Flow_128">
      <bpmn:incoming>Flow_126</bpmn:incoming>
      <bpmn:outgoing>Flow_127</bpmn:outgoing>
      <bpmn:outgoing>Flow_128</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_NextReviewDue" name="Next cycle booked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="chemotherapy.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-chemotherapy-cycle&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_127</bpmn:incoming>
      <bpmn:outgoing>Flow_130</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_051" messageRef="Message_chemotherapy_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="TRT_GW_MoreCycles" name="Are there further cycles in this course?" default="Flow_132">
      <bpmn:incoming>Flow_130</bpmn:incoming>
      <bpmn:outgoing>Flow_131</bpmn:outgoing>
      <bpmn:outgoing>Flow_132</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="TRT_End_CycleScheduled" name="Next cycle booked and review requested">
      <bpmn:incoming>Flow_131</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TRT_End_CourseComplete" name="Course of treatment complete">
      <bpmn:incoming>Flow_132</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CycleCapacityIssue" name="Flag the capacity problem">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_129</bpmn:incoming>
      <bpmn:incoming>Flow_150</bpmn:incoming>
      <bpmn:outgoing>Flow_133</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_052" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_CyclePending" name="Cycle booking held">
      <bpmn:incoming>Flow_133</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="TRT_Start_CycleDelayed" name="Cycle delayed on clinical grounds">
      <bpmn:outgoing>Flow_134</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_053" messageRef="Message_chemotherapy_cycle_delayed" />
    </bpmn:startEvent>
    <bpmn:userTask id="TRT_Task_RecordDelay" name="Record the delay and re-plan the cycle">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="record-cycle-delay" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_134</bpmn:incoming>
      <bpmn:outgoing>Flow_135</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_DelayNotified" name="Tell the pathway team and the patient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_135</bpmn:incoming>
      <bpmn:outgoing>Flow_136</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_054" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_DelayRecorded" name="Delay recorded">
      <bpmn:incoming>Flow_136</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="TRT_Start_Modification" name="Treatment plan change requested">
      <bpmn:outgoing>Flow_137</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_055" messageRef="Message_treatment_modification_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="TRT_Start_ModificationAuthorised" name="Treatment change authorised">
      <bpmn:outgoing>Flow_140</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_056" messageRef="Message_treatment_modification_authorised" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="TRT_Auto_ApplyModification" name="Apply the treatment change to the schedule">
      <bpmn:documentation>Updates the existing appointments rather than creating a new series.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.apply-modification" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_140</bpmn:incoming>
      <bpmn:outgoing>Flow_141</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_ModificationFinancial" name="Does the change affect money already handled?" default="Flow_143">
      <bpmn:incoming>Flow_141</bpmn:incoming>
      <bpmn:outgoing>Flow_142</bpmn:outgoing>
      <bpmn:outgoing>Flow_143</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_ModificationFinance" name="Refer the financial impact to Finance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="finance.impact-review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-finance-impact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_142</bpmn:incoming>
      <bpmn:outgoing>Flow_144</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_057" messageRef="Message_finance_impact_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_ModificationApplied" name="Treatment change applied">
      <bpmn:incoming>Flow_143</bpmn:incoming>
      <bpmn:incoming>Flow_144</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="TRT_Task_ReviewModification" name="Review the treatment change request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-treatment-change" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_137</bpmn:incoming>
      <bpmn:outgoing>Flow_138</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_ModificationToClinical" name="Send the change for clinical authorisation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.change-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-change&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_138</bpmn:incoming>
      <bpmn:outgoing>Flow_139</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_058" messageRef="Message_treatment_change_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_ModificationForwarded" name="Change forwarded for authorisation">
      <bpmn:incoming>Flow_139</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Comp_ReleaseSeries" name="Release the provisional appointment series" isForCompensation="true">
      <bpmn:documentation>Compensation handler. Frees every appointment in the series when the booking has to be undone, so nothing is left held against the patient.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-series" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Comp_ReleaseCycle" name="Release the provisional cycle booking" isForCompensation="true">
      <bpmn:documentation>Compensation handler for a cycle slot that was pencilled in and then could not be filled.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-cycle-booking" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CompSeries" name="Undo the provisional series">
      <bpmn:documentation>Thrown after the capacity re-attempts run out, before the case goes to the pathway team.</bpmn:documentation>
      <bpmn:incoming>Flow_113</bpmn:incoming>
      <bpmn:incoming>Flow_115</bpmn:incoming>
      <bpmn:incoming>Flow_148</bpmn:incoming>
      <bpmn:outgoing>Flow_149</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_003" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CompCycle" name="Undo the provisional cycle slot">
      <bpmn:incoming>Flow_128</bpmn:incoming>
      <bpmn:outgoing>Flow_150</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_004" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="TRT_Auto_RecordRetry" name="Record another capacity attempt">
      <bpmn:documentation>Counts the attempts so the loop can stop. Without a cap the case would retry for ever and nobody would ever pick it up.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.record-capacity-retry" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=externalResourceAttempts + 1" target="externalResourceAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_145</bpmn:incoming>
      <bpmn:outgoing>Flow_146</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CapacityCap" name="Have we tried long enough?" default="Flow_148">
      <bpmn:incoming>Flow_146</bpmn:incoming>
      <bpmn:outgoing>Flow_147</bpmn:outgoing>
      <bpmn:outgoing>Flow_148</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_BookingPending2" name="Tell the pathway team the booking was released">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_149</bpmn:incoming>
      <bpmn:outgoing>Flow_151</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_059" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_RetryTimer2" name="Retry the whole booking later">
      <bpmn:incoming>Flow_151</bpmn:incoming>
      <bpmn:outgoing>Flow_152</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_005">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingDelay" name="Flag the funding delay to the pathway team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.delay-flagged" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding-delay&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_153</bpmn:incoming>
      <bpmn:outgoing>Flow_154</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_060" messageRef="Message_funding_delay_flagged" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CompCycle" name="Cycle slot committed" attachedToRef="TRT_Auto_ScheduleCycle">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_002" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CompSeries" name="Series committed" attachedToRef="TRT_Auto_CreateSeries">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_001" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CycleNoSlots" name="No capacity" attachedToRef="TRT_Auto_FindCycleSlots">
      <bpmn:outgoing>Flow_129</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_007" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ExternalUnavailable" name="Unavailable" attachedToRef="TRT_Auto_CheckExternalResources">
      <bpmn:outgoing>Flow_113</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_006" errorRef="Error_EXTERNAL_RESOURCE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ConfirmationLost" name="No confirmation" attachedToRef="TRT_Auto_ProcessPayment">
      <bpmn:documentation>The provider may have taken the money. The transaction is investigated rather than charged again.</bpmn:documentation>
      <bpmn:outgoing>Flow_091</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_005" errorRef="Error_PAYMENT_CONFIRMATION_LOST" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ProviderUnavailable" name="Provider down" attachedToRef="TRT_Auto_ProcessPayment">
      <bpmn:outgoing>Flow_090</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_004" errorRef="Error_PAYMENT_PROVIDER_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_NotAuthorised" name="Not authorised" attachedToRef="TRT_Auto_ValidateRequest">
      <bpmn:outgoing>Flow_080</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_003" errorRef="Error_TREATMENT_REQUEST_UNAUTHORISED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_078" sourceRef="TRT_Start_BookingRequest" targetRef="TRT_Auto_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_079" sourceRef="TRT_Auto_ValidateRequest" targetRef="TRT_Throw_FundingCheck" />
    <bpmn:sequenceFlow id="Flow_080" sourceRef="TRT_Bnd_NotAuthorised" targetRef="TRT_Throw_RequestRejected" />
    <bpmn:sequenceFlow id="Flow_081" sourceRef="TRT_Throw_RequestRejected" targetRef="TRT_End_RequestRejected" />
    <bpmn:sequenceFlow id="Flow_108" name="Approval now in place" sourceRef="TRT_GW_FundingTimeoutAction" targetRef="TRT_Throw_FundingCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingChaseOutcome = "RECHECK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_082" sourceRef="TRT_Throw_FundingCheck" targetRef="TRT_EGW_Funding" />
    <bpmn:sequenceFlow id="Flow_083" sourceRef="TRT_EGW_Funding" targetRef="TRT_Catch_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_084" sourceRef="TRT_EGW_Funding" targetRef="TRT_Catch_FundingTimeout" />
    <bpmn:sequenceFlow id="Flow_085" sourceRef="TRT_Catch_FundingDecision" targetRef="TRT_GW_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_106" sourceRef="TRT_Catch_FundingTimeout" targetRef="TRT_Task_ReviewFundingTimeout" />
    <bpmn:sequenceFlow id="Flow_086" name="Patient pays" sourceRef="TRT_GW_FundingRoute" targetRef="TRT_Auto_PreparePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "PATIENT_PAYS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_087" name="Hospital, insurer or exemption" sourceRef="TRT_GW_FundingRoute" targetRef="TRT_IGW_ReadyToBook" />
    <bpmn:sequenceFlow id="Flow_099" sourceRef="TRT_Auto_NextAttempt" targetRef="TRT_Auto_PreparePayment" />
    <bpmn:sequenceFlow id="Flow_088" sourceRef="TRT_Auto_PreparePayment" targetRef="TRT_Auto_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_089" sourceRef="TRT_Auto_ProcessPayment" targetRef="TRT_GW_PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_092" name="Approved" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_IGW_ReadyToBook">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_093" name="Duplicate charge reported" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_Auto_Deduplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "DUPLICATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_094" name="Declined or cancelled" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_Task_ReviewDeclinedPayment" />
    <bpmn:sequenceFlow id="Flow_095" sourceRef="TRT_Auto_Deduplicate" targetRef="TRT_IGW_ReadyToBook" />
    <bpmn:sequenceFlow id="Flow_104" name="Clinician authorised" sourceRef="TRT_GW_UrgencyDecision" targetRef="TRT_IGW_ReadyToBook">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgentTreatmentAuthorised = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_110" sourceRef="TRT_IGW_ReadyToBook" targetRef="TRT_Auto_CreateSeries" />
    <bpmn:sequenceFlow id="Flow_096" sourceRef="TRT_Task_ReviewDeclinedPayment" targetRef="TRT_GW_DeclinedAction" />
    <bpmn:sequenceFlow id="Flow_097" name="Try another payment" sourceRef="TRT_GW_DeclinedAction" targetRef="TRT_Auto_NextAttempt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=declinedAction = "RETRY_PAYMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_098" name="Leave with Finance" sourceRef="TRT_GW_DeclinedAction" targetRef="TRT_Throw_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_090" sourceRef="TRT_Bnd_ProviderUnavailable" targetRef="TRT_Throw_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_100" sourceRef="TRT_Throw_PaymentUnresolved" targetRef="TRT_End_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_105" name="Not authorised" sourceRef="TRT_GW_UrgencyDecision" targetRef="TRT_End_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_091" sourceRef="TRT_Bnd_ConfirmationLost" targetRef="TRT_Throw_Investigation" />
    <bpmn:sequenceFlow id="Flow_101" sourceRef="TRT_Throw_Investigation" targetRef="TRT_Throw_UrgencyAuthorisation" />
    <bpmn:sequenceFlow id="Flow_102" sourceRef="TRT_Throw_UrgencyAuthorisation" targetRef="TRT_Catch_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_103" sourceRef="TRT_Catch_UrgencyDecision" targetRef="TRT_GW_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_107" sourceRef="TRT_Task_ReviewFundingTimeout" targetRef="TRT_GW_FundingTimeoutAction" />
    <bpmn:sequenceFlow id="Flow_109" name="Still waiting" sourceRef="TRT_GW_FundingTimeoutAction" targetRef="TRT_Throw_FundingTimeoutEscalation" />
    <bpmn:sequenceFlow id="Flow_153" sourceRef="TRT_Throw_FundingTimeoutEscalation" targetRef="TRT_Throw_FundingDelay" />
    <bpmn:sequenceFlow id="Flow_154" sourceRef="TRT_Throw_FundingDelay" targetRef="TRT_End_FundingPending" />
    <bpmn:sequenceFlow id="Flow_152" sourceRef="TRT_Catch_RetryTimer2" targetRef="TRT_Auto_CreateSeries" />
    <bpmn:sequenceFlow id="Flow_111" sourceRef="TRT_Auto_CreateSeries" targetRef="TRT_Auto_CheckExternalResources" />
    <bpmn:sequenceFlow id="Flow_147" name="Try again" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Auto_CheckExternalResources">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=externalResourceAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_112" sourceRef="TRT_Auto_CheckExternalResources" targetRef="TRT_GW_ExternalAvailable" />
    <bpmn:sequenceFlow id="Flow_114" name="All resources held" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Auto_ConfirmAppointments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=externalResourcesAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_115" name="Something is unavailable" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Throw_CompSeries" />
    <bpmn:sequenceFlow id="Flow_116" sourceRef="TRT_Auto_ConfirmAppointments" targetRef="TRT_Throw_TreatmentConfirmed" />
    <bpmn:sequenceFlow id="Flow_117" sourceRef="TRT_Throw_TreatmentConfirmed" targetRef="TRT_PGW_NotifySplit" />
    <bpmn:sequenceFlow id="Flow_118" sourceRef="TRT_PGW_NotifySplit" targetRef="TRT_Throw_LetterDraftRequested" />
    <bpmn:sequenceFlow id="Flow_119" sourceRef="TRT_PGW_NotifySplit" targetRef="TRT_Auto_SendTreatmentLetter" />
    <bpmn:sequenceFlow id="Flow_120" sourceRef="TRT_Throw_LetterDraftRequested" targetRef="TRT_PGW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_121" sourceRef="TRT_Auto_SendTreatmentLetter" targetRef="TRT_PGW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_122" sourceRef="TRT_PGW_NotifyJoin" targetRef="TRT_End_Scheduled" />
    <bpmn:sequenceFlow id="Flow_123" sourceRef="TRT_Throw_BookingPending" targetRef="TRT_Catch_RetryTimer" />
    <bpmn:sequenceFlow id="Flow_145" sourceRef="TRT_Catch_RetryTimer" targetRef="TRT_Auto_RecordRetry" />
    <bpmn:sequenceFlow id="Flow_124" sourceRef="TRT_Start_CycleApproved" targetRef="TRT_Auto_ScheduleCycle" />
    <bpmn:sequenceFlow id="Flow_125" sourceRef="TRT_Auto_ScheduleCycle" targetRef="TRT_Auto_FindCycleSlots" />
    <bpmn:sequenceFlow id="Flow_126" sourceRef="TRT_Auto_FindCycleSlots" targetRef="TRT_GW_CycleSlots" />
    <bpmn:sequenceFlow id="Flow_127" name="Slot found" sourceRef="TRT_GW_CycleSlots" targetRef="TRT_Throw_NextReviewDue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_128" name="Nothing available" sourceRef="TRT_GW_CycleSlots" targetRef="TRT_Throw_CompCycle" />
    <bpmn:sequenceFlow id="Flow_130" sourceRef="TRT_Throw_NextReviewDue" targetRef="TRT_GW_MoreCycles" />
    <bpmn:sequenceFlow id="Flow_131" name="Another cycle to come" sourceRef="TRT_GW_MoreCycles" targetRef="TRT_End_CycleScheduled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cycleNumber &lt; cycleCount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_132" name="Last cycle of the course" sourceRef="TRT_GW_MoreCycles" targetRef="TRT_End_CourseComplete" />
    <bpmn:sequenceFlow id="Flow_129" sourceRef="TRT_Bnd_CycleNoSlots" targetRef="TRT_Throw_CycleCapacityIssue" />
    <bpmn:sequenceFlow id="Flow_150" sourceRef="TRT_Throw_CompCycle" targetRef="TRT_Throw_CycleCapacityIssue" />
    <bpmn:sequenceFlow id="Flow_133" sourceRef="TRT_Throw_CycleCapacityIssue" targetRef="TRT_End_CyclePending" />
    <bpmn:sequenceFlow id="Flow_134" sourceRef="TRT_Start_CycleDelayed" targetRef="TRT_Task_RecordDelay" />
    <bpmn:sequenceFlow id="Flow_135" sourceRef="TRT_Task_RecordDelay" targetRef="TRT_Throw_DelayNotified" />
    <bpmn:sequenceFlow id="Flow_136" sourceRef="TRT_Throw_DelayNotified" targetRef="TRT_End_DelayRecorded" />
    <bpmn:sequenceFlow id="Flow_137" sourceRef="TRT_Start_Modification" targetRef="TRT_Task_ReviewModification" />
    <bpmn:sequenceFlow id="Flow_140" sourceRef="TRT_Start_ModificationAuthorised" targetRef="TRT_Auto_ApplyModification" />
    <bpmn:sequenceFlow id="Flow_141" sourceRef="TRT_Auto_ApplyModification" targetRef="TRT_GW_ModificationFinancial" />
    <bpmn:sequenceFlow id="Flow_142" name="Charge or payment affected" sourceRef="TRT_GW_ModificationFinancial" targetRef="TRT_Throw_ModificationFinance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=modificationAffectsFinance = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_143" name="No financial impact" sourceRef="TRT_GW_ModificationFinancial" targetRef="TRT_End_ModificationApplied" />
    <bpmn:sequenceFlow id="Flow_144" sourceRef="TRT_Throw_ModificationFinance" targetRef="TRT_End_ModificationApplied" />
    <bpmn:sequenceFlow id="Flow_138" sourceRef="TRT_Task_ReviewModification" targetRef="TRT_Throw_ModificationToClinical" />
    <bpmn:sequenceFlow id="Flow_139" sourceRef="TRT_Throw_ModificationToClinical" targetRef="TRT_End_ModificationForwarded" />
    <bpmn:sequenceFlow id="Flow_113" sourceRef="TRT_Bnd_ExternalUnavailable" targetRef="TRT_Throw_CompSeries" />
    <bpmn:sequenceFlow id="Flow_148" name="Stop and release the series" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Throw_CompSeries" />
    <bpmn:sequenceFlow id="Flow_149" sourceRef="TRT_Throw_CompSeries" targetRef="TRT_Throw_BookingPending2" />
    <bpmn:sequenceFlow id="Flow_146" sourceRef="TRT_Auto_RecordRetry" targetRef="TRT_GW_CapacityCap" />
    <bpmn:sequenceFlow id="Flow_151" sourceRef="TRT_Throw_BookingPending2" targetRef="TRT_Catch_RetryTimer2" />
    <bpmn:association id="TRT_Bnd_CompSeries_assoc" associationDirection="One" sourceRef="TRT_Bnd_CompSeries" targetRef="TRT_Comp_ReleaseSeries" />
    <bpmn:association id="TRT_Bnd_CompCycle_assoc" associationDirection="One" sourceRef="TRT_Bnd_CompCycle" targetRef="TRT_Comp_ReleaseCycle" />
  </bpmn:process>
  <bpmn:process id="finance-team" name="Finance Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="finance-team_lanes">
      <bpmn:lane id="finance-team_L1" name="Refunds and enquiries">
        <bpmn:flowNodeRef>FIN_Start_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_DecideRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_AuditRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_RefundDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_PrepareRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_ProcessRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_RefundStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_RefundRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_RefundDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_RefundPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordNoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_NoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_NoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_ImpactReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ReviewImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_ImpactAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_FinanceOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_ImpactReviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_Enquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_AnswerEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Bnd_RefundFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance-team_L0" name="Funding, charges and payments">
        <bpmn:flowNodeRef>FIN_Start_FundingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_AuditFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_FundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_FundingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_FundingDecided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_CalculateCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ManualCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ChasePreAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_PaymentInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_InvestigationOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_InvestigationResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_InvestigationClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Bnd_ChargeFailed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="FIN_Start_FundingCheck" name="Funding check requested">
      <bpmn:outgoing>Flow_155</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_061" messageRef="Message_funding_check_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_Task_DetermineFunding" name="Determine the funding route and record the approval">
      <bpmn:documentation>Records the responsible organisation, the authorisation reference, the approved amount and any limits attached to the approval.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="determine-funding-route" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_155</bpmn:incoming>
      <bpmn:outgoing>Flow_156</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_AuditFunding" name="Record the funding decision for audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_156</bpmn:incoming>
      <bpmn:outgoing>Flow_157</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_FundingRoute" name="Which funding route applies?" default="Flow_160">
      <bpmn:incoming>Flow_157</bpmn:incoming>
      <bpmn:outgoing>Flow_158</bpmn:outgoing>
      <bpmn:outgoing>Flow_159</bpmn:outgoing>
      <bpmn:outgoing>Flow_160</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordApproval" name="Record the funding approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-funding-approval" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_158</bpmn:incoming>
      <bpmn:incoming>Flow_163</bpmn:incoming>
      <bpmn:outgoing>Flow_161</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_FundingDecision" name="Return the funding decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.decision-received" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_161</bpmn:incoming>
      <bpmn:incoming>Flow_162</bpmn:incoming>
      <bpmn:incoming>Flow_165</bpmn:incoming>
      <bpmn:outgoing>Flow_166</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_062" messageRef="Message_funding_decision_received" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_FundingDecided" name="Funding decision returned">
      <bpmn:incoming>Flow_166</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_Auto_CalculateCharge" name="Work out the charge payable">
      <bpmn:documentation>Applies the tariff for the treatment plus the patient's funding category. Returns the amount only - never any card data.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.calculate-charge" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_159</bpmn:incoming>
      <bpmn:outgoing>Flow_162</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="FIN_Task_ManualCharge" name="Price the treatment manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="manual-charge-entry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_164</bpmn:incoming>
      <bpmn:outgoing>Flow_165</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FIN_Task_ChasePreAuthorisation" name="Chase the insurer for pre-authorisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="chase-pre-authorisation" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_160</bpmn:incoming>
      <bpmn:outgoing>Flow_163</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="FIN_Start_PaymentInvestigation" name="Payment taken without confirmation">
      <bpmn:outgoing>Flow_167</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_063" messageRef="Message_payment_investigation_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_Task_InvestigatePayment" name="Investigate the unconfirmed payment">
      <bpmn:documentation>Reconciles the provider's transaction list against the booking before anyone asks the patient for money again.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="investigate-unconfirmed-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_167</bpmn:incoming>
      <bpmn:outgoing>Flow_168</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FIN_GW_InvestigationOutcome" name="Was the money actually taken?" default="Flow_170">
      <bpmn:incoming>Flow_168</bpmn:incoming>
      <bpmn:outgoing>Flow_169</bpmn:outgoing>
      <bpmn:outgoing>Flow_170</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordPayment" name="Record the payment against the account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-payment-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_169</bpmn:incoming>
      <bpmn:outgoing>Flow_171</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_InvestigationResolved" name="Investigation closed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.investigation-resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-investigation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_170</bpmn:incoming>
      <bpmn:incoming>Flow_171</bpmn:incoming>
      <bpmn:outgoing>Flow_172</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_064" messageRef="Message_payment_investigation_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_InvestigationClosed" name="Investigation closed">
      <bpmn:incoming>Flow_172</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FIN_Start_Refund" name="Refund decision required">
      <bpmn:outgoing>Flow_173</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_065" messageRef="Message_refund_required" />
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_Task_DecideRefund" name="Decide whether a refund is due">
      <bpmn:documentation>Clinical staff may describe the treatment decision but only Finance, holding the right financial authority, approves a refund.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="decide-refund" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_173</bpmn:incoming>
      <bpmn:outgoing>Flow_174</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_AuditRefund" name="Record the refund decision for audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_174</bpmn:incoming>
      <bpmn:outgoing>Flow_175</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_RefundDecision" name="What did Finance decide?" default="Flow_177">
      <bpmn:incoming>Flow_175</bpmn:incoming>
      <bpmn:outgoing>Flow_176</bpmn:outgoing>
      <bpmn:outgoing>Flow_177</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_PrepareRefund" name="Prepare the approved refund">
      <bpmn:documentation>Checks the refund against the original transaction so the patient is never refunded more than was taken.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.prepare-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_176</bpmn:incoming>
      <bpmn:outgoing>Flow_178</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_Auto_ProcessRefund" name="Send the refund to the payment provider">
      <bpmn:documentation>Outbound call to the external payment provider. Only the refund status and amount come back to the hospital.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_178</bpmn:incoming>
      <bpmn:outgoing>Flow_179</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_RefundStatus" name="Did the provider accept the refund?" default="Flow_182">
      <bpmn:incoming>Flow_179</bpmn:incoming>
      <bpmn:outgoing>Flow_181</bpmn:outgoing>
      <bpmn:outgoing>Flow_182</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordRefund" name="Record the refund against the patient account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_181</bpmn:incoming>
      <bpmn:outgoing>Flow_183</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FIN_End_RefundRecorded" name="Refund recorded">
      <bpmn:incoming>Flow_183</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="FIN_Throw_RefundDelayed" name="Tell the patient the refund is delayed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="refund.delayed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-refund&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_180</bpmn:incoming>
      <bpmn:incoming>Flow_182</bpmn:incoming>
      <bpmn:outgoing>Flow_184</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_066" messageRef="Message_refund_delayed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_RefundPending" name="Refund still with the provider">
      <bpmn:incoming>Flow_184</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_Auto_RecordNoRefund" name="Record that no refund is due">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_177</bpmn:incoming>
      <bpmn:outgoing>Flow_185</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_NoRefund" name="Tell the patient no refund is due">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="refund.declined" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-refund&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_185</bpmn:incoming>
      <bpmn:outgoing>Flow_186</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_067" messageRef="Message_refund_declined" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_NoRefund" name="No refund - decision recorded">
      <bpmn:incoming>Flow_186</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FIN_Start_ImpactReview" name="Financial impact review requested">
      <bpmn:outgoing>Flow_187</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_068" messageRef="Message_finance_impact_review_requested" />
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_Task_ReviewImpact" name="Review the financial impact of the treatment change">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="review-financial-impact" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_187</bpmn:incoming>
      <bpmn:outgoing>Flow_188</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FIN_GW_ImpactAction" name="What does the change require?" default="Flow_190">
      <bpmn:incoming>Flow_188</bpmn:incoming>
      <bpmn:outgoing>Flow_189</bpmn:outgoing>
      <bpmn:outgoing>Flow_190</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="FIN_Throw_FinanceOutcome" name="Record the financial outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="finance.impact-resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-finance-impact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_189</bpmn:incoming>
      <bpmn:incoming>Flow_190</bpmn:incoming>
      <bpmn:outgoing>Flow_191</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_069" messageRef="Message_finance_impact_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_ImpactReviewed" name="Financial impact resolved">
      <bpmn:incoming>Flow_191</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FIN_Start_Enquiry" name="Payment enquiry">
      <bpmn:outgoing>Flow_192</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_070" messageRef="Message_enquiry_assigned_finance" />
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_Task_AnswerEnquiry" name="Answer the payment or funding enquiry">
      <bpmn:documentation>Call handlers only answer from authorised information. Anything else comes here.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="answer-financial-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_192</bpmn:incoming>
      <bpmn:outgoing>Flow_193</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_EnquiryAnswered" name="Enquiry answered">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_193</bpmn:incoming>
      <bpmn:outgoing>Flow_194</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_071" messageRef="Message_enquiry_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_EnquiryAnswered" name="Enquiry answered">
      <bpmn:incoming>Flow_194</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="FIN_Bnd_RefundFailed" name="Rejected" attachedToRef="FIN_Auto_ProcessRefund">
      <bpmn:outgoing>Flow_180</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_009" errorRef="Error_PAYMENT_PROVIDER_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="FIN_Bnd_ChargeFailed" name="Pricing failed" attachedToRef="FIN_Auto_CalculateCharge">
      <bpmn:outgoing>Flow_164</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_008" errorRef="Error_CHARGE_CALCULATION_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_155" sourceRef="FIN_Start_FundingCheck" targetRef="FIN_Task_DetermineFunding" />
    <bpmn:sequenceFlow id="Flow_156" sourceRef="FIN_Task_DetermineFunding" targetRef="FIN_Auto_AuditFunding" />
    <bpmn:sequenceFlow id="Flow_157" sourceRef="FIN_Auto_AuditFunding" targetRef="FIN_GW_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_158" name="Approved or exempt" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "HOSPITAL_FUNDED" or fundingRoute = "INSURER_APPROVED" or fundingRoute = "EXEMPTION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_159" name="Patient pays" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_CalculateCharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "PATIENT_PAYS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_160" name="Pre-authorisation outstanding" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Task_ChasePreAuthorisation" />
    <bpmn:sequenceFlow id="Flow_163" sourceRef="FIN_Task_ChasePreAuthorisation" targetRef="FIN_Auto_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_161" sourceRef="FIN_Auto_RecordApproval" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_162" sourceRef="FIN_Auto_CalculateCharge" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_165" sourceRef="FIN_Task_ManualCharge" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_166" sourceRef="FIN_Throw_FundingDecision" targetRef="FIN_End_FundingDecided" />
    <bpmn:sequenceFlow id="Flow_164" sourceRef="FIN_Bnd_ChargeFailed" targetRef="FIN_Task_ManualCharge" />
    <bpmn:sequenceFlow id="Flow_167" sourceRef="FIN_Start_PaymentInvestigation" targetRef="FIN_Task_InvestigatePayment" />
    <bpmn:sequenceFlow id="Flow_168" sourceRef="FIN_Task_InvestigatePayment" targetRef="FIN_GW_InvestigationOutcome" />
    <bpmn:sequenceFlow id="Flow_169" name="Payment located" sourceRef="FIN_GW_InvestigationOutcome" targetRef="FIN_Auto_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentFound = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_170" name="Nothing was taken" sourceRef="FIN_GW_InvestigationOutcome" targetRef="FIN_Throw_InvestigationResolved" />
    <bpmn:sequenceFlow id="Flow_171" sourceRef="FIN_Auto_RecordPayment" targetRef="FIN_Throw_InvestigationResolved" />
    <bpmn:sequenceFlow id="Flow_172" sourceRef="FIN_Throw_InvestigationResolved" targetRef="FIN_End_InvestigationClosed" />
    <bpmn:sequenceFlow id="Flow_173" sourceRef="FIN_Start_Refund" targetRef="FIN_Task_DecideRefund" />
    <bpmn:sequenceFlow id="Flow_174" sourceRef="FIN_Task_DecideRefund" targetRef="FIN_Auto_AuditRefund" />
    <bpmn:sequenceFlow id="Flow_175" sourceRef="FIN_Auto_AuditRefund" targetRef="FIN_GW_RefundDecision" />
    <bpmn:sequenceFlow id="Flow_176" name="Refund approved" sourceRef="FIN_GW_RefundDecision" targetRef="FIN_Auto_PrepareRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundDecision = "FULL_REFUND" or refundDecision = "PARTIAL_REFUND"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_177" name="No refund due" sourceRef="FIN_GW_RefundDecision" targetRef="FIN_Auto_RecordNoRefund" />
    <bpmn:sequenceFlow id="Flow_178" sourceRef="FIN_Auto_PrepareRefund" targetRef="FIN_Auto_ProcessRefund" />
    <bpmn:sequenceFlow id="Flow_179" sourceRef="FIN_Auto_ProcessRefund" targetRef="FIN_GW_RefundStatus" />
    <bpmn:sequenceFlow id="Flow_181" name="Refunded" sourceRef="FIN_GW_RefundStatus" targetRef="FIN_Auto_RecordRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundStatus = "REFUNDED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_182" name="Not accepted yet" sourceRef="FIN_GW_RefundStatus" targetRef="FIN_Throw_RefundDelayed" />
    <bpmn:sequenceFlow id="Flow_183" sourceRef="FIN_Auto_RecordRefund" targetRef="FIN_End_RefundRecorded" />
    <bpmn:sequenceFlow id="Flow_180" sourceRef="FIN_Bnd_RefundFailed" targetRef="FIN_Throw_RefundDelayed" />
    <bpmn:sequenceFlow id="Flow_184" sourceRef="FIN_Throw_RefundDelayed" targetRef="FIN_End_RefundPending" />
    <bpmn:sequenceFlow id="Flow_185" sourceRef="FIN_Auto_RecordNoRefund" targetRef="FIN_Throw_NoRefund" />
    <bpmn:sequenceFlow id="Flow_186" sourceRef="FIN_Throw_NoRefund" targetRef="FIN_End_NoRefund" />
    <bpmn:sequenceFlow id="Flow_187" sourceRef="FIN_Start_ImpactReview" targetRef="FIN_Task_ReviewImpact" />
    <bpmn:sequenceFlow id="Flow_188" sourceRef="FIN_Task_ReviewImpact" targetRef="FIN_GW_ImpactAction" />
    <bpmn:sequenceFlow id="Flow_189" name="Charge or refund to adjust" sourceRef="FIN_GW_ImpactAction" targetRef="FIN_Throw_FinanceOutcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=impactAction = "ADJUST_CHARGE" or impactAction = "REFUND_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_190" name="No change to the account" sourceRef="FIN_GW_ImpactAction" targetRef="FIN_Throw_FinanceOutcome" />
    <bpmn:sequenceFlow id="Flow_191" sourceRef="FIN_Throw_FinanceOutcome" targetRef="FIN_End_ImpactReviewed" />
    <bpmn:sequenceFlow id="Flow_192" sourceRef="FIN_Start_Enquiry" targetRef="FIN_Task_AnswerEnquiry" />
    <bpmn:sequenceFlow id="Flow_193" sourceRef="FIN_Task_AnswerEnquiry" targetRef="FIN_Throw_EnquiryAnswered" />
    <bpmn:sequenceFlow id="Flow_194" sourceRef="FIN_Throw_EnquiryAnswered" targetRef="FIN_End_EnquiryAnswered" />
  </bpmn:process>
  <bpmn:process id="outpatient-bookings" name="Outpatient Bookings Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="outpatient-bookings_lanes">
      <bpmn:lane id="outpatient-bookings_L2" name="Cancellations, declines and enquiries">
        <bpmn:flowNodeRef>OUT_Start_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_RecordOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_DecideNextAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_CancellationAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_ClinicalReviewOfPathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_PathwayReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_FindRebookSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_Reoffered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_ReferrerNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_FinanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_CancellationHandled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Start_TreatmentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_RecordDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_DeclineToClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_DeclineRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Start_AdminEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_AnswerAdminEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Bnd_RebookNoSlots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="outpatient-bookings_L1" name="Follow-up appointments">
        <bpmn:flowNodeRef>OUT_Throw_PhoneContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Catch_PhoneContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Start_FollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_FindFollowUpSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_FollowUpSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_ConfirmFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_CreateFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_SendFollowUpLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_FollowUpBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_FollowUpEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_FollowUpEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Bnd_FollowUpNoSlots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="outpatient-bookings_L0" name="New patient appointments">
        <bpmn:flowNodeRef>OUT_Start_ReferralAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_CheckPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_FindSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_SlotsFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_ChooseSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_CreateAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_NotifyChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Auto_DispatchAppointmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_ChaseLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_AppointmentBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Task_ReviewAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_GW_AvailabilityAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Throw_NoSlotEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_End_NoSlotEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Bnd_LetterFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OUT_Bnd_SchedulingUnavailable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OUT_Start_ReferralAccepted" name="Referral accepted - to book">
      <bpmn:outgoing>Flow_195</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_072" messageRef="Message_referral_accepted" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="OUT_Auto_CheckPriority" name="Work out priority, timeframe and contact rule">
      <bpmn:documentation>Applies the two week rule: an appointment inside the next fortnight also needs a telephone call, anything further out is letter only.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.check-priority-and-contact-rule" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_195</bpmn:incoming>
      <bpmn:incoming>Flow_212</bpmn:incoming>
      <bpmn:outgoing>Flow_196</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OUT_Auto_FindSlots" name="Search the external scheduling service for appointments">
      <bpmn:documentation>Outbound call to the scheduling supplier. The supplier itself is a black box - the hospital models the boundary, not their internals.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_196</bpmn:incoming>
      <bpmn:outgoing>Flow_197</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OUT_GW_SlotsFound" name="Did the service return anything usable?" default="Flow_199">
      <bpmn:incoming>Flow_197</bpmn:incoming>
      <bpmn:outgoing>Flow_198</bpmn:outgoing>
      <bpmn:outgoing>Flow_199</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OUT_Task_ChooseSlot" name="Choose and confirm the appointment">
      <bpmn:documentation>Records the slot chosen, the clinic location and any access requirement the patient has told us about.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="choose-appointment-slot" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_198</bpmn:incoming>
      <bpmn:outgoing>Flow_201</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OUT_Auto_CreateAppointment" name="Create the appointment record">
      <bpmn:documentation>Idempotent on the booking reference, so a resubmitted booking never produces a second appointment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.create-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_201</bpmn:incoming>
      <bpmn:outgoing>Flow_202</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="OUT_GW_NotifyChannels" name="Which contacts does this patient need?">
      <bpmn:incoming>Flow_202</bpmn:incoming>
      <bpmn:outgoing>Flow_203</bpmn:outgoing>
      <bpmn:outgoing>Flow_204</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="OUT_Auto_DispatchAppointmentLetter" name="Send the appointment letter">
      <bpmn:documentation>Goes to the patient on the channel they asked for. The recipients are set here rather than left to the supplier.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;patient&#34;]" target="letterRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_203</bpmn:incoming>
      <bpmn:incoming>Flow_207</bpmn:incoming>
      <bpmn:outgoing>Flow_205</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="OUT_Task_ChaseLetter" name="Chase the appointment letter">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="resolve-dispatch-problem" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_206</bpmn:incoming>
      <bpmn:outgoing>Flow_207</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="OUT_Throw_PhoneContact" name="Ask for a telephone call">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="appointment.phone-contact-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-phone-contact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_204</bpmn:incoming>
      <bpmn:outgoing>Flow_208</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_073" messageRef="Message_appointment_phone_contact_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="OUT_Catch_PhoneContact" name="Contact finished">
      <bpmn:incoming>Flow_208</bpmn:incoming>
      <bpmn:outgoing>Flow_209</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_074" messageRef="Message_appointment_phone_contact_finished" />
    </bpmn:intermediateCatchEvent>
    <bpmn:inclusiveGateway id="OUT_GW_NotifyJoin" name="Patient notification complete">
      <bpmn:incoming>Flow_205</bpmn:incoming>
      <bpmn:incoming>Flow_209</bpmn:incoming>
      <bpmn:outgoing>Flow_210</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="OUT_End_AppointmentBooked" name="New patient appointment confirmed">
      <bpmn:incoming>Flow_210</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="OUT_Task_ReviewAvailability" name="Decide what to do without a suitable slot">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="review-appointment-availability" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_199</bpmn:incoming>
      <bpmn:incoming>Flow_200</bpmn:incoming>
      <bpmn:outgoing>Flow_211</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="OUT_GW_AvailabilityAction" name="How should the booking gap be handled?" default="Flow_213">
      <bpmn:incoming>Flow_211</bpmn:incoming>
      <bpmn:outgoing>Flow_212</bpmn:outgoing>
      <bpmn:outgoing>Flow_213</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="OUT_Throw_NoSlotEscalation" name="Refer the delay to the pathway team">
      <bpmn:documentation>Escalated on purpose instead of quietly booking outside the period the Consultant asked for.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="booking.no-slot-escalation" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-booking-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_213</bpmn:incoming>
      <bpmn:outgoing>Flow_214</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_075" messageRef="Message_booking_no_slot_escalation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_NoSlotEscalated" name="Booking gap escalated">
      <bpmn:incoming>Flow_214</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="OUT_Start_FollowUp" name="Follow-up appointment requested">
      <bpmn:outgoing>Flow_215</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_076" messageRef="Message_follow_up_appointment_requested" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="OUT_Auto_FindFollowUpSlots" name="Look for a follow-up slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_215</bpmn:incoming>
      <bpmn:outgoing>Flow_216</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OUT_GW_FollowUpSlots" name="Was a follow-up slot found?" default="Flow_218">
      <bpmn:incoming>Flow_216</bpmn:incoming>
      <bpmn:outgoing>Flow_217</bpmn:outgoing>
      <bpmn:outgoing>Flow_218</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OUT_Task_ConfirmFollowUp" name="Confirm the follow-up appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="confirm-follow-up-appointment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_217</bpmn:incoming>
      <bpmn:outgoing>Flow_220</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OUT_Auto_CreateFollowUp" name="Create the follow-up appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.create-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_220</bpmn:incoming>
      <bpmn:outgoing>Flow_221</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OUT_Auto_SendFollowUpLetter" name="Tell the patient about the follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;patient&#34;]" target="letterRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_221</bpmn:incoming>
      <bpmn:outgoing>Flow_222</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OUT_End_FollowUpBooked" name="Follow-up appointment confirmed">
      <bpmn:incoming>Flow_222</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="OUT_Throw_FollowUpEscalation" name="Highlight the follow-up delay">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="follow-up.no-slot-escalation" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-followup-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_218</bpmn:incoming>
      <bpmn:incoming>Flow_219</bpmn:incoming>
      <bpmn:outgoing>Flow_223</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_077" messageRef="Message_follow_up_no_slot_escalation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_FollowUpEscalated" name="Follow-up delay with the pathway team">
      <bpmn:incoming>Flow_223</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="OUT_Start_Cancelled" name="Cancelled, declined or not attended">
      <bpmn:outgoing>Flow_224</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_078" messageRef="Message_appointment_cancelled_or_dna" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="OUT_Auto_RecordOutcome" name="Record the appointment outcome">
      <bpmn:documentation>Captures the outcome, who reported it and when. Administrative staff record it; they do not decide whether treatment continues.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.record-appointment-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_225</bpmn:incoming>
      <bpmn:outgoing>Flow_226</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="OUT_Task_DecideNextAction" name="Decide whether another appointment is offered">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="decide-cancellation-action" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_224</bpmn:incoming>
      <bpmn:outgoing>Flow_225</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="OUT_GW_CancellationAction" name="What happens next?" default="Flow_229">
      <bpmn:incoming>Flow_226</bpmn:incoming>
      <bpmn:outgoing>Flow_227</bpmn:outgoing>
      <bpmn:outgoing>Flow_228</bpmn:outgoing>
      <bpmn:outgoing>Flow_229</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="OUT_Throw_ClinicalReviewOfPathway" name="Ask the clinical team to review the pathway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="pathway.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-pathway-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_228</bpmn:incoming>
      <bpmn:outgoing>Flow_232</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_079" messageRef="Message_pathway_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_PathwayReview" name="Pathway review requested">
      <bpmn:incoming>Flow_232</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="OUT_Auto_FindRebookSlots" name="Look for a replacement appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_227</bpmn:incoming>
      <bpmn:outgoing>Flow_230</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OUT_End_Reoffered" name="Replacement appointment offered">
      <bpmn:incoming>Flow_230</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="OUT_Throw_ReferrerNotified" name="Inform the referring organisation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-sent" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_229</bpmn:incoming>
      <bpmn:outgoing>Flow_233</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_080" messageRef="Message_referral_outcome_sent" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="OUT_Throw_FinanceReview" name="Ask Finance about the payment taken">
      <bpmn:documentation>Only sent when money has already changed hands. Decisions about continuing treatment stay with the clinical team.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="refund.required" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-refund&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_233</bpmn:incoming>
      <bpmn:outgoing>Flow_234</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_081" messageRef="Message_refund_required" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_CancellationHandled" name="Cancellation handled">
      <bpmn:incoming>Flow_231</bpmn:incoming>
      <bpmn:incoming>Flow_234</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="OUT_Start_TreatmentDeclined" name="Patient declined treatment">
      <bpmn:outgoing>Flow_235</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_082" messageRef="Message_treatment_declined" />
    </bpmn:startEvent>
    <bpmn:userTask id="OUT_Task_RecordDecline" name="Record the decline and arrange clinical follow-up">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="record-treatment-decline" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_235</bpmn:incoming>
      <bpmn:outgoing>Flow_236</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="OUT_Throw_DeclineToClinical" name="Decline to clinical team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="pathway.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-pathway-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_236</bpmn:incoming>
      <bpmn:outgoing>Flow_237</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_083" messageRef="Message_pathway_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_DeclineRecorded" name="Decline recorded">
      <bpmn:incoming>Flow_237</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="OUT_Start_AdminEnquiry" name="Admin enquiry handed over">
      <bpmn:outgoing>Flow_238</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_084" messageRef="Message_enquiry_assigned_admin" />
    </bpmn:startEvent>
    <bpmn:userTask id="OUT_Task_AnswerAdminEnquiry" name="Answer the administrative enquiry">
      <bpmn:documentation>The same form the call handlers use, so an enquiry record looks the same whichever team picks it up.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="answer-administrative-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_238</bpmn:incoming>
      <bpmn:outgoing>Flow_239</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="OUT_Throw_EnquiryAnswered" name="Administrative enquiry answered">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_239</bpmn:incoming>
      <bpmn:outgoing>Flow_240</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_085" messageRef="Message_enquiry_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="OUT_End_EnquiryAnswered" name="Enquiry answered">
      <bpmn:incoming>Flow_240</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="OUT_Bnd_RebookNoSlots" name="No slot" attachedToRef="OUT_Auto_FindRebookSlots">
      <bpmn:outgoing>Flow_231</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_013" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="OUT_Bnd_FollowUpNoSlots" name="No slot" attachedToRef="OUT_Auto_FindFollowUpSlots">
      <bpmn:outgoing>Flow_219</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_012" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="OUT_Bnd_LetterFailed" name="Rejected" attachedToRef="OUT_Auto_DispatchAppointmentLetter">
      <bpmn:outgoing>Flow_206</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_011" errorRef="Error_CORRESPONDENCE_SERVICE_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="OUT_Bnd_SchedulingUnavailable" name="Service down" attachedToRef="OUT_Auto_FindSlots">
      <bpmn:documentation>Transient failures are retried first. Once the worker gives up, the booking gap is handled deliberately instead of the request disappearing.</bpmn:documentation>
      <bpmn:outgoing>Flow_200</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_010" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_195" sourceRef="OUT_Start_ReferralAccepted" targetRef="OUT_Auto_CheckPriority" />
    <bpmn:sequenceFlow id="Flow_212" name="Search wider" sourceRef="OUT_GW_AvailabilityAction" targetRef="OUT_Auto_CheckPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=availabilityAction = "WIDEN_SEARCH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_196" sourceRef="OUT_Auto_CheckPriority" targetRef="OUT_Auto_FindSlots" />
    <bpmn:sequenceFlow id="Flow_197" sourceRef="OUT_Auto_FindSlots" targetRef="OUT_GW_SlotsFound" />
    <bpmn:sequenceFlow id="Flow_198" name="Options available" sourceRef="OUT_GW_SlotsFound" targetRef="OUT_Task_ChooseSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_199" name="Nothing suitable" sourceRef="OUT_GW_SlotsFound" targetRef="OUT_Task_ReviewAvailability" />
    <bpmn:sequenceFlow id="Flow_201" sourceRef="OUT_Task_ChooseSlot" targetRef="OUT_Auto_CreateAppointment" />
    <bpmn:sequenceFlow id="Flow_202" sourceRef="OUT_Auto_CreateAppointment" targetRef="OUT_GW_NotifyChannels" />
    <bpmn:sequenceFlow id="Flow_203" name="Letter always" sourceRef="OUT_GW_NotifyChannels" targetRef="OUT_Auto_DispatchAppointmentLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_204" name="Within two weeks - call as well" sourceRef="OUT_GW_NotifyChannels" targetRef="OUT_Throw_PhoneContact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresPhoneCall = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_207" sourceRef="OUT_Task_ChaseLetter" targetRef="OUT_Auto_DispatchAppointmentLetter" />
    <bpmn:sequenceFlow id="Flow_205" sourceRef="OUT_Auto_DispatchAppointmentLetter" targetRef="OUT_GW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_206" sourceRef="OUT_Bnd_LetterFailed" targetRef="OUT_Task_ChaseLetter" />
    <bpmn:sequenceFlow id="Flow_208" sourceRef="OUT_Throw_PhoneContact" targetRef="OUT_Catch_PhoneContact" />
    <bpmn:sequenceFlow id="Flow_209" sourceRef="OUT_Catch_PhoneContact" targetRef="OUT_GW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_210" sourceRef="OUT_GW_NotifyJoin" targetRef="OUT_End_AppointmentBooked" />
    <bpmn:sequenceFlow id="Flow_200" sourceRef="OUT_Bnd_SchedulingUnavailable" targetRef="OUT_Task_ReviewAvailability" />
    <bpmn:sequenceFlow id="Flow_211" sourceRef="OUT_Task_ReviewAvailability" targetRef="OUT_GW_AvailabilityAction" />
    <bpmn:sequenceFlow id="Flow_213" name="Escalate" sourceRef="OUT_GW_AvailabilityAction" targetRef="OUT_Throw_NoSlotEscalation" />
    <bpmn:sequenceFlow id="Flow_214" sourceRef="OUT_Throw_NoSlotEscalation" targetRef="OUT_End_NoSlotEscalated" />
    <bpmn:sequenceFlow id="Flow_215" sourceRef="OUT_Start_FollowUp" targetRef="OUT_Auto_FindFollowUpSlots" />
    <bpmn:sequenceFlow id="Flow_216" sourceRef="OUT_Auto_FindFollowUpSlots" targetRef="OUT_GW_FollowUpSlots" />
    <bpmn:sequenceFlow id="Flow_217" name="Slot inside the window" sourceRef="OUT_GW_FollowUpSlots" targetRef="OUT_Task_ConfirmFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_218" name="Outside the clinical window" sourceRef="OUT_GW_FollowUpSlots" targetRef="OUT_Throw_FollowUpEscalation" />
    <bpmn:sequenceFlow id="Flow_220" sourceRef="OUT_Task_ConfirmFollowUp" targetRef="OUT_Auto_CreateFollowUp" />
    <bpmn:sequenceFlow id="Flow_221" sourceRef="OUT_Auto_CreateFollowUp" targetRef="OUT_Auto_SendFollowUpLetter" />
    <bpmn:sequenceFlow id="Flow_222" sourceRef="OUT_Auto_SendFollowUpLetter" targetRef="OUT_End_FollowUpBooked" />
    <bpmn:sequenceFlow id="Flow_219" sourceRef="OUT_Bnd_FollowUpNoSlots" targetRef="OUT_Throw_FollowUpEscalation" />
    <bpmn:sequenceFlow id="Flow_223" sourceRef="OUT_Throw_FollowUpEscalation" targetRef="OUT_End_FollowUpEscalated" />
    <bpmn:sequenceFlow id="Flow_224" sourceRef="OUT_Start_Cancelled" targetRef="OUT_Task_DecideNextAction" />
    <bpmn:sequenceFlow id="Flow_225" sourceRef="OUT_Task_DecideNextAction" targetRef="OUT_Auto_RecordOutcome" />
    <bpmn:sequenceFlow id="Flow_226" sourceRef="OUT_Auto_RecordOutcome" targetRef="OUT_GW_CancellationAction" />
    <bpmn:sequenceFlow id="Flow_227" name="Offer another date" sourceRef="OUT_GW_CancellationAction" targetRef="OUT_Auto_FindRebookSlots">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cancellationAction = "REBOOK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_228" name="Clinical review" sourceRef="OUT_GW_CancellationAction" targetRef="OUT_Throw_ClinicalReviewOfPathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cancellationAction = "CLINICAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_229" name="Close and inform the referrer" sourceRef="OUT_GW_CancellationAction" targetRef="OUT_Throw_ReferrerNotified" />
    <bpmn:sequenceFlow id="Flow_232" sourceRef="OUT_Throw_ClinicalReviewOfPathway" targetRef="OUT_End_PathwayReview" />
    <bpmn:sequenceFlow id="Flow_230" sourceRef="OUT_Auto_FindRebookSlots" targetRef="OUT_End_Reoffered" />
    <bpmn:sequenceFlow id="Flow_233" sourceRef="OUT_Throw_ReferrerNotified" targetRef="OUT_Throw_FinanceReview" />
    <bpmn:sequenceFlow id="Flow_234" sourceRef="OUT_Throw_FinanceReview" targetRef="OUT_End_CancellationHandled" />
    <bpmn:sequenceFlow id="Flow_231" sourceRef="OUT_Bnd_RebookNoSlots" targetRef="OUT_End_CancellationHandled" />
    <bpmn:sequenceFlow id="Flow_235" sourceRef="OUT_Start_TreatmentDeclined" targetRef="OUT_Task_RecordDecline" />
    <bpmn:sequenceFlow id="Flow_236" sourceRef="OUT_Task_RecordDecline" targetRef="OUT_Throw_DeclineToClinical" />
    <bpmn:sequenceFlow id="Flow_237" sourceRef="OUT_Throw_DeclineToClinical" targetRef="OUT_End_DeclineRecorded" />
    <bpmn:sequenceFlow id="Flow_238" sourceRef="OUT_Start_AdminEnquiry" targetRef="OUT_Task_AnswerAdminEnquiry" />
    <bpmn:sequenceFlow id="Flow_239" sourceRef="OUT_Task_AnswerAdminEnquiry" targetRef="OUT_Throw_EnquiryAnswered" />
    <bpmn:sequenceFlow id="Flow_240" sourceRef="OUT_Throw_EnquiryAnswered" targetRef="OUT_End_EnquiryAnswered" />
  </bpmn:process>
  <bpmn:process id="patient-pathway-coordinators" name="Patient Pathway Coordinators" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="patient-pathway-coordinators_lanes">
      <bpmn:lane id="patient-pathway-coordinators_L1" name="Booking and treatment delays">
        <bpmn:flowNodeRef>PCW_Start_BookingDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Start_TreatmentPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Start_FollowUpDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Task_ReviewDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_GW_DelayAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Throw_DelayToClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_DelayWithClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Auto_SendDelayLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_PatientInformed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Start_FundingDelay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="patient-pathway-coordinators_L0" name="Correspondence monitoring">
        <bpmn:flowNodeRef>PCW_Start_WeeklyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_GW_OverdueBand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Auto_SuppressDuplicates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Throw_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_Reminded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Throw_EscalateManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_EscalatedManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Throw_EscalateHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_EscalatedHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Start_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_Auto_AddToMonitoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PCW_End_Monitoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_Pathway_Report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PCW_Start_WeeklyReview" name="Weekly correspondence review">
      <bpmn:documentation>Runs every week and looks for clinic letters that have slipped past the seven day target.</bpmn:documentation>
      <bpmn:outgoing>Flow_258</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_006">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT168H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="PCW_GW_OverdueBand" name="How far overdue is the letter?" default="Flow_243">
      <bpmn:incoming>Flow_259</bpmn:incoming>
      <bpmn:outgoing>Flow_241</bpmn:outgoing>
      <bpmn:outgoing>Flow_242</bpmn:outgoing>
      <bpmn:outgoing>Flow_243</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PCW_Auto_SuppressDuplicates" name="Drop letters that no longer need chasing">
      <bpmn:documentation>Stops repeat reminders once a letter has been completed or approved.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pathway.suppress-duplicate-reminders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_241</bpmn:incoming>
      <bpmn:outgoing>Flow_244</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="PCW_Throw_Reminder" name="Send the weekly reminder to the Consultant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.reminder" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-letter-reminder&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_244</bpmn:incoming>
      <bpmn:outgoing>Flow_245</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_086" messageRef="Message_letter_reminder" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PCW_End_Reminded" name="Reminder issued">
      <bpmn:incoming>Flow_245</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="PCW_Throw_EscalateManager" name="Escalate to the Administrative Manager">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.escalation-admin-manager" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-letter-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_242</bpmn:incoming>
      <bpmn:outgoing>Flow_246</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_087" messageRef="Message_letter_escalation_admin_manager" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PCW_End_EscalatedManager" name="Escalated to the Administrative Manager">
      <bpmn:incoming>Flow_246</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="PCW_Throw_EscalateHigher" name="Escalate beyond three months">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.escalation-higher-management" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-letter-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_243</bpmn:incoming>
      <bpmn:outgoing>Flow_247</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_088" messageRef="Message_letter_escalation_higher_management" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PCW_End_EscalatedHigher" name="Escalated to higher management">
      <bpmn:incoming>Flow_247</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="PCW_Start_LetterOverdue" name="Letter flagged as delayed">
      <bpmn:outgoing>Flow_248</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_089" messageRef="Message_letter_overdue_flagged" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="PCW_Auto_AddToMonitoring" name="Add the letter to pathway monitoring">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pathway.add-to-monitoring" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_248</bpmn:incoming>
      <bpmn:outgoing>Flow_249</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PCW_End_Monitoring" name="Letter added to the monitoring list">
      <bpmn:incoming>Flow_249</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="PCW_Start_BookingDelay" name="Booking delay flagged by a team">
      <bpmn:outgoing>Flow_250</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_090" messageRef="Message_booking_no_slot_escalation" />
    </bpmn:startEvent>
    <bpmn:startEvent id="PCW_Start_TreatmentPending" name="Treatment booking still pending">
      <bpmn:outgoing>Flow_251</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_091" messageRef="Message_treatment_booking_pending" />
    </bpmn:startEvent>
    <bpmn:startEvent id="PCW_Start_FollowUpDelay" name="Follow-up slot outside the clinical window">
      <bpmn:outgoing>Flow_252</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_092" messageRef="Message_follow_up_no_slot_escalation" />
    </bpmn:startEvent>
    <bpmn:userTask id="PCW_Task_ReviewDelay" name="Review the delay and agree the next step">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
        <zeebe:formDefinition formId="review-booking-delay" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_250</bpmn:incoming>
      <bpmn:incoming>Flow_251</bpmn:incoming>
      <bpmn:incoming>Flow_252</bpmn:incoming>
      <bpmn:incoming>Flow_260</bpmn:incoming>
      <bpmn:outgoing>Flow_253</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PCW_GW_DelayAction" name="What does the delay need?" default="Flow_255">
      <bpmn:incoming>Flow_253</bpmn:incoming>
      <bpmn:outgoing>Flow_254</bpmn:outgoing>
      <bpmn:outgoing>Flow_255</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="PCW_Throw_DelayToClinical" name="Ask the clinical team to reprioritise">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="pathway.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-pathway-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_254</bpmn:incoming>
      <bpmn:outgoing>Flow_256</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_093" messageRef="Message_pathway_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PCW_End_DelayWithClinical" name="Delay with the clinical team">
      <bpmn:incoming>Flow_256</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PCW_Auto_SendDelayLetter" name="Write to the patient about the delay">
      <bpmn:documentation>Same external correspondence service, called straight from the pathway team.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;patient&#34;]" target="letterRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_255</bpmn:incoming>
      <bpmn:outgoing>Flow_257</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PCW_End_PatientInformed" name="Patient informed">
      <bpmn:incoming>Flow_257</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SUB_Pathway_Report" name="Produce the weekly overdue correspondence list">
      <bpmn:documentation>Runs every week. Only the letters that still need chasing come out of here.</bpmn:documentation>
      <bpmn:incoming>Flow_258</bpmn:incoming>
      <bpmn:outgoing>Flow_259</bpmn:outgoing>
      <bpmn:startEvent id="SUB_Pathway_Report_Start">
        <bpmn:outgoing>SUB_Pathway_Report_f_S_Find</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SUB_Pathway_Report_Find" name="Find clinic letters that are overdue">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="pathway.find-overdue-letters" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Pathway_Report_f_S_Find</bpmn:incoming>
        <bpmn:outgoing>SUB_Pathway_Report_f_Find_Review</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SUB_Pathway_Report_Review" name="Review the outstanding correspondence list">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
          <zeebe:formDefinition formId="review-outstanding-correspondence" bindingType="deployment" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Pathway_Report_f_Find_Review</bpmn:incoming>
        <bpmn:outgoing>SUB_Pathway_Report_f_Review_E</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SUB_Pathway_Report_End">
        <bpmn:incoming>SUB_Pathway_Report_f_Review_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB_Pathway_Report_f_S_Find" sourceRef="SUB_Pathway_Report_Start" targetRef="SUB_Pathway_Report_Find" />
      <bpmn:sequenceFlow id="SUB_Pathway_Report_f_Find_Review" sourceRef="SUB_Pathway_Report_Find" targetRef="SUB_Pathway_Report_Review" />
      <bpmn:sequenceFlow id="SUB_Pathway_Report_f_Review_E" sourceRef="SUB_Pathway_Report_Review" targetRef="SUB_Pathway_Report_End" />
    </bpmn:subProcess>
    <bpmn:startEvent id="PCW_Start_FundingDelay" name="Funding delay flagged by the booking team">
      <bpmn:outgoing>Flow_260</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_094" messageRef="Message_funding_delay_flagged" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_258" sourceRef="PCW_Start_WeeklyReview" targetRef="SUB_Pathway_Report" />
    <bpmn:sequenceFlow id="Flow_259" sourceRef="SUB_Pathway_Report" targetRef="PCW_GW_OverdueBand" />
    <bpmn:sequenceFlow id="Flow_241" name="One week to one month" sourceRef="PCW_GW_OverdueBand" targetRef="PCW_Auto_SuppressDuplicates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=letterOverdueDays &lt;= 30</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_242" name="Over one month" sourceRef="PCW_GW_OverdueBand" targetRef="PCW_Throw_EscalateManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=letterOverdueDays &gt; 30 and letterOverdueDays &lt;= 90</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_243" name="Over three months" sourceRef="PCW_GW_OverdueBand" targetRef="PCW_Throw_EscalateHigher" />
    <bpmn:sequenceFlow id="Flow_244" sourceRef="PCW_Auto_SuppressDuplicates" targetRef="PCW_Throw_Reminder" />
    <bpmn:sequenceFlow id="Flow_245" sourceRef="PCW_Throw_Reminder" targetRef="PCW_End_Reminded" />
    <bpmn:sequenceFlow id="Flow_246" sourceRef="PCW_Throw_EscalateManager" targetRef="PCW_End_EscalatedManager" />
    <bpmn:sequenceFlow id="Flow_247" sourceRef="PCW_Throw_EscalateHigher" targetRef="PCW_End_EscalatedHigher" />
    <bpmn:sequenceFlow id="Flow_248" sourceRef="PCW_Start_LetterOverdue" targetRef="PCW_Auto_AddToMonitoring" />
    <bpmn:sequenceFlow id="Flow_249" sourceRef="PCW_Auto_AddToMonitoring" targetRef="PCW_End_Monitoring" />
    <bpmn:sequenceFlow id="Flow_250" sourceRef="PCW_Start_BookingDelay" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_251" sourceRef="PCW_Start_TreatmentPending" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_252" sourceRef="PCW_Start_FollowUpDelay" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_260" sourceRef="PCW_Start_FundingDelay" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_253" sourceRef="PCW_Task_ReviewDelay" targetRef="PCW_GW_DelayAction" />
    <bpmn:sequenceFlow id="Flow_254" name="Clinical reprioritisation" sourceRef="PCW_GW_DelayAction" targetRef="PCW_Throw_DelayToClinical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=delayAction = "CLINICAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_255" name="Keep the patient informed" sourceRef="PCW_GW_DelayAction" targetRef="PCW_Auto_SendDelayLetter" />
    <bpmn:sequenceFlow id="Flow_256" sourceRef="PCW_Throw_DelayToClinical" targetRef="PCW_End_DelayWithClinical" />
    <bpmn:sequenceFlow id="Flow_257" sourceRef="PCW_Auto_SendDelayLetter" targetRef="PCW_End_PatientInformed" />
  </bpmn:process>
  <bpmn:process id="call-handling" name="Call Handling Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="call-handling_lanes">
      <bpmn:lane id="call-handling_L1" name="Outbound contact">
        <bpmn:flowNodeRef>CALL_Start_PhoneContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Throw_ContactFinished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_CallHandling_Contact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="call-handling_L0" name="Enquiries">
        <bpmn:flowNodeRef>CALL_Start_Enquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Task_LogEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_GW_Category</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_GW_Urgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Throw_UrgentClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Throw_Clinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Throw_Finance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_GW_Answerable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Task_AnswerAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Throw_AdminTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Catch_EnquiryResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_Auto_CloseEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CALL_End_EnquiryResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CALL_Start_Enquiry" name="Enquiry received by the call handling team">
      <bpmn:outgoing>Flow_261</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_095" messageRef="Message_enquiry_received" />
    </bpmn:startEvent>
    <bpmn:userTask id="CALL_Task_LogEnquiry" name="Log the enquiry, classify it and set a priority">
      <bpmn:documentation>Every enquiry gets a record, a category and a priority. Clinical questions are flagged straight away even though the urgency rules are still being agreed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="call-handling" />
        <zeebe:formDefinition formId="log-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_261</bpmn:incoming>
      <bpmn:outgoing>Flow_262</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CALL_GW_Category" name="What kind of enquiry is this?" default="Flow_265">
      <bpmn:incoming>Flow_262</bpmn:incoming>
      <bpmn:outgoing>Flow_263</bpmn:outgoing>
      <bpmn:outgoing>Flow_264</bpmn:outgoing>
      <bpmn:outgoing>Flow_265</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CALL_GW_Urgent" name="Is this an urgent clinical concern?" default="Flow_267">
      <bpmn:incoming>Flow_263</bpmn:incoming>
      <bpmn:outgoing>Flow_266</bpmn:outgoing>
      <bpmn:outgoing>Flow_267</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CALL_Throw_UrgentClinical" name="Urgent concern to CNS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.assigned-clinical-urgent" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_266</bpmn:incoming>
      <bpmn:outgoing>Flow_268</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_096" messageRef="Message_enquiry_assigned_clinical_urgent" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CALL_Throw_Clinical" name="Send the enquiry to the nurse specialists">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.assigned-clinical" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_267</bpmn:incoming>
      <bpmn:outgoing>Flow_269</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_097" messageRef="Message_enquiry_assigned_clinical" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="CALL_Throw_Finance" name="Send the enquiry to the Finance Team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.assigned-finance" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_264</bpmn:incoming>
      <bpmn:outgoing>Flow_274</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_098" messageRef="Message_enquiry_assigned_finance" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="CALL_GW_Answerable" name="Can this be answered with the information available?" default="Flow_271">
      <bpmn:incoming>Flow_265</bpmn:incoming>
      <bpmn:outgoing>Flow_270</bpmn:outgoing>
      <bpmn:outgoing>Flow_271</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CALL_Task_AnswerAdmin" name="Answer the administrative question">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="call-handling" />
        <zeebe:formDefinition formId="answer-administrative-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_270</bpmn:incoming>
      <bpmn:outgoing>Flow_272</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="CALL_Throw_AdminTeam" name="Enquiry to admin team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.assigned-admin" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_271</bpmn:incoming>
      <bpmn:outgoing>Flow_273</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_099" messageRef="Message_enquiry_assigned_admin" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="CALL_Catch_EnquiryResolved" name="Enquiry resolved by the specialist team">
      <bpmn:incoming>Flow_268</bpmn:incoming>
      <bpmn:incoming>Flow_269</bpmn:incoming>
      <bpmn:incoming>Flow_272</bpmn:incoming>
      <bpmn:incoming>Flow_273</bpmn:incoming>
      <bpmn:incoming>Flow_274</bpmn:incoming>
      <bpmn:outgoing>Flow_275</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_100" messageRef="Message_enquiry_resolved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="CALL_Auto_CloseEnquiry" name="Close the enquiry record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enquiry.close-record" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_275</bpmn:incoming>
      <bpmn:outgoing>Flow_276</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CALL_End_EnquiryResolved" name="Enquiry resolved">
      <bpmn:incoming>Flow_276</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="CALL_Start_PhoneContact" name="Short notice call requested">
      <bpmn:outgoing>Flow_277</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_101" messageRef="Message_appointment_phone_contact_requested" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="CALL_Throw_ContactFinished" name="Contact finished">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="appointment.phone-contact-finished" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-phone-contact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_279</bpmn:incoming>
      <bpmn:outgoing>Flow_278</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_102" messageRef="Message_appointment_phone_contact_finished" />
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SUB_CallHandling_Contact" name="Contact the patient by telephone">
      <bpmn:documentation>Three attempts at most. Every attempt is recorded, including the wrong number and the patient who wants a different date.</bpmn:documentation>
      <bpmn:incoming>Flow_277</bpmn:incoming>
      <bpmn:incoming>Flow_278</bpmn:incoming>
      <bpmn:outgoing>Flow_279</bpmn:outgoing>
      <bpmn:startEvent id="SUB_CallHandling_Contact_Start">
        <bpmn:outgoing>SUB_CallHandling_Contact_f_S_Attempt</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SUB_CallHandling_Contact_Attempt" name="Attempt to telephone the patient">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
          <zeebe:formDefinition formId="record-telephone-contact-attempt" bindingType="deployment" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_CallHandling_Contact_f_S_Attempt</bpmn:incoming>
        <bpmn:incoming>SUB_CallHandling_Contact_f_Again_Attempt</bpmn:incoming>
        <bpmn:outgoing>SUB_CallHandling_Contact_f_Attempt_Log</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SUB_CallHandling_Contact_Log" name="Log the contact attempt">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="enquiry.record-contact-attempt" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_CallHandling_Contact_f_Attempt_Log</bpmn:incoming>
        <bpmn:outgoing>SUB_CallHandling_Contact_f_Log_Decide</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SUB_CallHandling_Contact_Again" name="Try another number or another time">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
          <zeebe:formDefinition formId="record-telephone-contact-attempt" bindingType="deployment" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_CallHandling_Contact_f_Decide_Again</bpmn:incoming>
        <bpmn:outgoing>SUB_CallHandling_Contact_f_Again_Attempt</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SUB_CallHandling_Contact_Decide" name="Did we reach the patient?" default="SUB_CallHandling_Contact_f_Decide_Again">
        <bpmn:incoming>SUB_CallHandling_Contact_f_Log_Decide</bpmn:incoming>
        <bpmn:outgoing>SUB_CallHandling_Contact_f_Decide_E</bpmn:outgoing>
        <bpmn:outgoing>SUB_CallHandling_Contact_f_Decide_Again</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SUB_CallHandling_Contact_End">
        <bpmn:incoming>SUB_CallHandling_Contact_f_Decide_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_S_Attempt" sourceRef="SUB_CallHandling_Contact_Start" targetRef="SUB_CallHandling_Contact_Attempt" />
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_Attempt_Log" sourceRef="SUB_CallHandling_Contact_Attempt" targetRef="SUB_CallHandling_Contact_Log" />
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_Log_Decide" sourceRef="SUB_CallHandling_Contact_Log" targetRef="SUB_CallHandling_Contact_Decide" />
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_Decide_E" sourceRef="SUB_CallHandling_Contact_Decide" targetRef="SUB_CallHandling_Contact_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=contactOutcome = "REACHED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_Decide_Again" sourceRef="SUB_CallHandling_Contact_Decide" targetRef="SUB_CallHandling_Contact_Again" />
      <bpmn:sequenceFlow id="SUB_CallHandling_Contact_f_Again_Attempt" sourceRef="SUB_CallHandling_Contact_Again" targetRef="SUB_CallHandling_Contact_Attempt" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_261" sourceRef="CALL_Start_Enquiry" targetRef="CALL_Task_LogEnquiry" />
    <bpmn:sequenceFlow id="Flow_262" sourceRef="CALL_Task_LogEnquiry" targetRef="CALL_GW_Category" />
    <bpmn:sequenceFlow id="Flow_263" name="Clinical" sourceRef="CALL_GW_Category" targetRef="CALL_GW_Urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryCategory = "CLINICAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_264" name="Financial" sourceRef="CALL_GW_Category" targetRef="CALL_Throw_Finance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryCategory = "FINANCIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_265" name="Administrative" sourceRef="CALL_GW_Category" targetRef="CALL_GW_Answerable" />
    <bpmn:sequenceFlow id="Flow_266" name="Urgent" sourceRef="CALL_GW_Urgent" targetRef="CALL_Throw_UrgentClinical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryPriority = "URGENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_267" name="Routine clinical" sourceRef="CALL_GW_Urgent" targetRef="CALL_Throw_Clinical" />
    <bpmn:sequenceFlow id="Flow_268" sourceRef="CALL_Throw_UrgentClinical" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_269" sourceRef="CALL_Throw_Clinical" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_274" sourceRef="CALL_Throw_Finance" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_270" name="Answered on the call" sourceRef="CALL_GW_Answerable" targetRef="CALL_Task_AnswerAdmin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=answerableNow = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_271" name="Needs another team" sourceRef="CALL_GW_Answerable" targetRef="CALL_Throw_AdminTeam" />
    <bpmn:sequenceFlow id="Flow_272" sourceRef="CALL_Task_AnswerAdmin" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_273" sourceRef="CALL_Throw_AdminTeam" targetRef="CALL_Catch_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_275" sourceRef="CALL_Catch_EnquiryResolved" targetRef="CALL_Auto_CloseEnquiry" />
    <bpmn:sequenceFlow id="Flow_276" sourceRef="CALL_Auto_CloseEnquiry" targetRef="CALL_End_EnquiryResolved" />
    <bpmn:sequenceFlow id="Flow_277" sourceRef="CALL_Start_PhoneContact" targetRef="SUB_CallHandling_Contact" />
    <bpmn:sequenceFlow id="Flow_279" sourceRef="SUB_CallHandling_Contact" targetRef="CALL_Throw_ContactFinished" />
    <bpmn:sequenceFlow id="Flow_278" sourceRef="CALL_Throw_ContactFinished" targetRef="SUB_CallHandling_Contact" />
  </bpmn:process>
  <bpmn:process id="clinical-nurse-specialists" name="Clinical Nurse Specialist Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="clinical-nurse-specialists_lanes">
      <bpmn:lane id="clinical-nurse-specialists_L0" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>CNS_Start_Enquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Start_UrgentEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Task_TriageEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_GW_NeedsConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Throw_ToConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Catch_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Auto_RecordAdvice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Throw_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_End_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Throw_UrgentEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_End_UrgentEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CNS_Bnd_UrgentOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CNS_Start_Enquiry" name="Clinical enquiry assigned">
      <bpmn:outgoing>Flow_280</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_103" messageRef="Message_enquiry_assigned_clinical" />
    </bpmn:startEvent>
    <bpmn:startEvent id="CNS_Start_UrgentEnquiry" name="Urgent clinical concern assigned">
      <bpmn:outgoing>Flow_281</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_104" messageRef="Message_enquiry_assigned_clinical_urgent" />
    </bpmn:startEvent>
    <bpmn:userTask id="CNS_Task_TriageEnquiry" name="Triage the enquiry and respond">
      <bpmn:documentation>Only a qualified clinical professional answers here. Call handlers never diagnose or interpret results.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialists" />
        <zeebe:formDefinition formId="triage-clinical-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_280</bpmn:incoming>
      <bpmn:incoming>Flow_281</bpmn:incoming>
      <bpmn:outgoing>Flow_282</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CNS_GW_NeedsConsultant" name="Does this need a Consultant?" default="Flow_284">
      <bpmn:incoming>Flow_282</bpmn:incoming>
      <bpmn:outgoing>Flow_283</bpmn:outgoing>
      <bpmn:outgoing>Flow_284</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="CNS_Throw_ToConsultant" name="Ask the Consultant for a clinical review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinical.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinical-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_283</bpmn:incoming>
      <bpmn:outgoing>Flow_285</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_105" messageRef="Message_clinical_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="CNS_Catch_ClinicalReview" name="Clinical review outcome">
      <bpmn:incoming>Flow_285</bpmn:incoming>
      <bpmn:outgoing>Flow_286</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_106" messageRef="Message_clinical_review_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="CNS_Auto_RecordAdvice" name="Record the advice given">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cns.record-clinical-advice" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_284</bpmn:incoming>
      <bpmn:incoming>Flow_286</bpmn:incoming>
      <bpmn:outgoing>Flow_287</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="CNS_Throw_Resolved" name="Enquiry resolved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_287</bpmn:incoming>
      <bpmn:outgoing>Flow_288</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_107" messageRef="Message_enquiry_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CNS_End_Resolved" name="Enquiry answered and closed">
      <bpmn:incoming>Flow_288</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CNS_Throw_UrgentEscalation" name="Escalate the unanswered urgent concern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.urgent-escalated" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_289</bpmn:incoming>
      <bpmn:outgoing>Flow_290</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_108" messageRef="Message_enquiry_urgent_escalated" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="CNS_End_UrgentEscalated" name="Urgent concern escalated">
      <bpmn:incoming>Flow_290</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="CNS_Bnd_UrgentOverdue" name="1 hour" cancelActivity="false" attachedToRef="CNS_Task_TriageEnquiry">
      <bpmn:outgoing>Flow_289</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_007">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_280" sourceRef="CNS_Start_Enquiry" targetRef="CNS_Task_TriageEnquiry" />
    <bpmn:sequenceFlow id="Flow_281" sourceRef="CNS_Start_UrgentEnquiry" targetRef="CNS_Task_TriageEnquiry" />
    <bpmn:sequenceFlow id="Flow_282" sourceRef="CNS_Task_TriageEnquiry" targetRef="CNS_GW_NeedsConsultant" />
    <bpmn:sequenceFlow id="Flow_283" name="Needs a Consultant" sourceRef="CNS_GW_NeedsConsultant" targetRef="CNS_Throw_ToConsultant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsConsultantReview = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_284" name="Answered directly" sourceRef="CNS_GW_NeedsConsultant" targetRef="CNS_Auto_RecordAdvice" />
    <bpmn:sequenceFlow id="Flow_285" sourceRef="CNS_Throw_ToConsultant" targetRef="CNS_Catch_ClinicalReview" />
    <bpmn:sequenceFlow id="Flow_286" sourceRef="CNS_Catch_ClinicalReview" targetRef="CNS_Auto_RecordAdvice" />
    <bpmn:sequenceFlow id="Flow_287" sourceRef="CNS_Auto_RecordAdvice" targetRef="CNS_Throw_Resolved" />
    <bpmn:sequenceFlow id="Flow_288" sourceRef="CNS_Throw_Resolved" targetRef="CNS_End_Resolved" />
    <bpmn:sequenceFlow id="Flow_289" sourceRef="CNS_Bnd_UrgentOverdue" targetRef="CNS_Throw_UrgentEscalation" />
    <bpmn:sequenceFlow id="Flow_290" sourceRef="CNS_Throw_UrgentEscalation" targetRef="CNS_End_UrgentEscalated" />
  </bpmn:process>
  <bpmn:process id="administrative-management" name="Administrative Management Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="administrative-management_lanes">
      <bpmn:lane id="administrative-management_L1" name="Higher management escalation">
        <bpmn:flowNodeRef>ADM_Start_HigherEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_Task_ReferHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_Throw_HigherRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_End_HigherRecorded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="administrative-management_L0" name="Manager escalation">
        <bpmn:flowNodeRef>ADM_Start_ManagerEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_Task_ContactConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_GW_ManagerOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_Throw_EscalationRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_End_Recorded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ADM_Start_ManagerEscalation" name="Overdue letter escalated to the manager">
      <bpmn:outgoing>Flow_291</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_109" messageRef="Message_letter_escalation_admin_manager" />
    </bpmn:startEvent>
    <bpmn:userTask id="ADM_Task_ContactConsultant" name="Contact the responsible Consultant">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
        <zeebe:formDefinition formId="contact-consultant-overdue-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_291</bpmn:incoming>
      <bpmn:outgoing>Flow_292</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ADM_GW_ManagerOutcome" name="Has the letter been completed?" default="Flow_294">
      <bpmn:incoming>Flow_292</bpmn:incoming>
      <bpmn:outgoing>Flow_293</bpmn:outgoing>
      <bpmn:outgoing>Flow_294</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="ADM_Throw_EscalationRecorded" name="Record the escalation outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.escalation-recorded" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-letter-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_293</bpmn:incoming>
      <bpmn:incoming>Flow_294</bpmn:incoming>
      <bpmn:outgoing>Flow_295</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_110" messageRef="Message_letter_escalation_recorded" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ADM_End_Recorded" name="Escalation recorded">
      <bpmn:incoming>Flow_295</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ADM_Start_HigherEscalation" name="Letter outstanding beyond three months">
      <bpmn:outgoing>Flow_296</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_111" messageRef="Message_letter_escalation_higher_management" />
    </bpmn:startEvent>
    <bpmn:userTask id="ADM_Task_ReferHigher" name="Refer the case to higher management">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
        <zeebe:formDefinition formId="refer-to-higher-management" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_296</bpmn:incoming>
      <bpmn:outgoing>Flow_297</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="ADM_Throw_HigherRecorded" name="Record the higher level escalation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.escalation-recorded" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-letter-escalation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_297</bpmn:incoming>
      <bpmn:outgoing>Flow_298</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_112" messageRef="Message_letter_escalation_recorded" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ADM_End_HigherRecorded" name="Higher management escalation recorded">
      <bpmn:incoming>Flow_298</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_291" sourceRef="ADM_Start_ManagerEscalation" targetRef="ADM_Task_ContactConsultant" />
    <bpmn:sequenceFlow id="Flow_292" sourceRef="ADM_Task_ContactConsultant" targetRef="ADM_GW_ManagerOutcome" />
    <bpmn:sequenceFlow id="Flow_293" name="Completed - close" sourceRef="ADM_GW_ManagerOutcome" targetRef="ADM_Throw_EscalationRecorded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=letterNowCompleted = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_294" name="Still outstanding" sourceRef="ADM_GW_ManagerOutcome" targetRef="ADM_Throw_EscalationRecorded" />
    <bpmn:sequenceFlow id="Flow_295" sourceRef="ADM_Throw_EscalationRecorded" targetRef="ADM_End_Recorded" />
    <bpmn:sequenceFlow id="Flow_296" sourceRef="ADM_Start_HigherEscalation" targetRef="ADM_Task_ReferHigher" />
    <bpmn:sequenceFlow id="Flow_297" sourceRef="ADM_Task_ReferHigher" targetRef="ADM_Throw_HigherRecorded" />
    <bpmn:sequenceFlow id="Flow_298" sourceRef="ADM_Throw_HigherRecorded" targetRef="ADM_End_HigherRecorded" />
  </bpmn:process>
