<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ClinicalService" name="Hospital Patient Administration System" processRef="Process_ClinicalService" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ClinicalService" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ReferralReceived" name="Referral received" />
    <bpmn:task id="Task_ValidateReferral" name="Validate referral documents" />
    <bpmn:exclusiveGateway id="Gateway_ReferralStatus" name="Referral complete?" />
    <bpmn:task id="Task_RequestAdditionalInfo" name="Request additional information" />
    <bpmn:task id="Task_ConsultantReview" name="Consultant clinical review" />
    <bpmn:exclusiveGateway id="Gateway_ConsultantDecision" name="Decision" />
    <bpmn:task id="Task_BookNewAppointment" name="Book new patient appointment" />
    <bpmn:task id="Task_AssessFunding" name="Assess funding and payment requirement" />
    <bpmn:task id="Task_CreateTreatmentRequest" name="Create authorised treatment request" />
    <bpmn:task id="Task_TreatmentBooking" name="Arrange treatment appointments" />
    <bpmn:endEvent id="EndEvent_Completed" name="Pathway continued" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ReferralReceived" targetRef="Task_ValidateReferral" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ValidateReferral" targetRef="Gateway_ReferralStatus" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_ReferralStatus" targetRef="Task_RequestAdditionalInfo" name="Additional information required" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_ReferralStatus" targetRef="Task_ConsultantReview" name="Ready for clinical review" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RequestAdditionalInfo" targetRef="Task_ValidateReferral" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ConsultantReview" targetRef="Gateway_ConsultantDecision" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_ConsultantDecision" targetRef="Task_BookNewAppointment" name="Accepted" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_ConsultantDecision" targetRef="EndEvent_Completed" name="Rejected or redirected" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_BookNewAppointment" targetRef="Task_AssessFunding" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_AssessFunding" targetRef="Task_CreateTreatmentRequest" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CreateTreatmentRequest" targetRef="Task_TreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_TreatmentBooking" targetRef="EndEvent_Completed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_ClinicalService_di" bpmnElement="Participant_ClinicalService" isHorizontal="true">
        <dc:Bounds x="160" y="90" width="980" height="400"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_ReferralReceived_di" bpmnElement="StartEvent_ReferralReceived">
        <dc:Bounds x="210" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateReferral_di" bpmnElement="Task_ValidateReferral">
        <dc:Bounds x="280" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReferralStatus_di" bpmnElement="Gateway_ReferralStatus">
        <dc:Bounds x="430" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RequestAdditionalInfo_di" bpmnElement="Task_RequestAdditionalInfo">
        <dc:Bounds x="520" y="100" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConsultantReview_di" bpmnElement="Task_ConsultantReview">
        <dc:Bounds x="520" y="260" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ConsultantDecision_di" bpmnElement="Gateway_ConsultantDecision">
        <dc:Bounds x="690" y="275" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BookNewAppointment_di" bpmnElement="Task_BookNewAppointment">
        <dc:Bounds x="780" y="260" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssessFunding_di" bpmnElement="Task_AssessFunding">
        <dc:Bounds x="930" y="260" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CreateTreatmentRequest_di" bpmnElement="Task_CreateTreatmentRequest">
        <dc:Bounds x="930" y="360" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TreatmentBooking_di" bpmnElement="Task_TreatmentBooking">
        <dc:Bounds x="780" y="360" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="700" y="420" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="246" y="218"/>
        <di:waypoint x="280" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="218"/>
        <di:waypoint x="430" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="455" y="195"/>
        <di:waypoint x="455" y="140"/>
        <di:waypoint x="520" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="480" y="220"/>
        <di:waypoint x="520" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="520" y="140"/>
        <di:waypoint x="330" y="140"/>
        <di:waypoint x="330" y="178"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="640" y="300"/>
        <di:waypoint x="690" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="740" y="300"/>
        <di:waypoint x="780" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="715" y="325"/>
        <di:waypoint x="715" y="420"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="900" y="300"/>
        <di:waypoint x="930" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="990" y="340"/>
        <di:waypoint x="990" y="360"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="930" y="400"/>
        <di:waypoint x="900" y="400"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="780" y="400"/>
        <di:waypoint x="736" y="400"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
