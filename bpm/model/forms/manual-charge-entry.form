{
  "components": [
    {
      "label": "Treatment being priced",
      "type": "textfield",
      "layout": {
        "row": "Row_144",
        "columns": null
      },
      "id": "Field_144",
      "key": "treatmentPlan",
      "validate": {
        "required": true,
        "maxLength": 120
      }
    },
    {
      "label": "Tariff code",
      "type": "textfield",
      "layout": {
        "row": "Row_145",
        "columns": null
      },
      "id": "Field_145",
      "key": "tariffCode",
      "validate": {
        "maxLength": 30
      }
    },
    {
      "label": "Charge amount",
      "type": "number",
      "layout": {
        "row": "Row_manual_amount",
        "columns": 6
      },
      "id": "Field_146",
      "key": "chargeAmount",
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "Currency",
      "type": "select",
      "layout": {
        "row": "Row_manual_amount",
        "columns": 6
      },
      "id": "Field_147",
      "key": "currency",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "GBP",
          "value": "GBP"
        },
        {
          "label": "EUR",
          "value": "EUR"
        },
        {
          "label": "USD",
          "value": "USD"
        }
      ]
    },
    {
      "label": "Why is this being priced manually?",
      "type": "textarea",
      "layout": {
        "row": "Row_148",
        "columns": null
      },
      "id": "Field_148",
      "key": "overrideReason",
      "validate": {
        "required": true
      },
      "properties": {
        "rows": 4
      }
    },
    {
      "label": "Priced by",
      "type": "textfield",
      "layout": {
        "row": "Row_149",
        "columns": null
      },
      "id": "Field_149",
      "key": "pricedBy",
      "validate": {
        "required": true,
        "maxLength": 80
      }
    }
  ],
  "type": "default",
  "id": "manual-charge-entry",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "description": "Fallback pricing when the automated tariff lookup cannot work out the charge."
}
