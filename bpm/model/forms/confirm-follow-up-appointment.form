{
  "components": [
    {
      "label": "Period requested by the clinical team",
      "type": "select",
      "layout": {
        "row": "Row_096",
        "columns": null
      },
      "id": "Field_096",
      "key": "requestedReviewPeriod",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "2 weeks",
          "value": "2 weeks"
        },
        {
          "label": "4 weeks",
          "value": "4 weeks"
        },
        {
          "label": "3 months",
          "value": "3 months"
        },
        {
          "label": "6 months",
          "value": "6 months"
        },
        {
          "label": "Other",
          "value": "Other"
        }
      ]
    },
    {
      "label": "Appointment date and time",
      "type": "datetime",
      "layout": {
        "row": "Row_097",
        "columns": null
      },
      "id": "Field_097",
      "key": "appointmentDateTime",
      "validate": {
        "required": true
      },
      "subtype": "datetime"
    },
    {
      "label": "Clinic location",
      "type": "textfield",
      "layout": {
        "row": "Row_098",
        "columns": null
      },
      "id": "Field_098",
      "key": "appointmentLocation",
      "validate": {
        "maxLength": 120
      }
    },
    {
      "label": "Is this inside the requested period?",
      "type": "radio",
      "layout": {
        "row": "Row_099",
        "columns": null
      },
      "id": "Field_099",
      "key": "withinRequestedPeriod",
      "description": "Answering no sends the case to the pathway team instead of booking it anyway.",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "true",
          "value": "true"
        },
        {
          "label": "false",
          "value": "false"
        }
      ]
    },
    {
      "label": "If not, why not?",
      "type": "textarea",
      "layout": {
        "row": "Row_100",
        "columns": null
      },
      "id": "Field_100",
      "key": "outsidePeriodReason",
      "properties": {
        "rows": 3
      }
    },
    {
      "label": "Confirmed by",
      "type": "textfield",
      "layout": {
        "row": "Row_101",
        "columns": null
      },
      "id": "Field_101",
      "key": "confirmedBy",
      "validate": {
        "required": true,
        "maxLength": 80
      }
    }
  ],
  "type": "default",
  "id": "confirm-follow-up-appointment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "description": "Follow-up bookings must land inside the period the clinical team asked for."
}
