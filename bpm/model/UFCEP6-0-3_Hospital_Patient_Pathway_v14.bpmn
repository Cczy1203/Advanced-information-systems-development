  <bpmn:error id="Error_REFERRAL_PACK_UNREADABLE" name="Referral documents could not be read" errorCode="REFERRAL_PACK_UNREADABLE" />
  <bpmn:error id="Error_REFERRAL_PACK_INCOMPLETE" name="Referral pack failed the document checklist" errorCode="REFERRAL_PACK_INCOMPLETE" />
  <bpmn:error id="Error_SCHEDULING_SERVICE_UNAVAILABLE" name="External scheduling service unavailable" errorCode="SCHEDULING_SERVICE_UNAVAILABLE" />
  <bpmn:error id="Error_CORRESPONDENCE_SERVICE_FAILED" name="External correspondence service rejected the job" errorCode="CORRESPONDENCE_SERVICE_FAILED" />
  <bpmn:error id="Error_PAYMENT_PROVIDER_UNAVAILABLE" name="External payment provider unavailable" errorCode="PAYMENT_PROVIDER_UNAVAILABLE" />
  <bpmn:error id="Error_PAYMENT_CONFIRMATION_LOST" name="Payment taken but no confirmation returned" errorCode="PAYMENT_CONFIRMATION_LOST" />
  <bpmn:error id="Error_EXTERNAL_RESOURCE_UNAVAILABLE" name="External treatment or diagnostic resource unavailable" errorCode="EXTERNAL_RESOURCE_UNAVAILABLE" />
  <bpmn:error id="Error_TREATMENT_REQUEST_UNAUTHORISED" name="Treatment booking request is not authorised" errorCode="TREATMENT_REQUEST_UNAUTHORISED" />
  <bpmn:error id="Error_CHARGE_CALCULATION_FAILED" name="Applicable charge could not be calculated" errorCode="CHARGE_CALCULATION_FAILED" />
  <bpmn:collaboration id="Collaboration_HospitalPatientPathway">
    <bpmn:participant id="P_MedicalSecretaries" name="Medical Secretaries" processRef="medical-secretaries" />
    <bpmn:participant id="P_Correspondence" name="External Correspondence Service" processRef="external-correspondence-service" />
    <bpmn:participant id="P_PaymentProvider" name="External Payment Service Provider" processRef="external-payment-service" />
    <bpmn:participant id="P_Finance" name="Finance Team" processRef="finance-team" />
    <bpmn:participant id="P_ExternalClinicalServices" name="External Treatment, Laboratory and Imaging Services" processRef="external-clinical-services" />
    <bpmn:participant id="P_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team" processRef="treatment-bookings" />
    <bpmn:participant id="P_Consultants" name="Consultants" processRef="consultants" />
    <bpmn:participant id="P_OutpatientBookings" name="Outpatient Bookings Team" processRef="outpatient-bookings" />
    <bpmn:participant id="P_ExternalScheduling" name="External Scheduling Service" processRef="external-scheduling-service" />
    <bpmn:participant id="P_Patient" name="Patient or authorised representative" processRef="patient-representative" />
    <bpmn:participant id="P_ClinicalNurseSpecialist" name="Clinical Nurse Specialist Team" processRef="clinical-nurse-specialists" />
    <bpmn:participant id="P_CallHandling" name="Call Handling Team" processRef="call-handling" />
    <bpmn:participant id="P_PathwayCoordinators" name="Patient Pathway Coordinators" processRef="patient-pathway-coordinators" />
    <bpmn:participant id="P_AdministrativeManagement" name="Administrative Management Team" processRef="administrative-management" />
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="SUB_Secretaries_Dispatch" targetRef="COR_Start_Dispatch" />
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="CON_Throw_Rejected" targetRef="SEC_Start_Outcome" />
    <bpmn:messageFlow id="MessageFlow_05" sourceRef="P_Patient" targetRef="CON_Start_AppointmentAttended" />
    <bpmn:messageFlow id="MessageFlow_06" sourceRef="OUT_Throw_NoSlotEscalation" targetRef="PCW_Start_BookingDelay" />
    <bpmn:messageFlow id="MessageFlow_07" sourceRef="OUT_Throw_FinanceReview" targetRef="FIN_Start_Refund" />
    <bpmn:messageFlow id="MessageFlow_08" sourceRef="TRT_Throw_PaymentUnresolved" targetRef="P_Finance" />
    <bpmn:messageFlow id="MessageFlow_09" sourceRef="FIN_Throw_RefundDelayed" targetRef="P_Patient" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="CNS_Throw_UrgentEscalation" targetRef="P_PathwayCoordinators" />
    <bpmn:messageFlow id="MessageFlow_11" sourceRef="CALL_Throw_UrgentClinical" targetRef="CNS_Start_UrgentEnquiry" />
    <bpmn:messageFlow id="MessageFlow_12" sourceRef="P_Patient" targetRef="CALL_Start_Enquiry" />
    <bpmn:messageFlow id="MessageFlow_13" sourceRef="PCW_Throw_Reminder" targetRef="CON_Bnd_LetterReminder" />
    <bpmn:messageFlow id="MessageFlow_14" sourceRef="PCW_Throw_EscalateManager" targetRef="ADM_Start_ManagerEscalation" />
    <bpmn:messageFlow id="MessageFlow_15" sourceRef="TRT_Throw_FundingDelay" targetRef="PCW_Start_FundingDelay" />
    <bpmn:messageFlow id="MessageFlow_16" sourceRef="OUT_Auto_FindSlots" targetRef="SCH_Start_SlotSearch" />
    <bpmn:messageFlow id="MessageFlow_17" sourceRef="SCH_Throw_SlotsReturned" targetRef="P_OutpatientBookings" />
    <bpmn:messageFlow id="MessageFlow_18" sourceRef="COR_Throw_Result" targetRef="P_MedicalSecretaries" />
    <bpmn:messageFlow id="MessageFlow_19" sourceRef="TRT_Auto_ProcessPayment" targetRef="PAY_Start_Transaction" />
    <bpmn:messageFlow id="MessageFlow_20" sourceRef="PAY_Throw_Result" targetRef="P_TreatmentBookings" />
    <bpmn:messageFlow id="MessageFlow_21" sourceRef="TRT_Auto_CheckExternalResources" targetRef="EXT_Start_CapacityCheck" />
    <bpmn:messageFlow id="MessageFlow_22" sourceRef="EXT_Throw_Capacity" targetRef="P_TreatmentBookings" />
    <bpmn:textAnnotation id="Note_SEC_1">
      <bpmn:text>Check referral pack against the document checklist - Secretaries check the pack and chase what is missing. They never record a view on whether the referral is clinically suitable.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_SEC_2">
      <bpmn:text>Is the referral pack complete? - Nothing reaches a clinician without a complete pack, and nothing reaches a patient without an authorised clinical decision behind it.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_FIN_1">
      <bpmn:text>Decide whether a refund is due - Finance decides funding and refunds. Clinical staff may explain a treatment decision but cannot approve money.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_1">
      <bpmn:text>Check the request is complete and authorised - A request without a named authorising clinician is turned away before anything is booked.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_2">
      <bpmn:text>What did the provider report? - Money never leaves the patient's account twice. A repeated attempt gets a new reference, and a duplicate report stops the booking.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_TRT_3">
      <bpmn:text>Release the provisional appointment series - Compensation. If external capacity never arrives, the provisional series is released instead of being left held.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_CON_1">
      <bpmn:text>What is the clinical decision? - Accept, reject, redirect or ask for more clinical detail. The reason and the deciding clinician are recorded and cannot be edited afterwards.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_CON_2">
      <bpmn:text>Draft and approve the clinic letter - The seven day letter target runs from the appointment, not from when drafting starts.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PCW_1">
      <bpmn:text>How far overdue is the letter? - Seven days, one month and three months are the three escalation points for an outstanding clinic letter.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="medical-secretaries" name="Medical Secretaries" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="medical-secretaries_lanes">
      <bpmn:lane id="medical-secretaries_L0" name="Referral intake and correspondence">
        <bpmn:flowNodeRef>SEC_Task_CheckPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Auto_ValidateDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_GW_PackComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_ReviewRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_ReviewRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_InfoRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_EGW_InfoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Catch_InfoReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Catch_InfoTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_InfoNotReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Task_NotifyReferrer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_OutcomeToReferrer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_OutcomeRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Task_ProcessLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_GW_LetterCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Throw_ClinicalError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_LetterReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_End_LetterFiled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_Secretaries_Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Bnd_PackIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Bnd_DocumentsUnreadable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Start_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Start_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEC_Start_LetterApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="SEC_Task_CheckPack" name="Check referral pack against the document checklist">
      <bpmn:documentation>Captures what was received and what is missing. The task never records a view on whether the referral is clinically appropriate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="check-referral-pack" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SEC_Auto_ValidateDocuments" name="Validate supporting documents and flag missing items">
      <bpmn:documentation>Reads the document list, matches it against the speciality checklist and returns referralPackComplete plus the missingDocuments collection.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.check-supporting-documents" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SEC_GW_PackComplete" name="Is the referral pack complete?" default="Flow_007">
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="SEC_Throw_ReviewRequested" name="Referral to Consultant">
      <bpmn:documentation>Only an authorised Consultant may accept or reject a referral, so the pack is handed over without any administrative recommendation attached.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.review-requested" />
          <zeebe:header key="businessEvent" value="REFERRAL_READY_FOR_REVIEW" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-review&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_003" messageRef="Message_referral_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_ReviewRequested" name="Referral awaiting clinical decision">
      <bpmn:incoming>Flow_008</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="SEC_Throw_InfoRequested" name="Request the missing information">
      <bpmn:documentation>Reached from the completeness gateway and from the unreadable-document error boundary, so a corrupted upload follows the same route as a missing document.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.info-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-info&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_004" messageRef="Message_referral_info_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="SEC_EGW_InfoRequest" name="Waiting for the missing information">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoReceived" name="Information received">
      <bpmn:documentation>The referral stays open for 14 days. If nothing arrives the referral is closed rather than left in limbo.</bpmn:documentation>
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_005" messageRef="Message_referral_info_received" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoTimeout" name="No response after 14 days">
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_001">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="SEC_End_InfoNotReceived" name="Referral closed - information not received">
      <bpmn:incoming>Flow_013</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="SEC_Task_NotifyReferrer" name="Record the decision and notify the referring organisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="notify-referrer-outcome" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="SEC_Throw_OutcomeToReferrer" name="Outcome to the referrer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-sent" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-referral-outcome&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_007" messageRef="Message_referral_outcome_sent" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_OutcomeRecorded" name="Outcome recorded and referrer informed">
      <bpmn:incoming>Flow_018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="SEC_Task_ProcessLetter" name="Check and process the approved clinic letter">
      <bpmn:documentation>Administrative checks only. Formatting and administrative errors may be corrected; the clinical meaning must not be altered.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="process-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SEC_GW_LetterCheck" name="Does the letter need a clinical correction?" default="Flow_023">
      <bpmn:incoming>Flow_020</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="SEC_Throw_ClinicalError" name="Return the letter to the Consultant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="letter.clinical-error-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_009" messageRef="Message_letter_clinical_error_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SEC_End_LetterReturned" name="Returned for amendment">
      <bpmn:incoming>Flow_022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SEC_End_LetterFiled" name="Letter filed with distribution evidence">
      <bpmn:incoming>Flow_024</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SUB_Secretaries_Dispatch" name="Dispatch the clinic letter">
      <bpmn:documentation>Contained so the main line stays readable. The steps inside are ordinary tasks and use the same forms as before.</bpmn:documentation>
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
      <bpmn:startEvent id="SUB_Secretaries_Dispatch_Start" name="Dispatch the clinic letter - start">
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_S_Prepare</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SUB_Secretaries_Dispatch_Prepare" name="Prepare the letter for distribution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="correspondence.prepare-dispatch" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_S_Prepare</bpmn:incoming>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Chase_Prepare</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Prepare_Send</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SUB_Secretaries_Dispatch_Send" name="Send the letter through the correspondence service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Prepare_Send</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Send_Decide</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SUB_Secretaries_Dispatch_Decide" name="Did the service accept the letter?" default="SUB_Secretaries_Dispatch_f_Decide_Chase">
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Send_Decide</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Decide_E</bpmn:outgoing>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Decide_Chase</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SUB_Secretaries_Dispatch_Chase" name="Resolve the distribution problem and pick another channel">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
          <zeebe:formDefinition formId="resolve-dispatch-problem" bindingType="deployment" />
        </bpmn:extensionElements>
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Decide_Chase</bpmn:incoming>
        <bpmn:outgoing>SUB_Secretaries_Dispatch_f_Chase_Prepare</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SUB_Secretaries_Dispatch_End" name="Dispatch the clinic letter - end">
        <bpmn:incoming>SUB_Secretaries_Dispatch_f_Decide_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_S_Prepare" sourceRef="SUB_Secretaries_Dispatch_Start" targetRef="SUB_Secretaries_Dispatch_Prepare" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Prepare_Send" sourceRef="SUB_Secretaries_Dispatch_Prepare" targetRef="SUB_Secretaries_Dispatch_Send" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Send_Decide" sourceRef="SUB_Secretaries_Dispatch_Send" targetRef="SUB_Secretaries_Dispatch_Decide" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Decide_E" name="dispatchStatus = &#34;SENT&#34;" sourceRef="SUB_Secretaries_Dispatch_Decide" targetRef="SUB_Secretaries_Dispatch_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=dispatchStatus = "SENT"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Decide_Chase" sourceRef="SUB_Secretaries_Dispatch_Decide" targetRef="SUB_Secretaries_Dispatch_Chase" />
      <bpmn:sequenceFlow id="SUB_Secretaries_Dispatch_f_Chase_Prepare" sourceRef="SUB_Secretaries_Dispatch_Chase" targetRef="SUB_Secretaries_Dispatch_Prepare" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SEC_Bnd_PackIncomplete" name="Incomplete" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_002" errorRef="Error_REFERRAL_PACK_INCOMPLETE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="SEC_Bnd_DocumentsUnreadable" name="Unreadable" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_001" errorRef="Error_REFERRAL_PACK_UNREADABLE" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_003" sourceRef="SEC_Start_Referral" targetRef="SEC_Task_CheckPack" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="SEC_Catch_InfoReceived" targetRef="SEC_Task_CheckPack" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="SEC_Task_CheckPack" targetRef="SEC_Auto_ValidateDocuments" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="SEC_Auto_ValidateDocuments" targetRef="SEC_GW_PackComplete" />
    <bpmn:sequenceFlow id="Flow_006" name="All expected documents present" sourceRef="SEC_GW_PackComplete" targetRef="SEC_Throw_ReviewRequested">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralPackComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_007" name="Something is missing" sourceRef="SEC_GW_PackComplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="SEC_Throw_ReviewRequested" targetRef="SEC_End_ReviewRequested" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="SEC_Bnd_DocumentsUnreadable" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="SEC_Bnd_PackIncomplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_009" sourceRef="SEC_Throw_InfoRequested" targetRef="SEC_EGW_InfoRequest" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoReceived" />
    <bpmn:sequenceFlow id="Flow_011" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoTimeout" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="SEC_Catch_InfoTimeout" targetRef="SEC_End_InfoNotReceived" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="SEC_Start_Outcome" targetRef="SEC_Task_NotifyReferrer" />
    <bpmn:sequenceFlow id="Flow_017" sourceRef="SEC_Task_NotifyReferrer" targetRef="SEC_Throw_OutcomeToReferrer" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="SEC_Throw_OutcomeToReferrer" targetRef="SEC_End_OutcomeRecorded" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="SEC_Start_LetterApproved" targetRef="SEC_Task_ProcessLetter" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="SEC_Task_ProcessLetter" targetRef="SEC_GW_LetterCheck" />
    <bpmn:sequenceFlow id="Flow_021" name="Suspected clinical error" sourceRef="SEC_GW_LetterCheck" targetRef="SEC_Throw_ClinicalError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalErrorSuspected = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_023" name="Administrative checks passed" sourceRef="SEC_GW_LetterCheck" targetRef="SUB_Secretaries_Dispatch" />
    <bpmn:sequenceFlow id="Flow_022" sourceRef="SEC_Throw_ClinicalError" targetRef="SEC_End_LetterReturned" />
    <bpmn:sequenceFlow id="Flow_024" sourceRef="SUB_Secretaries_Dispatch" targetRef="SEC_End_LetterFiled" />
    <bpmn:startEvent id="SEC_Start_Referral">
      <bpmn:documentation>Triggered by the referring organisation. Medical Secretaries own intake only; they must not judge clinical suitability.</bpmn:documentation>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="SEC_Start_Outcome" name="Referral outcome returned by the Consultant">
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_006" messageRef="Message_referral_outcome_returned" />
    </bpmn:startEvent>
    <bpmn:startEvent id="SEC_Start_LetterApproved" name="Clinic letter approved by the Consultant">
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_008" messageRef="Message_clinic_letter_approved" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="external-correspondence-service" name="External Correspondence Service" isExecutable="false">
    <bpmn:documentation>The supplier that prints and posts the letters. It reports back whether the job was accepted; the hospital's own service task raises CORRESPONDENCE_SERVICE_FAILED when it is not, and the secretaries then pick another channel.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="external-correspondence-service_lanes">
      <bpmn:lane id="external-correspondence-service_L0" name="Letter production and dispatch">
        <bpmn:flowNodeRef>COR_Task_Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>COR_Throw_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>COR_End_Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>COR_Start_Dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="COR_Task_Dispatch" name="Print and dispatch the letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if dispatchRecipients = null then (if letterRecipients = null then [&#34;patient&#34;, &#34;referring-organisation&#34;] else letterRecipients) else dispatchRecipients" target="dispatchRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_025</bpmn:incoming>
      <bpmn:outgoing>Flow_026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="COR_Throw_Result" name="Return the dispatch result">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="correspondence.dispatch-completed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-dispatch&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_026</bpmn:incoming>
      <bpmn:outgoing>Flow_027</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_011" messageRef="Message_correspondence_dispatch_completed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="COR_End_Dispatch" name="Dispatch result returned">
      <bpmn:incoming>Flow_027</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_025" sourceRef="COR_Start_Dispatch" targetRef="COR_Task_Dispatch" />
    <bpmn:sequenceFlow id="Flow_026" sourceRef="COR_Task_Dispatch" targetRef="COR_Throw_Result" />
    <bpmn:sequenceFlow id="Flow_027" sourceRef="COR_Throw_Result" targetRef="COR_End_Dispatch" />
    <bpmn:startEvent id="COR_Start_Dispatch" name="Letter received for distribution">
      <bpmn:outgoing>Flow_025</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_010" messageRef="Message_correspondence_dispatch_requested" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="external-payment-service" name="External Payment Service Provider" isExecutable="false">
    <bpmn:documentation>The supplier that takes the money. It processes the card transaction and returns the status, the transaction reference, the date and the amount - never the card details. Refunds use the same provider through payment.process-refund on the hospital side.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="external-payment-service_lanes">
      <bpmn:lane id="external-payment-service_L0" name="Card transactions and refunds">
        <bpmn:flowNodeRef>PAY_Task_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PAY_Throw_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PAY_End_Transaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PAY_Start_Transaction</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="PAY_Task_Process" name="Process the card transaction and report the outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-transaction" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if paymentReference = null then &#34;SIMULATED-PAYMENT-REFERENCE&#34; else paymentReference" target="paymentReference" />
          <zeebe:input source="=if chargeAmount = null then 125.0 else chargeAmount" target="chargeAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_028</bpmn:incoming>
      <bpmn:outgoing>Flow_029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="PAY_Throw_Result" name="Return the payment status and reference">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.transaction-result" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_029</bpmn:incoming>
      <bpmn:outgoing>Flow_030</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_013" messageRef="Message_payment_transaction_result" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="PAY_End_Transaction" name="Payment result returned">
      <bpmn:incoming>Flow_030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_028" sourceRef="PAY_Start_Transaction" targetRef="PAY_Task_Process" />
    <bpmn:sequenceFlow id="Flow_029" sourceRef="PAY_Task_Process" targetRef="PAY_Throw_Result" />
    <bpmn:sequenceFlow id="Flow_030" sourceRef="PAY_Throw_Result" targetRef="PAY_End_Transaction" />
    <bpmn:startEvent id="PAY_Start_Transaction" name="Secure payment request received">
      <bpmn:outgoing>Flow_028</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_012" messageRef="Message_payment_transaction_requested" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="finance-team" name="Finance Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="finance-team_lanes">
      <bpmn:lane id="finance-team_L1" name="Refunds, impact and enquiries">
        <bpmn:flowNodeRef>FIN_Task_DecideRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_AuditRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_RefundDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_PrepareRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_ProcessRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_RefundStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_RefundRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_RefundDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_RefundPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordNoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_NoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_NoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ReviewImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_ImpactAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_FinanceOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_ImpactReviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_AnswerEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_EnquiryAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Bnd_RefundFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_ImpactReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_Enquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance-team_L0" name="Funding, charges and payments">
        <bpmn:flowNodeRef>FIN_Task_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_AuditFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_FundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_FundingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_FundingDecided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_CalculateCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ManualCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_ChasePreAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Task_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_GW_InvestigationOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Auto_RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Throw_InvestigationResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_End_InvestigationClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Bnd_ChargeFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_FundingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_Start_PaymentInvestigation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="FIN_Task_DetermineFunding" name="Determine the funding route and record the approval">
      <bpmn:documentation>Records the responsible organisation, the authorisation reference, the approved amount and any limits attached to the approval.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="determine-funding-route" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_031</bpmn:incoming>
      <bpmn:outgoing>Flow_032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_AuditFunding" name="Record the funding decision for audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_032</bpmn:incoming>
      <bpmn:outgoing>Flow_033</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_FundingRoute" name="Which funding route applies?" default="Flow_036">
      <bpmn:incoming>Flow_033</bpmn:incoming>
      <bpmn:outgoing>Flow_034</bpmn:outgoing>
      <bpmn:outgoing>Flow_035</bpmn:outgoing>
      <bpmn:outgoing>Flow_036</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordApproval" name="Record the funding approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-funding-approval" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_034</bpmn:incoming>
      <bpmn:incoming>Flow_039</bpmn:incoming>
      <bpmn:outgoing>Flow_037</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_FundingDecision" name="Return the funding decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.decision-received" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_037</bpmn:incoming>
      <bpmn:incoming>Flow_038</bpmn:incoming>
      <bpmn:incoming>Flow_041</bpmn:incoming>
      <bpmn:outgoing>Flow_042</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_015" messageRef="Message_funding_decision_received" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_FundingDecided" name="Funding decision returned">
      <bpmn:incoming>Flow_042</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_Auto_CalculateCharge" name="Work out the charge payable">
      <bpmn:documentation>Applies the tariff for the treatment plus the patient's funding category. Returns the amount only - never any card data.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.calculate-charge" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_035</bpmn:incoming>
      <bpmn:outgoing>Flow_038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="FIN_Task_ManualCharge" name="Price the treatment manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="manual-charge-entry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_040</bpmn:incoming>
      <bpmn:outgoing>Flow_041</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FIN_Task_ChasePreAuthorisation" name="Chase the insurer for pre-authorisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="chase-pre-authorisation" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_036</bpmn:incoming>
      <bpmn:outgoing>Flow_039</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FIN_Task_InvestigatePayment" name="Investigate the unconfirmed payment">
      <bpmn:documentation>Reconciles the provider's transaction list against the booking before anyone asks the patient for money again.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="investigate-unconfirmed-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_043</bpmn:incoming>
      <bpmn:outgoing>Flow_044</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FIN_GW_InvestigationOutcome" name="Was the money actually taken?" default="Flow_046">
      <bpmn:incoming>Flow_044</bpmn:incoming>
      <bpmn:outgoing>Flow_045</bpmn:outgoing>
      <bpmn:outgoing>Flow_046</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordPayment" name="Record the payment against the account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-payment-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_045</bpmn:incoming>
      <bpmn:outgoing>Flow_047</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_InvestigationResolved" name="Investigation closed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.investigation-resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-investigation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_046</bpmn:incoming>
      <bpmn:incoming>Flow_047</bpmn:incoming>
      <bpmn:outgoing>Flow_048</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_017" messageRef="Message_payment_investigation_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_InvestigationClosed" name="Investigation closed">
      <bpmn:incoming>Flow_048</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="FIN_Task_DecideRefund" name="Decide whether a refund is due">
      <bpmn:documentation>Clinical staff may describe the treatment decision but only Finance, holding the right financial authority, approves a refund.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="decide-refund" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_049</bpmn:incoming>
      <bpmn:outgoing>Flow_050</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_AuditRefund" name="Record the refund decision for audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_050</bpmn:incoming>
      <bpmn:outgoing>Flow_051</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_RefundDecision" name="What did Finance decide?" default="Flow_053">
      <bpmn:incoming>Flow_051</bpmn:incoming>
      <bpmn:outgoing>Flow_052</bpmn:outgoing>
      <bpmn:outgoing>Flow_053</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_PrepareRefund" name="Prepare the approved refund">
      <bpmn:documentation>Checks the refund against the original transaction so the patient is never refunded more than was taken.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.prepare-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_052</bpmn:incoming>
      <bpmn:outgoing>Flow_054</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_Auto_ProcessRefund" name="Send the refund to the payment provider">
      <bpmn:documentation>Outbound call to the external payment provider. Only the refund status and amount come back to the hospital.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_054</bpmn:incoming>
      <bpmn:outgoing>Flow_055</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_RefundStatus" name="Did the provider accept the refund?" default="Flow_058">
      <bpmn:incoming>Flow_055</bpmn:incoming>
      <bpmn:outgoing>Flow_057</bpmn:outgoing>
      <bpmn:outgoing>Flow_058</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordRefund" name="Record the refund against the patient account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_057</bpmn:incoming>
      <bpmn:outgoing>Flow_059</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FIN_End_RefundRecorded" name="Refund recorded">
      <bpmn:incoming>Flow_059</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="FIN_Throw_RefundDelayed" name="Tell the patient the refund is delayed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="refund.delayed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-refund&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_056</bpmn:incoming>
      <bpmn:incoming>Flow_058</bpmn:incoming>
      <bpmn:outgoing>Flow_060</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_019" messageRef="Message_refund_delayed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_RefundPending" name="Refund still with the provider">
      <bpmn:incoming>Flow_060</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_Auto_RecordNoRefund" name="Record that no refund is due">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_053</bpmn:incoming>
      <bpmn:outgoing>Flow_061</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_NoRefund" name="Tell the patient no refund is due">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="refund.declined" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-refund&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_061</bpmn:incoming>
      <bpmn:outgoing>Flow_062</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_020" messageRef="Message_refund_declined" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_NoRefund" name="No refund - decision recorded">
      <bpmn:incoming>Flow_062</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="FIN_Task_ReviewImpact" name="Review the financial impact of the treatment change">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="review-financial-impact" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_063</bpmn:incoming>
      <bpmn:outgoing>Flow_064</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FIN_GW_ImpactAction" name="What does the change require?" default="Flow_066">
      <bpmn:incoming>Flow_064</bpmn:incoming>
      <bpmn:outgoing>Flow_065</bpmn:outgoing>
      <bpmn:outgoing>Flow_066</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="FIN_Throw_FinanceOutcome" name="Record the financial outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="finance.impact-resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-finance-impact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_065</bpmn:incoming>
      <bpmn:incoming>Flow_066</bpmn:incoming>
      <bpmn:outgoing>Flow_067</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_022" messageRef="Message_finance_impact_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_ImpactReviewed" name="Financial impact resolved">
      <bpmn:incoming>Flow_067</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="FIN_Task_AnswerEnquiry" name="Answer the payment or funding enquiry">
      <bpmn:documentation>Call handlers only answer from authorised information. Anything else comes here.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="answer-financial-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_068</bpmn:incoming>
      <bpmn:outgoing>Flow_069</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="FIN_Throw_EnquiryAnswered" name="Enquiry answered">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.resolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-enquiry&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_069</bpmn:incoming>
      <bpmn:outgoing>Flow_070</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_024" messageRef="Message_enquiry_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="FIN_End_EnquiryAnswered" name="Enquiry answered">
      <bpmn:incoming>Flow_070</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="FIN_Bnd_RefundFailed" name="Rejected" attachedToRef="FIN_Auto_ProcessRefund">
      <bpmn:outgoing>Flow_056</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_004" errorRef="Error_PAYMENT_PROVIDER_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="FIN_Bnd_ChargeFailed" name="Pricing failed" attachedToRef="FIN_Auto_CalculateCharge">
      <bpmn:outgoing>Flow_040</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_003" errorRef="Error_CHARGE_CALCULATION_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_031" sourceRef="FIN_Start_FundingCheck" targetRef="FIN_Task_DetermineFunding" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="FIN_Task_DetermineFunding" targetRef="FIN_Auto_AuditFunding" />
    <bpmn:sequenceFlow id="Flow_033" sourceRef="FIN_Auto_AuditFunding" targetRef="FIN_GW_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_034" name="Approved or exempt" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "HOSPITAL_FUNDED" or fundingRoute = "INSURER_APPROVED" or fundingRoute = "EXEMPTION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_035" name="Patient pays" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_CalculateCharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "PATIENT_PAYS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_036" name="Pre-authorisation outstanding" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Task_ChasePreAuthorisation" />
    <bpmn:sequenceFlow id="Flow_039" sourceRef="FIN_Task_ChasePreAuthorisation" targetRef="FIN_Auto_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_037" sourceRef="FIN_Auto_RecordApproval" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_038" sourceRef="FIN_Auto_CalculateCharge" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_041" sourceRef="FIN_Task_ManualCharge" targetRef="FIN_Throw_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_042" sourceRef="FIN_Throw_FundingDecision" targetRef="FIN_End_FundingDecided" />
    <bpmn:sequenceFlow id="Flow_040" sourceRef="FIN_Bnd_ChargeFailed" targetRef="FIN_Task_ManualCharge" />
    <bpmn:sequenceFlow id="Flow_043" sourceRef="FIN_Start_PaymentInvestigation" targetRef="FIN_Task_InvestigatePayment" />
    <bpmn:sequenceFlow id="Flow_044" sourceRef="FIN_Task_InvestigatePayment" targetRef="FIN_GW_InvestigationOutcome" />
    <bpmn:sequenceFlow id="Flow_045" name="Payment located" sourceRef="FIN_GW_InvestigationOutcome" targetRef="FIN_Auto_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentFound = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_046" name="Nothing was taken" sourceRef="FIN_GW_InvestigationOutcome" targetRef="FIN_Throw_InvestigationResolved" />
    <bpmn:sequenceFlow id="Flow_047" sourceRef="FIN_Auto_RecordPayment" targetRef="FIN_Throw_InvestigationResolved" />
    <bpmn:sequenceFlow id="Flow_048" sourceRef="FIN_Throw_InvestigationResolved" targetRef="FIN_End_InvestigationClosed" />
    <bpmn:sequenceFlow id="Flow_049" sourceRef="FIN_Start_Refund" targetRef="FIN_Task_DecideRefund" />
    <bpmn:sequenceFlow id="Flow_050" sourceRef="FIN_Task_DecideRefund" targetRef="FIN_Auto_AuditRefund" />
    <bpmn:sequenceFlow id="Flow_051" sourceRef="FIN_Auto_AuditRefund" targetRef="FIN_GW_RefundDecision" />
    <bpmn:sequenceFlow id="Flow_052" name="Refund approved" sourceRef="FIN_GW_RefundDecision" targetRef="FIN_Auto_PrepareRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundDecision = "FULL_REFUND" or refundDecision = "PARTIAL_REFUND"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_053" name="No refund due" sourceRef="FIN_GW_RefundDecision" targetRef="FIN_Auto_RecordNoRefund" />
    <bpmn:sequenceFlow id="Flow_054" sourceRef="FIN_Auto_PrepareRefund" targetRef="FIN_Auto_ProcessRefund" />
    <bpmn:sequenceFlow id="Flow_055" sourceRef="FIN_Auto_ProcessRefund" targetRef="FIN_GW_RefundStatus" />
    <bpmn:sequenceFlow id="Flow_057" name="Refunded" sourceRef="FIN_GW_RefundStatus" targetRef="FIN_Auto_RecordRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundStatus = "REFUNDED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_058" name="Not accepted yet" sourceRef="FIN_GW_RefundStatus" targetRef="FIN_Throw_RefundDelayed" />
    <bpmn:sequenceFlow id="Flow_059" sourceRef="FIN_Auto_RecordRefund" targetRef="FIN_End_RefundRecorded" />
    <bpmn:sequenceFlow id="Flow_056" sourceRef="FIN_Bnd_RefundFailed" targetRef="FIN_Throw_RefundDelayed" />
    <bpmn:sequenceFlow id="Flow_060" sourceRef="FIN_Throw_RefundDelayed" targetRef="FIN_End_RefundPending" />
    <bpmn:sequenceFlow id="Flow_061" sourceRef="FIN_Auto_RecordNoRefund" targetRef="FIN_Throw_NoRefund" />
    <bpmn:sequenceFlow id="Flow_062" sourceRef="FIN_Throw_NoRefund" targetRef="FIN_End_NoRefund" />
    <bpmn:sequenceFlow id="Flow_063" sourceRef="FIN_Start_ImpactReview" targetRef="FIN_Task_ReviewImpact" />
    <bpmn:sequenceFlow id="Flow_064" sourceRef="FIN_Task_ReviewImpact" targetRef="FIN_GW_ImpactAction" />
    <bpmn:sequenceFlow id="Flow_065" name="Charge or refund to adjust" sourceRef="FIN_GW_ImpactAction" targetRef="FIN_Throw_FinanceOutcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=impactAction = "ADJUST_CHARGE" or impactAction = "REFUND_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_066" name="No change to the account" sourceRef="FIN_GW_ImpactAction" targetRef="FIN_Throw_FinanceOutcome" />
    <bpmn:sequenceFlow id="Flow_067" sourceRef="FIN_Throw_FinanceOutcome" targetRef="FIN_End_ImpactReviewed" />
    <bpmn:sequenceFlow id="Flow_068" sourceRef="FIN_Start_Enquiry" targetRef="FIN_Task_AnswerEnquiry" />
    <bpmn:sequenceFlow id="Flow_069" sourceRef="FIN_Task_AnswerEnquiry" targetRef="FIN_Throw_EnquiryAnswered" />
    <bpmn:sequenceFlow id="Flow_070" sourceRef="FIN_Throw_EnquiryAnswered" targetRef="FIN_End_EnquiryAnswered" />
    <bpmn:startEvent id="FIN_Start_FundingCheck" name="Funding check requested">
      <bpmn:outgoing>Flow_031</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_014" messageRef="Message_funding_check_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="FIN_Start_PaymentInvestigation" name="Payment taken without confirmation">
      <bpmn:outgoing>Flow_043</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_016" messageRef="Message_payment_investigation_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="FIN_Start_Refund" name="Refund decision required">
      <bpmn:outgoing>Flow_049</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_018" messageRef="Message_refund_required" />
    </bpmn:startEvent>
    <bpmn:startEvent id="FIN_Start_ImpactReview" name="Financial impact review requested">
      <bpmn:outgoing>Flow_063</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_021" messageRef="Message_finance_impact_review_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="FIN_Start_Enquiry" name="Payment enquiry">
      <bpmn:outgoing>Flow_068</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_023" messageRef="Message_enquiry_assigned_finance" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="external-clinical-services" name="External Treatment, Laboratory and Imaging Services" isExecutable="false">
    <bpmn:documentation>The hospitals and laboratories that deliver treatment, tests and imaging. They report what they can take and when; a resource that stays unavailable is what makes the hospital's own service task raise EXTERNAL_RESOURCE_UNAVAILABLE.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="external-clinical-services_lanes">
      <bpmn:lane id="external-clinical-services_L0" name="Treatment and diagnostic capacity">
        <bpmn:flowNodeRef>EXT_Task_CheckCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXT_Throw_Capacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXT_End_CapacityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXT_Start_CapacityCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="EXT_Task_CheckCapacity" name="Check treatment, laboratory and imaging capacity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external-resources.check-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_071</bpmn:incoming>
      <bpmn:outgoing>Flow_072</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="EXT_Throw_Capacity" name="Return what is available and when">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="external-resources.capacity-returned" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-external-capacity&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_072</bpmn:incoming>
      <bpmn:outgoing>Flow_073</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_026" messageRef="Message_external_resources_capacity_returned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EXT_End_CapacityCheck" name="Capacity returned">
      <bpmn:incoming>Flow_073</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_071" sourceRef="EXT_Start_CapacityCheck" targetRef="EXT_Task_CheckCapacity" />
    <bpmn:sequenceFlow id="Flow_072" sourceRef="EXT_Task_CheckCapacity" targetRef="EXT_Throw_Capacity" />
    <bpmn:sequenceFlow id="Flow_073" sourceRef="EXT_Throw_Capacity" targetRef="EXT_End_CapacityCheck" />
    <bpmn:startEvent id="EXT_Start_CapacityCheck" name="Capacity check requested by the booking team">
      <bpmn:outgoing>Flow_071</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_025" messageRef="Message_external_resources_capacity_requested" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="treatment-bookings" name="Treatment and Chemotherapy Bookings Team" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="treatment-bookings_lanes">
      <bpmn:lane id="treatment-bookings_L1" name="Cycles and treatment changes">
        <bpmn:flowNodeRef>TRT_Auto_ScheduleCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_FindCycleSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_CycleSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_NextReviewDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_MoreCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CycleScheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CourseComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CycleCapacityIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_RecordDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_DelayNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_DelayRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ApplyModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_ModificationFinancial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_ModificationFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_ModificationApplied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_ModificationToClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_ModificationForwarded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Comp_ReleaseCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CompCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_ModificationApplied_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CompCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CycleNoSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_CyclePending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_ModificationAuthorised</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treatment-bookings_L0" name="Treatment booking and funding">
        <bpmn:flowNodeRef>TRT_Auto_ValidateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_RequestRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_RequestRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_EGW_Funding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_FundingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_FundingTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_FundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_PreparePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_IGW_ReadyToBook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_Deduplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewDeclinedPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_DeclinedAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_NextAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_PaymentUnresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_PaymentUnresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_UrgencyAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Task_ReviewFundingTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_FundingTimeoutAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingTimeoutEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_FundingPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_CreateSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_CheckExternalResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_ExternalAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_ConfirmAppointments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_TreatmentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_PGW_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_LetterDraftRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_SendTreatmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_PGW_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_Scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_BookingPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_RetryTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Comp_ReleaseSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_CompSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Auto_RecordRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_GW_CapacityCap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_BookingPending2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Catch_RetryTimer2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_FundingDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_End_PaymentUnresolved_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_CompSeries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ExternalUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ConfirmationLost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_ProviderUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Bnd_NotAuthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Start_BookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRT_Throw_Investigation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="TRT_Auto_ValidateRequest" name="Check the request is complete and authorised">
      <bpmn:documentation>Rejects anything without an authorising clinician. A request that only arrived by email or telephone is not in the system at all, so it cannot reach this step.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.validate-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_074</bpmn:incoming>
      <bpmn:outgoing>Flow_075</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_RequestRejected" name="Return the request to the clinical team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.request-invalid" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-request-invalid&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_076</bpmn:incoming>
      <bpmn:outgoing>Flow_077</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_028" messageRef="Message_treatment_request_invalid" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_RequestRejected" name="Request returned for authorisation">
      <bpmn:incoming>Flow_077</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingCheck" name="Ask Finance how this treatment is funded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.check-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_075</bpmn:incoming>
      <bpmn:incoming>Flow_104</bpmn:incoming>
      <bpmn:outgoing>Flow_078</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_029" messageRef="Message_funding_check_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="TRT_EGW_Funding" name="Waiting on the funding decision">
      <bpmn:incoming>Flow_078</bpmn:incoming>
      <bpmn:outgoing>Flow_079</bpmn:outgoing>
      <bpmn:outgoing>Flow_080</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TRT_Catch_FundingDecision" name="Funding decision received">
      <bpmn:incoming>Flow_079</bpmn:incoming>
      <bpmn:outgoing>Flow_081</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_030" messageRef="Message_funding_decision_received" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_FundingTimeout" name="Funding decision overdue">
      <bpmn:incoming>Flow_080</bpmn:incoming>
      <bpmn:outgoing>Flow_102</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_002">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="TRT_GW_FundingRoute" name="Who is paying for this treatment?" default="Flow_083">
      <bpmn:incoming>Flow_081</bpmn:incoming>
      <bpmn:outgoing>Flow_082</bpmn:outgoing>
      <bpmn:outgoing>Flow_083</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_PreparePayment" name="Prepare the secure payment request">
      <bpmn:documentation>Creates the payment reference and the secure link. Card details are never held in the hospital system.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.prepare-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=1" target="paymentAttempt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_082</bpmn:incoming>
      <bpmn:incoming>Flow_095</bpmn:incoming>
      <bpmn:outgoing>Flow_084</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_ProcessPayment" name="Take the payment through the payment provider">
      <bpmn:documentation>Outbound call to the external payment provider. Only the status, reference, date and amount come back - never card data.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-transaction" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_084</bpmn:incoming>
      <bpmn:outgoing>Flow_085</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_PaymentOutcome" name="What did the provider report?" default="Flow_090">
      <bpmn:incoming>Flow_085</bpmn:incoming>
      <bpmn:outgoing>Flow_088</bpmn:outgoing>
      <bpmn:outgoing>Flow_089</bpmn:outgoing>
      <bpmn:outgoing>Flow_090</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="TRT_IGW_ReadyToBook" name="Booking prerequisites satisfied">
      <bpmn:incoming>Flow_083</bpmn:incoming>
      <bpmn:incoming>Flow_088</bpmn:incoming>
      <bpmn:incoming>Flow_091</bpmn:incoming>
      <bpmn:incoming>Flow_100</bpmn:incoming>
      <bpmn:outgoing>Flow_106</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_Deduplicate" name="Check the charge has not already been taken">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.check-duplicate-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_089</bpmn:incoming>
      <bpmn:outgoing>Flow_091</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TRT_Task_ReviewDeclinedPayment" name="Decide how to handle the failed payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-declined-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_090</bpmn:incoming>
      <bpmn:outgoing>Flow_092</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TRT_GW_DeclinedAction" name="Try again or hand it over?" default="Flow_094">
      <bpmn:incoming>Flow_092</bpmn:incoming>
      <bpmn:outgoing>Flow_093</bpmn:outgoing>
      <bpmn:outgoing>Flow_094</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_NextAttempt" name="Record the next payment attempt">
      <bpmn:documentation>A new attempt gets a new payment reference, so the provider is never asked to take the same charge twice.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.prepare-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=paymentAttempt + 1" target="paymentAttempt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_093</bpmn:incoming>
      <bpmn:outgoing>Flow_095</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_PaymentUnresolved" name="Leave the payment with the Finance Team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.unresolved" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-unresolved&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_086</bpmn:incoming>
      <bpmn:incoming>Flow_094</bpmn:incoming>
      <bpmn:outgoing>Flow_096</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_031" messageRef="Message_payment_unresolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_PaymentUnresolved" name="Payment unresolved - booking not confirmed">
      <bpmn:incoming>Flow_096</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_UrgencyAuthorisation" name="Ask a clinician about proceeding anyway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.urgency-authorisation-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-urgency-authorisation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_097</bpmn:incoming>
      <bpmn:outgoing>Flow_098</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_033" messageRef="Message_treatment_urgency_authorisation_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_UrgencyDecision" name="Urgency decision returned">
      <bpmn:incoming>Flow_098</bpmn:incoming>
      <bpmn:outgoing>Flow_099</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_034" messageRef="Message_treatment_urgency_authorisation_result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="TRT_GW_UrgencyDecision" name="May treatment go ahead without confirmed payment?" default="Flow_101">
      <bpmn:incoming>Flow_099</bpmn:incoming>
      <bpmn:outgoing>Flow_100</bpmn:outgoing>
      <bpmn:outgoing>Flow_101</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TRT_Task_ReviewFundingTimeout" name="Chase the outstanding funding approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="chase-funding-approval" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_102</bpmn:incoming>
      <bpmn:outgoing>Flow_103</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TRT_GW_FundingTimeoutAction" name="Has the approval come through?" default="Flow_105">
      <bpmn:incoming>Flow_103</bpmn:incoming>
      <bpmn:outgoing>Flow_104</bpmn:outgoing>
      <bpmn:outgoing>Flow_105</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingTimeoutEscalation" name="Record the funding delay">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.delay-recorded" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding-delay&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_105</bpmn:incoming>
      <bpmn:outgoing>Flow_149</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_035" messageRef="Message_funding_delay_recorded" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_FundingPending" name="Booking held pending funding approval">
      <bpmn:incoming>Flow_150</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_CreateSeries" name="Create the provisional appointment series">
      <bpmn:documentation>One appointment per cycle, all keyed on the treatment booking reference so a retry cannot create a second series.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.create-appointment-series" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_106</bpmn:incoming>
      <bpmn:incoming>Flow_148</bpmn:incoming>
      <bpmn:outgoing>Flow_107</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_CheckExternalResources" name="Check external treatment and diagnostic capacity">
      <bpmn:documentation>Outbound call to the external treatment, laboratory and imaging services. If the booking cannot be held the case stays pending instead of being lost.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external-resources.check-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_107</bpmn:incoming>
      <bpmn:incoming>Flow_143</bpmn:incoming>
      <bpmn:outgoing>Flow_108</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_ExternalAvailable" name="Is everything available?" default="Flow_111">
      <bpmn:incoming>Flow_108</bpmn:incoming>
      <bpmn:outgoing>Flow_110</bpmn:outgoing>
      <bpmn:outgoing>Flow_111</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_ConfirmAppointments" name="Confirm the treatment appointments">
      <bpmn:documentation>Runs once per booking reference. Re-running after a retry updates the same appointments instead of adding new ones.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.confirm-appointments" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_110</bpmn:incoming>
      <bpmn:outgoing>Flow_112</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_TreatmentConfirmed" name="Treatment schedule confirmed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.confirmed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-confirmed&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_112</bpmn:incoming>
      <bpmn:outgoing>Flow_113</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_036" messageRef="Message_treatment_confirmed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="TRT_PGW_NotifySplit" name="Tell the patient and start the clinic letter">
      <bpmn:documentation>Once treatment is confirmed both of these have to happen, so they run in parallel rather than as a choice.</bpmn:documentation>
      <bpmn:incoming>Flow_113</bpmn:incoming>
      <bpmn:outgoing>Flow_114</bpmn:outgoing>
      <bpmn:outgoing>Flow_115</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_LetterDraftRequested" name="Clinic letter requested">
      <bpmn:documentation>Raised once treatment is confirmed so the seven day correspondence target starts from a recorded point in the pathway.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="clinic.letter-draft-required" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-clinic-letter&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_114</bpmn:incoming>
      <bpmn:outgoing>Flow_116</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_037" messageRef="Message_clinic_letter_draft_required" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="TRT_Auto_SendTreatmentLetter" name="Send the treatment confirmation letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;patient&#34;]" target="letterRecipients" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_115</bpmn:incoming>
      <bpmn:outgoing>Flow_117</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="TRT_PGW_NotifyJoin" name="Both notifications issued">
      <bpmn:incoming>Flow_116</bpmn:incoming>
      <bpmn:incoming>Flow_117</bpmn:incoming>
      <bpmn:outgoing>Flow_118</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="TRT_End_Scheduled" name="Schedule confirmed">
      <bpmn:incoming>Flow_118</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_BookingPending" name="Booking pending">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_109</bpmn:incoming>
      <bpmn:outgoing>Flow_119</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_038" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_RetryTimer" name="Retry external capacity">
      <bpmn:incoming>Flow_119</bpmn:incoming>
      <bpmn:outgoing>Flow_141</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_003">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="TRT_Auto_ScheduleCycle" name="Schedule the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.schedule-next-cycle" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_120</bpmn:incoming>
      <bpmn:outgoing>Flow_121</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_FindCycleSlots" name="Look for a slot for the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_121</bpmn:incoming>
      <bpmn:outgoing>Flow_122</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CycleSlots" name="Was a cycle slot found?" default="Flow_124">
      <bpmn:incoming>Flow_122</bpmn:incoming>
      <bpmn:outgoing>Flow_123</bpmn:outgoing>
      <bpmn:outgoing>Flow_124</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_NextReviewDue" name="Next cycle booked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="chemotherapy.review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-chemotherapy-cycle&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_123</bpmn:incoming>
      <bpmn:outgoing>Flow_126</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_040" messageRef="Message_chemotherapy_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="TRT_GW_MoreCycles" name="Are there further cycles in this course?" default="Flow_128">
      <bpmn:incoming>Flow_126</bpmn:incoming>
      <bpmn:outgoing>Flow_127</bpmn:outgoing>
      <bpmn:outgoing>Flow_128</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="TRT_End_CycleScheduled" name="Next cycle booked and review requested">
      <bpmn:incoming>Flow_127</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TRT_End_CourseComplete" name="Course of treatment complete">
      <bpmn:incoming>Flow_128</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CycleCapacityIssue" name="Flag the capacity problem">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_125</bpmn:incoming>
      <bpmn:incoming>Flow_146</bpmn:incoming>
      <bpmn:outgoing>Flow_129</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_041" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="TRT_Task_RecordDelay" name="Record the delay and re-plan the cycle">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="record-cycle-delay" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_130</bpmn:incoming>
      <bpmn:outgoing>Flow_131</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_DelayNotified" name="Tell the pathway team and the patient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_131</bpmn:incoming>
      <bpmn:outgoing>Flow_132</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_043" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_DelayRecorded" name="Delay recorded">
      <bpmn:incoming>Flow_132</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_ApplyModification" name="Apply the treatment change to the schedule">
      <bpmn:documentation>Updates the existing appointments rather than creating a new series.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.apply-modification" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_136</bpmn:incoming>
      <bpmn:outgoing>Flow_137</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_ModificationFinancial" name="Does the change affect money already handled?" default="Flow_139">
      <bpmn:incoming>Flow_137</bpmn:incoming>
      <bpmn:outgoing>Flow_138</bpmn:outgoing>
      <bpmn:outgoing>Flow_139</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_ModificationFinance" name="Refer the financial impact to Finance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="finance.impact-review-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-finance-impact&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_138</bpmn:incoming>
      <bpmn:outgoing>Flow_140</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_046" messageRef="Message_finance_impact_review_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_ModificationApplied" name="Treatment change applied">
      <bpmn:incoming>Flow_139</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="TRT_Task_ReviewModification" name="Review the treatment change request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-treatment-change" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_133</bpmn:incoming>
      <bpmn:outgoing>Flow_134</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_ModificationToClinical" name="Send the change for clinical authorisation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.change-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-change&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_134</bpmn:incoming>
      <bpmn:outgoing>Flow_135</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_047" messageRef="Message_treatment_change_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_ModificationForwarded" name="Change forwarded for authorisation">
      <bpmn:incoming>Flow_135</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Comp_ReleaseSeries" name="Release the provisional appointment series" isForCompensation="true">
      <bpmn:documentation>Compensation handler. Frees every appointment in the series when the booking has to be undone, so nothing is left held against the patient.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-series" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Comp_ReleaseCycle" name="Release the provisional cycle booking" isForCompensation="true">
      <bpmn:documentation>Compensation handler for a cycle slot that was pencilled in and then could not be filled.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-cycle-booking" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CompSeries" name="Undo the provisional series">
      <bpmn:documentation>Thrown after the capacity re-attempts run out, before the case goes to the pathway team.</bpmn:documentation>
      <bpmn:incoming>Flow_111</bpmn:incoming>
      <bpmn:incoming>Flow_144</bpmn:incoming>
      <bpmn:outgoing>Flow_145</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_003" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_CompCycle" name="Undo the provisional cycle slot">
      <bpmn:incoming>Flow_124</bpmn:incoming>
      <bpmn:outgoing>Flow_146</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_004" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="TRT_Auto_RecordRetry" name="Record another capacity attempt">
      <bpmn:documentation>Counts the attempts so the loop can stop. Without a cap the case would retry for ever and nobody would ever pick it up.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.record-capacity-retry" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if externalResourceAttempts = null then 1 else externalResourceAttempts + 1" target="externalResourceAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_141</bpmn:incoming>
      <bpmn:outgoing>Flow_142</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CapacityCap" name="Have we tried long enough?" default="Flow_144">
      <bpmn:incoming>Flow_142</bpmn:incoming>
      <bpmn:outgoing>Flow_143</bpmn:outgoing>
      <bpmn:outgoing>Flow_144</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="TRT_Throw_BookingPending2" name="Tell the pathway team the booking was released">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="treatment.booking-pending" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-treatment-pending&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_145</bpmn:incoming>
      <bpmn:outgoing>Flow_147</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_048" messageRef="Message_treatment_booking_pending" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="TRT_Catch_RetryTimer2" name="Retry the whole booking later">
      <bpmn:incoming>Flow_147</bpmn:incoming>
      <bpmn:outgoing>Flow_148</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_004">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_FundingDelay" name="Flag the funding delay to the pathway team">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="funding.delay-flagged" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-funding-delay&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_149</bpmn:incoming>
      <bpmn:outgoing>Flow_150</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_049" messageRef="Message_funding_delay_flagged" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="TRT_End_PaymentUnresolved_1" name="Payment unresolved - booking not confirmed - May treatment go ahead without confirmed payme">
      <bpmn:incoming>Flow_101</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TRT_End_ModificationApplied_1" name="Treatment change applied - Refer the financial impact to Finance">
      <bpmn:incoming>Flow_140</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CompCycle" name="Cycle slot committed" attachedToRef="TRT_Auto_ScheduleCycle">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_002" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CompSeries" name="Series committed" attachedToRef="TRT_Auto_CreateSeries">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_001" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_CycleNoSlots" name="No capacity" attachedToRef="TRT_Auto_FindCycleSlots">
      <bpmn:outgoing>Flow_125</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_009" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ExternalUnavailable" name="Unavailable" attachedToRef="TRT_Auto_CheckExternalResources">
      <bpmn:outgoing>Flow_109</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_008" errorRef="Error_EXTERNAL_RESOURCE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ConfirmationLost" name="No confirmation" attachedToRef="TRT_Auto_ProcessPayment">
      <bpmn:documentation>The provider may have taken the money. The transaction is investigated rather than charged again.</bpmn:documentation>
      <bpmn:outgoing>Flow_087</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_007" errorRef="Error_PAYMENT_CONFIRMATION_LOST" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_ProviderUnavailable" name="Provider down" attachedToRef="TRT_Auto_ProcessPayment">
      <bpmn:outgoing>Flow_086</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_006" errorRef="Error_PAYMENT_PROVIDER_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TRT_Bnd_NotAuthorised" name="Not authorised" attachedToRef="TRT_Auto_ValidateRequest">
      <bpmn:outgoing>Flow_076</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_005" errorRef="Error_TREATMENT_REQUEST_UNAUTHORISED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_074" sourceRef="TRT_Start_BookingRequest" targetRef="TRT_Auto_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_075" sourceRef="TRT_Auto_ValidateRequest" targetRef="TRT_Throw_FundingCheck" />
    <bpmn:sequenceFlow id="Flow_076" sourceRef="TRT_Bnd_NotAuthorised" targetRef="TRT_Throw_RequestRejected" />
    <bpmn:sequenceFlow id="Flow_077" sourceRef="TRT_Throw_RequestRejected" targetRef="TRT_End_RequestRejected" />
    <bpmn:sequenceFlow id="Flow_104" name="Approval now in place" sourceRef="TRT_GW_FundingTimeoutAction" targetRef="TRT_Throw_FundingCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingChaseOutcome = "RECHECK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_078" sourceRef="TRT_Throw_FundingCheck" targetRef="TRT_EGW_Funding" />
    <bpmn:sequenceFlow id="Flow_079" sourceRef="TRT_EGW_Funding" targetRef="TRT_Catch_FundingDecision" />
    <bpmn:sequenceFlow id="Flow_080" sourceRef="TRT_EGW_Funding" targetRef="TRT_Catch_FundingTimeout" />
    <bpmn:sequenceFlow id="Flow_081" sourceRef="TRT_Catch_FundingDecision" targetRef="TRT_GW_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_102" sourceRef="TRT_Catch_FundingTimeout" targetRef="TRT_Task_ReviewFundingTimeout" />
    <bpmn:sequenceFlow id="Flow_082" name="Patient pays" sourceRef="TRT_GW_FundingRoute" targetRef="TRT_Auto_PreparePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fundingRoute = "PATIENT_PAYS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_083" name="Hospital, insurer or exemption" sourceRef="TRT_GW_FundingRoute" targetRef="TRT_IGW_ReadyToBook" />
    <bpmn:sequenceFlow id="Flow_095" sourceRef="TRT_Auto_NextAttempt" targetRef="TRT_Auto_PreparePayment" />
    <bpmn:sequenceFlow id="Flow_084" sourceRef="TRT_Auto_PreparePayment" targetRef="TRT_Auto_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_085" sourceRef="TRT_Auto_ProcessPayment" targetRef="TRT_GW_PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_088" name="Approved" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_IGW_ReadyToBook">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_089" name="Duplicate charge reported" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_Auto_Deduplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "DUPLICATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_090" name="Declined or cancelled" sourceRef="TRT_GW_PaymentOutcome" targetRef="TRT_Task_ReviewDeclinedPayment" />
    <bpmn:sequenceFlow id="Flow_091" sourceRef="TRT_Auto_Deduplicate" targetRef="TRT_IGW_ReadyToBook" />
    <bpmn:sequenceFlow id="Flow_100" name="Clinician authorised" sourceRef="TRT_GW_UrgencyDecision" targetRef="TRT_IGW_ReadyToBook">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgentTreatmentAuthorised = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_106" sourceRef="TRT_IGW_ReadyToBook" targetRef="TRT_Auto_CreateSeries" />
    <bpmn:sequenceFlow id="Flow_092" sourceRef="TRT_Task_ReviewDeclinedPayment" targetRef="TRT_GW_DeclinedAction" />
    <bpmn:sequenceFlow id="Flow_093" name="Try another payment" sourceRef="TRT_GW_DeclinedAction" targetRef="TRT_Auto_NextAttempt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=declinedAction = "RETRY_PAYMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_094" name="Leave with Finance" sourceRef="TRT_GW_DeclinedAction" targetRef="TRT_Throw_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_086" sourceRef="TRT_Bnd_ProviderUnavailable" targetRef="TRT_Throw_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_096" sourceRef="TRT_Throw_PaymentUnresolved" targetRef="TRT_End_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_087" sourceRef="TRT_Bnd_ConfirmationLost" targetRef="TRT_Throw_Investigation" />
    <bpmn:sequenceFlow id="Flow_097" sourceRef="TRT_Throw_Investigation" targetRef="TRT_Throw_UrgencyAuthorisation" />
    <bpmn:sequenceFlow id="Flow_098" sourceRef="TRT_Throw_UrgencyAuthorisation" targetRef="TRT_Catch_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_099" sourceRef="TRT_Catch_UrgencyDecision" targetRef="TRT_GW_UrgencyDecision" />
    <bpmn:sequenceFlow id="Flow_101" name="Not authorised" sourceRef="TRT_GW_UrgencyDecision" targetRef="TRT_End_PaymentUnresolved_1" />
    <bpmn:sequenceFlow id="Flow_103" sourceRef="TRT_Task_ReviewFundingTimeout" targetRef="TRT_GW_FundingTimeoutAction" />
    <bpmn:sequenceFlow id="Flow_105" name="Still waiting" sourceRef="TRT_GW_FundingTimeoutAction" targetRef="TRT_Throw_FundingTimeoutEscalation" />
    <bpmn:sequenceFlow id="Flow_149" sourceRef="TRT_Throw_FundingTimeoutEscalation" targetRef="TRT_Throw_FundingDelay" />
    <bpmn:sequenceFlow id="Flow_150" sourceRef="TRT_Throw_FundingDelay" targetRef="TRT_End_FundingPending" />
    <bpmn:sequenceFlow id="Flow_148" sourceRef="TRT_Catch_RetryTimer2" targetRef="TRT_Auto_CreateSeries" />
    <bpmn:sequenceFlow id="Flow_107" sourceRef="TRT_Auto_CreateSeries" targetRef="TRT_Auto_CheckExternalResources" />
    <bpmn:sequenceFlow id="Flow_143" name="Try again" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Auto_CheckExternalResources">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=externalResourceAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_108" sourceRef="TRT_Auto_CheckExternalResources" targetRef="TRT_GW_ExternalAvailable" />
    <bpmn:sequenceFlow id="Flow_110" name="All resources held" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Auto_ConfirmAppointments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=externalResourcesAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_111" name="Something is unavailable" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Throw_CompSeries" />
    <bpmn:sequenceFlow id="Flow_112" sourceRef="TRT_Auto_ConfirmAppointments" targetRef="TRT_Throw_TreatmentConfirmed" />
    <bpmn:sequenceFlow id="Flow_113" sourceRef="TRT_Throw_TreatmentConfirmed" targetRef="TRT_PGW_NotifySplit" />
    <bpmn:sequenceFlow id="Flow_114" sourceRef="TRT_PGW_NotifySplit" targetRef="TRT_Throw_LetterDraftRequested" />
    <bpmn:sequenceFlow id="Flow_115" sourceRef="TRT_PGW_NotifySplit" targetRef="TRT_Auto_SendTreatmentLetter" />
    <bpmn:sequenceFlow id="Flow_116" sourceRef="TRT_Throw_LetterDraftRequested" targetRef="TRT_PGW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_117" sourceRef="TRT_Auto_SendTreatmentLetter" targetRef="TRT_PGW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_118" sourceRef="TRT_PGW_NotifyJoin" targetRef="TRT_End_Scheduled" />
    <bpmn:sequenceFlow id="Flow_109" sourceRef="TRT_Bnd_ExternalUnavailable" targetRef="TRT_Throw_BookingPending" />
    <bpmn:sequenceFlow id="Flow_119" sourceRef="TRT_Throw_BookingPending" targetRef="TRT_Catch_RetryTimer" />
    <bpmn:sequenceFlow id="Flow_141" sourceRef="TRT_Catch_RetryTimer" targetRef="TRT_Auto_RecordRetry" />
    <bpmn:sequenceFlow id="Flow_120" sourceRef="TRT_Start_CycleApproved" targetRef="TRT_Auto_ScheduleCycle" />
    <bpmn:sequenceFlow id="Flow_121" sourceRef="TRT_Auto_ScheduleCycle" targetRef="TRT_Auto_FindCycleSlots" />
    <bpmn:sequenceFlow id="Flow_122" sourceRef="TRT_Auto_FindCycleSlots" targetRef="TRT_GW_CycleSlots" />
    <bpmn:sequenceFlow id="Flow_123" name="Slot found" sourceRef="TRT_GW_CycleSlots" targetRef="TRT_Throw_NextReviewDue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_124" name="Nothing available" sourceRef="TRT_GW_CycleSlots" targetRef="TRT_Throw_CompCycle" />
    <bpmn:sequenceFlow id="Flow_126" sourceRef="TRT_Throw_NextReviewDue" targetRef="TRT_GW_MoreCycles" />
    <bpmn:sequenceFlow id="Flow_127" name="Another cycle to come" sourceRef="TRT_GW_MoreCycles" targetRef="TRT_End_CycleScheduled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cycleNumber &lt; cycleCount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_128" name="Last cycle of the course" sourceRef="TRT_GW_MoreCycles" targetRef="TRT_End_CourseComplete" />
    <bpmn:sequenceFlow id="Flow_125" sourceRef="TRT_Bnd_CycleNoSlots" targetRef="TRT_Throw_CycleCapacityIssue" />
    <bpmn:sequenceFlow id="Flow_146" sourceRef="TRT_Throw_CompCycle" targetRef="TRT_Throw_CycleCapacityIssue" />
    <bpmn:sequenceFlow id="Flow_129" sourceRef="TRT_Throw_CycleCapacityIssue" targetRef="TRT_End_CyclePending" />
    <bpmn:sequenceFlow id="Flow_130" sourceRef="TRT_Start_CycleDelayed" targetRef="TRT_Task_RecordDelay" />
    <bpmn:sequenceFlow id="Flow_131" sourceRef="TRT_Task_RecordDelay" targetRef="TRT_Throw_DelayNotified" />
    <bpmn:sequenceFlow id="Flow_132" sourceRef="TRT_Throw_DelayNotified" targetRef="TRT_End_DelayRecorded" />
    <bpmn:sequenceFlow id="Flow_133" sourceRef="TRT_Start_Modification" targetRef="TRT_Task_ReviewModification" />
    <bpmn:sequenceFlow id="Flow_136" sourceRef="TRT_Start_ModificationAuthorised" targetRef="TRT_Auto_ApplyModification" />
    <bpmn:sequenceFlow id="Flow_137" sourceRef="TRT_Auto_ApplyModification" targetRef="TRT_GW_ModificationFinancial" />
    <bpmn:sequenceFlow id="Flow_138" name="Charge or payment affected" sourceRef="TRT_GW_ModificationFinancial" targetRef="TRT_Throw_ModificationFinance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=modificationAffectsFinance = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_139" name="No financial impact" sourceRef="TRT_GW_ModificationFinancial" targetRef="TRT_End_ModificationApplied" />
    <bpmn:sequenceFlow id="Flow_140" sourceRef="TRT_Throw_ModificationFinance" targetRef="TRT_End_ModificationApplied_1" />
    <bpmn:sequenceFlow id="Flow_134" sourceRef="TRT_Task_ReviewModification" targetRef="TRT_Throw_ModificationToClinical" />
    <bpmn:sequenceFlow id="Flow_135" sourceRef="TRT_Throw_ModificationToClinical" targetRef="TRT_End_ModificationForwarded" />
    <bpmn:sequenceFlow id="Flow_144" name="Stop and release the series" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Throw_CompSeries" />
    <bpmn:sequenceFlow id="Flow_145" sourceRef="TRT_Throw_CompSeries" targetRef="TRT_Throw_BookingPending2" />
    <bpmn:sequenceFlow id="Flow_142" sourceRef="TRT_Auto_RecordRetry" targetRef="TRT_GW_CapacityCap" />
    <bpmn:sequenceFlow id="Flow_147" sourceRef="TRT_Throw_BookingPending2" targetRef="TRT_Catch_RetryTimer2" />
    <bpmn:startEvent id="TRT_Start_BookingRequest" name="Booking request received">
      <bpmn:outgoing>Flow_074</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_027" messageRef="Message_treatment_booking_requested" />
    </bpmn:startEvent>
    <bpmn:endEvent id="TRT_End_CyclePending" name="Cycle booking held">
      <bpmn:incoming>Flow_129</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="TRT_Start_CycleApproved" name="Next chemotherapy cycle authorised">
      <bpmn:outgoing>Flow_120</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_039" messageRef="Message_chemotherapy_cycle_approved" />
    </bpmn:startEvent>
    <bpmn:startEvent id="TRT_Start_CycleDelayed" name="Cycle delayed on clinical grounds">
      <bpmn:outgoing>Flow_130</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_042" messageRef="Message_chemotherapy_cycle_delayed" />
    </bpmn:startEvent>
    <bpmn:startEvent id="TRT_Start_Modification" name="Treatment plan change requested">
      <bpmn:outgoing>Flow_133</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_044" messageRef="Message_treatment_modification_requested" />
    </bpmn:startEvent>
    <bpmn:startEvent id="TRT_Start_ModificationAuthorised" name="Treatment change authorised">
      <bpmn:outgoing>Flow_136</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_045" messageRef="Message_treatment_modification_authorised" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="TRT_Throw_Investigation" name="Mark the transaction for investigation">
      <bpmn:documentation>Money may have left the patient's account without a confirmation reaching us.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="payment.investigation-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef + &#34;-payment-investigation&#34;" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_087</bpmn:incoming>
      <bpmn:outgoing>Flow_097</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_032" messageRef="Message_payment_investigation_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:association id="TRT_Bnd_CompSeries_assoc" associationDirection="One" sourceRef="TRT_Bnd_CompSeries" targetRef="TRT_Comp_ReleaseSeries" />
    <bpmn:association id="TRT_Bnd_CompCycle_assoc" associationDirection="One" sourceRef="TRT_Bnd_CompCycle" targetRef="TRT_Comp_ReleaseCycle" />
  </bpmn:process>
  <bpmn:process id="consultants" name="Consultants" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="consultants_lanes">
      <bpmn:lane id="consultants_L1" name="Correspondence and requests from other teams">
        <bpmn:flowNodeRef>CON_Task_DraftLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_RecordReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_ReminderRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_CorrectLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_LetterReapproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_LetterReapproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_UrgencyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_PathwayReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ClinicalReviewOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_FollowUpRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Bnd_LetterReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Bnd_LetterOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_LetterDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_LetterCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_UrgencyAuthorisation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="consultants_L0" name="Clinical decisions and authorisations">
        <bpmn:flowNodeRef>CON_Task_ReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuditDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_MoreInfoNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_OutcomeReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_RecordConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_ConsentGiven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuthoriseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_BookingRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_BookingRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_TreatmentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_TreatmentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_ReviewCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Auto_AuditCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_CycleOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_CycleApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_CycleDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_PlanChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_PlanChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Task_AuthoriseModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_GW_ModificationUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationRoutine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Throw_ModificationFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_OutcomeReturned_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_OutcomeReturned_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_End_Modification_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_AppointmentAttended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_CycleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CON_Start_Modification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="CON_Task_ReviewReferral" name="Review the referral and record the clinical decision">
      <bpmn:documentation>Accept, reject, redirect or ask for more information. The reason and the deciding clinician are recorded for audit and cannot be edited afterwards.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="review-referral" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_151</bpmn:incoming>
      <bpmn:outgoing>Flow_152</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_Auto_AuditDecision" name="Write the clinical decision to the audit trail">
      <bpmn:documentation>Immutable record of who decided what, when and why.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-clinical-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_152</bpmn:incoming>
      <bpmn:outgoing>Flow_153</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_GW_Decision" name="What is the clinical decision?" default="Flow_157">
