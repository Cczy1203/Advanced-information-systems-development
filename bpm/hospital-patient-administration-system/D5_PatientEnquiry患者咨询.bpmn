    <bpmn:startEvent id="Event_vdutes2" name="Patient enquiry received">
      <bpmn:outgoing>Flow_usjjl8r</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0gasl05" messageRef="Message_vdl8c05" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_yprgxpx" name="Record enquiry and contact details">
      <bpmn:incoming>Flow_usjjl8r</bpmn:incoming>
      <bpmn:outgoing>Flow_1hylrqw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_7f9aptp" name="Classify and prioritise enquiry">
      <bpmn:documentation>Urgent clinical concerns are highlighted immediately. The full urgency rules are still to be agreed with the stakeholders.</bpmn:documentation>
      <bpmn:incoming>Flow_1hylrqw</bpmn:incoming>
      <bpmn:incoming>Flow_7ve2wb5</bpmn:incoming>
      <bpmn:outgoing>Flow_3sg8siv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_x88kmj8" name="Enquiry type?">
      <bpmn:incoming>Flow_3sg8siv</bpmn:incoming>
      <bpmn:outgoing>Flow_eksv4ov</bpmn:outgoing>
      <bpmn:outgoing>Flow_mz6gt6d</bpmn:outgoing>
      <bpmn:outgoing>Flow_ngat7ph</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_7fvm130" name="Answer administrative enquiry">
      <bpmn:documentation>Only straightforward administrative questions, such as the date, time or location of an appointment, are answered directly.</bpmn:documentation>
      <bpmn:incoming>Flow_eksv4ov</bpmn:incoming>
      <bpmn:outgoing>Flow_wxnhkil</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_co0ousl" name="Provide clinical advice or support">
      <bpmn:documentation>Only an appropriately qualified clinical professional may give clinical advice; the Call Handling Team may not.</bpmn:documentation>
      <bpmn:incoming>Flow_mz6gt6d</bpmn:incoming>
      <bpmn:outgoing>Flow_ka0m2pk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_t0nwjt1" name="Handle payment or funding enquiry">
      <bpmn:incoming>Flow_ngat7ph</bpmn:incoming>
      <bpmn:outgoing>Flow_g45sjod</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_6j43voo" name="Record response and resolution">
      <bpmn:incoming>Flow_wxnhkil</bpmn:incoming>
      <bpmn:incoming>Flow_ka0m2pk</bpmn:incoming>
      <bpmn:incoming>Flow_g45sjod</bpmn:incoming>
      <bpmn:outgoing>Flow_skyxd6e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_2sq9hji" name="Enquiry resolved?">
      <bpmn:incoming>Flow_skyxd6e</bpmn:incoming>
      <bpmn:outgoing>Flow_jaaz5df</bpmn:outgoing>
      <bpmn:outgoing>Flow_7ve2wb5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_wq9kcbe" name="Enquiry resolved and closed">
      <bpmn:incoming>Flow_jaaz5df</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_6zreyvt" name="Urgent clinical concern" triggeredByEvent="true">
      <bpmn:startEvent id="Event_5t80zn9" name="Urgent clinical concern flagged">
        <bpmn:outgoing>Flow_6tzuuez</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDefinition_t1mannj" signalRef="Signal_54zbtn5" />
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_fedzvm5" name="Immediate clinical assessment and response">
        <bpmn:documentation>Assessed by a clinical professional without administrative delay.</bpmn:documentation>
        <bpmn:incoming>Flow_6tzuuez</bpmn:incoming>
        <bpmn:outgoing>Flow_gc2b394</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_m51y196" name="Record urgent response and outcome">
        <bpmn:incoming>Flow_gc2b394</bpmn:incoming>
        <bpmn:outgoing>Flow_cvr01s8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_tllewpa" name="Urgent concern handled">
        <bpmn:incoming>Flow_cvr01s8</bpmn:incoming>
      </bpmn:endEvent>
