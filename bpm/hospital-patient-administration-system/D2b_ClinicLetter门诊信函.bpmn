    <bpmn:startEvent id="Event_whw79wg" name="Clinic attendance: letter required">
      <bpmn:outgoing>Flow_ml9qc8f</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_81obu47" name="Prepare clinic letter">
      <bpmn:incoming>Flow_ml9qc8f</bpmn:incoming>
      <bpmn:outgoing>Flow_lo82ue2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_2j9zha0" name="Approve clinic letter">
      <bpmn:documentation>The letter must be approved by the Consultant before it can be distributed.</bpmn:documentation>
      <bpmn:incoming>Flow_lo82ue2</bpmn:incoming>
      <bpmn:incoming>Flow_gveh20h</bpmn:incoming>
      <bpmn:incoming>Flow_apyhcic</bpmn:incoming>
      <bpmn:outgoing>Flow_vt4z7nm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_iga81if" name="Amend clinical content">
      <bpmn:incoming>Flow_kumfc0n</bpmn:incoming>
      <bpmn:outgoing>Flow_gveh20h</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_xx43j5f" name="Administrative check and recipients">
      <bpmn:documentation>Checks the recipients and the administrative detail. A suspected clinical error is returned to the Consultant; the clinical meaning must not be changed.</bpmn:documentation>
      <bpmn:incoming>Flow_vt4z7nm</bpmn:incoming>
      <bpmn:outgoing>Flow_rfal3yz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_aw1kip6" name="Clinical error suspected?">
      <bpmn:incoming>Flow_rfal3yz</bpmn:incoming>
      <bpmn:outgoing>Flow_jz7iuil</bpmn:outgoing>
      <bpmn:outgoing>Flow_kumfc0n</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_c35y06a" name="Distribute letter">
      <bpmn:incoming>Flow_jz7iuil</bpmn:incoming>
      <bpmn:outgoing>Flow_xtuvb75</bpmn:outgoing>
    </bpmn:userTask>
