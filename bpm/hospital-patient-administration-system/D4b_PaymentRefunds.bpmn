    <bpmn:startEvent id="Event_umvoq9l" name="Treatment cancelled or changed after payment">
      <bpmn:outgoing>Flow_gy6fsgv</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_bdhmttm" name="Provide treatment decision information">
      <bpmn:documentation>Clinical staff provide the information about the treatment decision; they do not approve the refund.</bpmn:documentation>
      <bpmn:incoming>Flow_gy6fsgv</bpmn:incoming>
      <bpmn:outgoing>Flow_rri8zw7</bpmn:outgoing>
    </bpmn:userTask>
