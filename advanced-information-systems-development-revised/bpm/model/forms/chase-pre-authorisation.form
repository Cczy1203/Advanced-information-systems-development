{
  "components": [
    {
      "label": "Who was spoken to",
      "type": "textfield",
      "layout": {
        "row": "Row_150",
        "columns": null
      },
      "id": "Field_150",
      "key": "payerContactName",
      "validate": {
        "maxLength": 80,
        "pattern": "^(?!\\s*\\d+\\s*$).+$",
        "patternErrorMessage": "This must be a name, not only digits."
      },
      "description": "Optional. Enter who was spoken to."
    },
    {
      "label": "Payer reference",
      "type": "textfield",
      "layout": {
        "row": "Row_151",
        "columns": null
      },
      "id": "Field_151",
      "key": "payerReference",
      "validate": {
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/\\-]*$",
        "patternErrorMessage": "Use letters, digits and the separators . / - _ only, with no spaces."
      },
      "description": "Optional. Enter payer reference."
    },
    {
      "label": "Outcome of the contact",
      "type": "radio",
      "layout": {
        "row": "Row_152",
        "columns": null
      },
      "id": "Field_152",
      "key": "outcome",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Approved",
          "value": "Approved"
        },
        {
          "label": "Declined",
          "value": "Declined"
        },
        {
          "label": "Awaiting response",
          "value": "Awaiting response"
        }
      ],
      "description": "Required. Choose one. Outcome of the contact."
    },
    {
      "label": "Authorisation reference",
      "type": "textfield",
      "layout": {
        "row": "Row_preauth",
        "columns": 6
      },
      "id": "Field_153",
      "key": "authorisationRef",
      "validate": {
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/\\-]*$",
        "patternErrorMessage": "Use letters, digits and the separators . / - _ only, with no spaces."
      },
      "description": "Optional. Enter authorisation reference."
    },
    {
      "label": "Approved amount",
      "type": "number",
      "layout": {
        "row": "Row_preauth",
        "columns": 6
      },
      "id": "Field_154",
      "key": "approvedAmount",
      "validate": {
        "min": 0,
        "max": 1000000
      },
      "description": "Optional. Enter a number between 0 and 1000000."
    },
    {
      "label": "Notes",
      "type": "textarea",
      "layout": {
        "row": "Row_155",
        "columns": null
      },
      "id": "Field_155",
      "key": "notes",
      "properties": {
        "rows": 3
      },
      "description": "Optional. Describe notes in your own words. This is what the next team reads."
    },
    {
      "label": "Chased by",
      "type": "textfield",
      "layout": {
        "row": "Row_156",
        "columns": null
      },
      "id": "Field_156",
      "key": "chasedBy",
      "validate": {
        "required": true,
        "maxLength": 80,
        "pattern": "^(?!\\s*\\d+\\s*$).+$",
        "patternErrorMessage": "This must be a name, not only digits."
      },
      "description": "Required. Enter chased by."
    }
  ],
  "type": "default",
  "id": "chase-pre-authorisation",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "description": "Following up an insurer or funding organisation that has not yet authorised treatment."
}
