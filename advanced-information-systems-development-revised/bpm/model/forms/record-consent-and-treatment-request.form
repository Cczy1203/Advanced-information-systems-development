{
  "components": [
    {
      "label": "Has the patient agreed to proceed with treatment?",
      "type": "radio",
      "layout": {
        "row": "Row_035",
        "columns": null
      },
      "id": "Field_035",
      "key": "consentGiven",
      "description": "Record what the patient actually said, not what was recommended. Answering No closes the pathway and sends the referral back to the clinical team.",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Yes - the patient agreed to proceed",
          "value": "true"
        },
        {
          "label": "No - the patient does not wish to proceed",
          "value": "false"
        }
      ]
    },
    {
      "label": "Consent discussed with",
      "type": "textfield",
      "layout": {
        "row": "Row_036",
        "columns": null
      },
      "id": "Field_036",
      "key": "consentDiscussedWith",
      "description": "Leave blank if the patient consented on their own behalf.",
      "validate": {
        "maxLength": 80
      }
    },
    {
      "label": "Treatment booking request",
      "type": "group",
      "id": "Field_ConsentPlan",
      "path": "",
      "description": "Completed only when the patient has agreed to proceed.",
      "conditional": {
        "hide": "=consentGiven = \"false\""
      },
      "components": [
        {
          "label": "Proposed treatment",
          "type": "select",
          "layout": {
            "row": "Row_037",
            "columns": null
          },
          "id": "Field_037",
          "key": "treatmentPlan",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Chemotherapy",
              "value": "Chemotherapy"
            },
            {
              "label": "Radiotherapy",
              "value": "Radiotherapy"
            },
            {
              "label": "Immunotherapy",
              "value": "Immunotherapy"
            },
            {
              "label": "Combination",
              "value": "Combination"
            },
            {
              "label": "Other",
              "value": "Other"
            }
          ],
          "conditional": {
            "hide": "=consentGiven = \"false\""
          },
          "description": "Required. Choose one. Proposed treatment."
        },
        {
          "type": "text",
          "text": "**Date rule: today or later.** The calendar already blocks past dates.",
          "id": "Text_treatmentStartDate_rule",
          "layout": {
            "row": "Row_treatmentStartDate_rule",
            "columns": null
          }
        },
        {
          "label": "Required start date (today or later)",
          "type": "datetime",
          "layout": {
            "row": "Row_038",
            "columns": null
          },
          "id": "Field_038",
          "key": "treatmentStartDate",
          "subtype": "date",
          "disallowPassedDates": true,
          "description": "Optional. This date cannot be in the past. The calendar blocks earlier dates, and the worker rejects one as well."
        },
        {
          "label": "Number of cycles",
          "type": "number",
          "layout": {
            "row": "Row_039",
            "columns": null
          },
          "id": "Field_039",
          "key": "cycleCount",
          "validate": {
            "required": true,
            "min": 1,
            "max": 30
          },
          "description": "Required. Enter a number between 1 and 30."
        },
        {
          "label": "Days between cycles",
          "type": "number",
          "layout": {
            "row": "Row_040",
            "columns": null
          },
          "id": "Field_040",
          "key": "cycleIntervalDays",
          "validate": {
            "required": true,
            "min": 1,
            "max": 90
          },
          "description": "Required. Enter a number between 1 and 90."
        },
        {
          "label": "A clinical review is needed between cycles",
          "type": "checkbox",
          "layout": {
            "row": "Row_041",
            "columns": null
          },
          "id": "Field_041",
          "key": "reviewsBetweenCycles",
          "defaultValue": false,
          "description": "Optional. Tick if a clinical review is needed between cycles. Leave it clear if not - an unticked box is a decision, not a blank."
        },
        {
          "label": "Special resources likely to be needed",
          "type": "checklist",
          "layout": {
            "row": "Row_042",
            "columns": null
          },
          "id": "Field_042",
          "key": "specialResources",
          "values": [
            {
              "label": "Laboratory",
              "value": "Laboratory"
            },
            {
              "label": "Imaging",
              "value": "Imaging"
            },
            {
              "label": "Pharmacy",
              "value": "Pharmacy"
            },
            {
              "label": "Day unit chair",
              "value": "Day unit chair"
            },
            {
              "label": "Isolation room",
              "value": "Isolation room"
            },
            {
              "label": "Interpreter",
              "value": "Interpreter"
            }
          ],
          "description": "Optional. Tick everything that applies to special resources likely to be needed."
        },
        {
          "label": "Treatment booking reference",
          "type": "textfield",
          "layout": {
            "row": "Row_043",
            "columns": null
          },
          "id": "Field_043",
          "key": "treatmentBookingRef",
          "validate": {
            "required": true,
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/\\-]*$",
            "patternErrorMessage": "Use letters, digits and the separators . / - _ only, with no spaces."
          },
          "description": "Required. Enter treatment booking reference."
        },
        {
          "label": "Authorising clinician",
          "type": "textfield",
          "layout": {
            "row": "Row_044",
            "columns": null
          },
          "id": "Field_044",
          "key": "authorisingClinician",
          "validate": {
            "required": true,
            "maxLength": 80,
            "pattern": "^(?!\\s*\\d+\\s*$).+$",
            "patternErrorMessage": "This must be a name, not only digits."
          },
          "description": "Required. Enter authorising clinician."
        }
      ]
    },
    {
      "label": "Why the patient is not proceeding",
      "type": "group",
      "id": "Field_ConsentDecline",
      "path": "",
      "description": "Recorded so the clinical team can follow the patient up.",
      "conditional": {
        "hide": "=consentGiven = \"true\""
      },
      "components": [
        {
          "label": "If the patient is not proceeding, what was discussed?",
          "type": "textarea",
          "layout": {
            "row": "Row_045",
            "columns": null
          },
          "id": "Field_045",
          "key": "declineReason",
          "properties": {
            "rows": 3
          },
          "validate": {
            "required": true
          },
          "description": "Required. Describe if the patient is not proceeding, what was discussed? in your own words. This is what the next team reads."
        }
      ]
    }
  ],
  "type": "default",
  "id": "record-consent-and-treatment-request",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "description": "Completed at the new patient appointment. If the patient agrees to proceed, the whole treatment booking request has to be filled in here - an incomplete request cannot be authorised."
}
