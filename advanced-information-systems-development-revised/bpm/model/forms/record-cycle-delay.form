{
  "components": [
    {
      "label": "Cycle number",
      "type": "number",
      "layout": {
        "row": "Row_125",
        "columns": null
      },
      "id": "Field_125",
      "key": "cycleNumber",
      "validate": {
        "required": true,
        "min": 1,
        "max": 30
      },
      "readonly": true,
      "description": "Shown for reference. Set by the booking team's schedule step; the pathway decides from this number whether another cycle follows, so it is not editable here."
    },
    {
      "label": "Reason for the delay",
      "type": "textarea",
      "layout": {
        "row": "Row_126",
        "columns": null
      },
      "id": "Field_126",
      "key": "delayReason",
      "validate": {
        "required": true
      },
      "properties": {
        "rows": 4
      },
      "description": "Required. Describe reason for the delay in your own words. This is what the next team reads."
    },
    {
      "type": "text",
      "text": "**Date rule: today or later.** The calendar already blocks past dates.",
      "id": "Text_newProposedStartDate_rule",
      "layout": {
        "row": "Row_newProposedStartDate_rule",
        "columns": null
      }
    },
    {
      "label": "Proposed new start date (today or later)",
      "type": "datetime",
      "layout": {
        "row": "Row_127",
        "columns": null
      },
      "id": "Field_127",
      "key": "newProposedStartDate",
      "subtype": "date",
      "disallowPassedDates": true,
      "validate": {
        "required": true
      },
      "description": "Required. This date cannot be in the past. The calendar blocks earlier dates, and the worker rejects one as well."
    },
    {
      "label": "The patient has been told",
      "type": "checkbox",
      "layout": {
        "row": "Row_128",
        "columns": null
      },
      "id": "Field_128",
      "key": "patientInformed",
      "defaultValue": false,
      "description": "Optional. Tick if the patient has been told. Leave it clear if not - an unticked box is a decision, not a blank."
    },
    {
      "label": "Recorded by",
      "type": "textfield",
      "layout": {
        "row": "Row_129",
        "columns": null
      },
      "id": "Field_129",
      "key": "recordedBy",
      "validate": {
        "required": true,
        "maxLength": 80,
        "pattern": "^(?!\\s*\\d+\\s*$).+$",
        "patternErrorMessage": "This must be a name, not only digits."
      },
      "description": "Required. Enter recorded by."
    }
  ],
  "type": "default",
  "id": "record-cycle-delay",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "description": "Recording a clinically agreed delay and replanning the cycle."
}
