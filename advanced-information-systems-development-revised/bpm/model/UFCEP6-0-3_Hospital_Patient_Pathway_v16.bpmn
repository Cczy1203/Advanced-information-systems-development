      </bpmn:extensionElements>
      <bpmn:incoming>Flow_141</bpmn:incoming>
      <bpmn:outgoing>Flow_144</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PCW_Auto_SendReminder" name="Send the weekly reminder to the Consultant">
