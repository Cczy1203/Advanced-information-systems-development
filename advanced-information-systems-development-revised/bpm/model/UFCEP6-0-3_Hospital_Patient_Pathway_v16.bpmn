        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_152</bpmn:incoming>
      <bpmn:outgoing>Flow_153</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_PatientInformed" name="Patient informed and delay recorded">
      <bpmn:incoming>Flow_153</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Enquiry" name="Enquiry or contact received">
      <bpmn:outgoing>Flow_154</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_006" messageRef="Message_enquiry_received" />
    </bpmn:startEvent>
    <bpmn:userTask id="CALL_Task_LogEnquiry" name="Log the enquiry, classify it and set a priority">
      <bpmn:documentation>Records when it was received, who handled it, which team owns it, the response given and whether the matter is resolved.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="call-handling" />
        <zeebe:formDefinition formId="log-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_154</bpmn:incoming>
      <bpmn:outgoing>Flow_155</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CALL_GW_Category" name="What kind of enquiry is this?" default="Flow_158">
      <bpmn:documentation>A call handler may answer straightforward administrative questions and transfer other administrative matters, but must not diagnose a condition, interpret test results, recommend treatment or give clinical advice.</bpmn:documentation>
      <bpmn:incoming>Flow_155</bpmn:incoming>
      <bpmn:outgoing>Flow_156</bpmn:outgoing>
      <bpmn:outgoing>Flow_157</bpmn:outgoing>
      <bpmn:outgoing>Flow_158</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CALL_GW_Answerable" name="Can this be answered with the information available?" default="Flow_160">
      <bpmn:incoming>Flow_158</bpmn:incoming>
      <bpmn:outgoing>Flow_159</bpmn:outgoing>
      <bpmn:outgoing>Flow_160</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CALL_Task_AnswerAdmin" name="Answer the administrative question">
