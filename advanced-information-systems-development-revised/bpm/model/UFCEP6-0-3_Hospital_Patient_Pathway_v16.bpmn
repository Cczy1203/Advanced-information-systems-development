        <zeebe:formDefinition formId="answer-administrative-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_159</bpmn:incoming>
      <bpmn:outgoing>Flow_161</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OUT_Task_AnswerAdminEnquiry" name="Answer the administrative enquiry">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="answer-administrative-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_160</bpmn:incoming>
      <bpmn:outgoing>Flow_162</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FIN_Task_AnswerEnquiry" name="Answer the payment or funding enquiry">
      <bpmn:documentation>Payment and funding enquiries that cannot be answered from authorised information are answered by the Finance Team.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="answer-financial-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_157</bpmn:incoming>
      <bpmn:outgoing>Flow_163</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CNS_Task_TriageEnquiry" name="Triage the clinical enquiry and respond">
      <bpmn:documentation>Urgent clinical concerns must be highlighted immediately; the rules for determining urgency are still to be agreed with the stakeholders.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialists" />
        <zeebe:formDefinition formId="triage-clinical-enquiry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_156</bpmn:incoming>
      <bpmn:outgoing>Flow_164</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="CNS_Bnd_UrgentOverdue" name="One hour" cancelActivity="false" attachedToRef="CNS_Task_TriageEnquiry">
      <bpmn:outgoing>Flow_165</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_005">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="CNS_GW_NeedsConsultant" name="Does this need a Consultant?" default="Flow_168">
      <bpmn:incoming>Flow_164</bpmn:incoming>
      <bpmn:outgoing>Flow_167</bpmn:outgoing>
      <bpmn:outgoing>Flow_168</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CNS_Auto_RecordAdvice" name="Record the advice given">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cns.record-clinical-advice" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_168</bpmn:incoming>
      <bpmn:incoming>Flow_169</bpmn:incoming>
      <bpmn:outgoing>Flow_170</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="CNS_Throw_UrgentEscalation" name="Escalate the unanswered urgent concern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="enquiry.urgent-escalated" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_165</bpmn:incoming>
      <bpmn:outgoing>Flow_166</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_007" messageRef="Message_enquiry_urgent_escalated" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_UrgentEscalated" name="Urgent concern escalated">
      <bpmn:incoming>Flow_166</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CON_Task_ClinicalReview" name="Provide the clinical review outcome">
