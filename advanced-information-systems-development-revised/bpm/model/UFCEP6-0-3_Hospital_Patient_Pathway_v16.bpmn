      <bpmn:outgoing>Flow_145</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ReminderIssued" name="Reminder issued">
      <bpmn:incoming>Flow_145</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ADM_Task_ContactConsultant" name="Contact the responsible Consultant">
