      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_172</bpmn:incoming>
      <bpmn:outgoing>Flow_173</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_GW_RefundDecision" name="What did Finance decide?" default="Flow_176">
