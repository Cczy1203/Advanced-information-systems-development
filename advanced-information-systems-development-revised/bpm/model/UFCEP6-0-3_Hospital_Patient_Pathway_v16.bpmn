      <bpmn:outgoing>Flow_174</bpmn:outgoing>
      <bpmn:outgoing>Flow_176</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_PrepareRefund" name="Prepare the approved refund">
