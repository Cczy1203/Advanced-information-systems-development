    <bpmn:sequenceFlow id="Flow_005" name="pack incomplete" sourceRef="SEC_GW_PackComplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_006" sourceRef="SEC_Bnd_PackIncomplete" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="SEC_Bnd_PackUnreadable" targetRef="SEC_Throw_InfoRequested" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="SEC_Throw_InfoRequested" targetRef="SEC_EGW_InfoRequest" />
    <bpmn:sequenceFlow id="Flow_009" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoReceived" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="SEC_EGW_InfoRequest" targetRef="SEC_Catch_InfoTimeout" />
    <bpmn:sequenceFlow id="Flow_011" sourceRef="SEC_Catch_InfoReceived" targetRef="SEC_Task_CheckPack" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="SEC_Catch_InfoTimeout" targetRef="End_InfoNotReceived" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="CON_Task_ReviewReferral" targetRef="CON_Auto_AuditDecision" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="CON_Auto_AuditDecision" targetRef="SEC_Task_NotifyReferrer" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="SEC_Task_NotifyReferrer" targetRef="SEC_Throw_OutcomeToReferrer" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="SEC_Throw_OutcomeToReferrer" targetRef="SEC_GW_Outcome" />
    <bpmn:sequenceFlow id="Flow_017" name="accepted" sourceRef="SEC_GW_Outcome" targetRef="OUT_Auto_CheckPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "ACCEPT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_018" name="not accepted" sourceRef="SEC_GW_Outcome" targetRef="End_ReferralNotAccepted" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="OUT_Auto_CheckPriority" targetRef="OUT_Auto_FindSlots" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="OUT_Auto_FindSlots" targetRef="OUT_GW_SlotsFound" />
    <bpmn:sequenceFlow id="Flow_021" name="options available" sourceRef="OUT_GW_SlotsFound" targetRef="OUT_Task_ChooseSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_022" name="nothing suitable" sourceRef="OUT_GW_SlotsFound" targetRef="OUT_Task_ReviewAvailability" />
    <bpmn:sequenceFlow id="Flow_023" sourceRef="OUT_Bnd_SchedulingUnavailable" targetRef="OUT_Task_ReviewAvailability" />
    <bpmn:sequenceFlow id="Flow_024" sourceRef="OUT_Task_ReviewAvailability" targetRef="OUT_GW_AvailabilityAction" />
    <bpmn:sequenceFlow id="Flow_025" name="search wider" sourceRef="OUT_GW_AvailabilityAction" targetRef="OUT_Auto_CheckPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= availabilityAction = "WIDEN_SEARCH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_026" name="escalate" sourceRef="OUT_GW_AvailabilityAction" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_027" sourceRef="OUT_Task_ChooseSlot" targetRef="OUT_Auto_CreateAppointment" />
    <bpmn:sequenceFlow id="Flow_028" sourceRef="OUT_Auto_CreateAppointment" targetRef="OUT_GW_NotifyChannels" />
    <bpmn:sequenceFlow id="Flow_029" name="letter always" sourceRef="OUT_GW_NotifyChannels" targetRef="OUT_Auto_DispatchAppointmentLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_030" name="call as well" sourceRef="OUT_GW_NotifyChannels" targetRef="CALL_Task_ContactPatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresPhoneCall = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_031" sourceRef="OUT_Auto_DispatchAppointmentLetter" targetRef="OUT_GW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="OUT_Bnd_LetterFailed" targetRef="OUT_Task_ChaseLetter" />
    <bpmn:sequenceFlow id="Flow_033" sourceRef="OUT_Task_ChaseLetter" targetRef="OUT_Auto_DispatchAppointmentLetter" />
    <bpmn:sequenceFlow id="Flow_034" sourceRef="CALL_Task_ContactPatient" targetRef="CALL_Auto_RecordContactAttempt" />
    <bpmn:sequenceFlow id="Flow_035" sourceRef="CALL_Auto_RecordContactAttempt" targetRef="OUT_GW_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_036" sourceRef="OUT_GW_NotifyJoin" targetRef="OUT_Task_RecordAttendance" />
    <bpmn:sequenceFlow id="Flow_037" sourceRef="OUT_Task_RecordAttendance" targetRef="CON_Task_RecordConsent" />
    <bpmn:sequenceFlow id="Flow_038" sourceRef="CON_Task_RecordConsent" targetRef="CON_GW_Consent" />
    <bpmn:sequenceFlow id="Flow_039" name="consent recorded" sourceRef="CON_GW_Consent" targetRef="CON_Auto_AuthoriseRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_040" name="not proceeding" sourceRef="CON_GW_Consent" targetRef="OUT_Task_RecordDecline" />
    <bpmn:sequenceFlow id="Flow_041" sourceRef="OUT_Task_RecordDecline" targetRef="End_TreatmentDeclined" />
    <bpmn:sequenceFlow id="Flow_042" sourceRef="CON_Auto_AuthoriseRequest" targetRef="CON_Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_043" sourceRef="CON_Task_DraftLetter" targetRef="CON_GW_LetterApproved" />
    <bpmn:sequenceFlow id="Flow_044" name="approved" sourceRef="CON_GW_LetterApproved" targetRef="SEC_Task_ProcessLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterApproved = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_045" name="not yet" sourceRef="CON_GW_LetterApproved" targetRef="CON_Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_046" sourceRef="CON_Bnd_LetterReminder" targetRef="CON_Auto_RecordReminder" />
    <bpmn:sequenceFlow id="Flow_047" sourceRef="CON_Auto_RecordReminder" targetRef="End_ReminderRecorded" />
    <bpmn:sequenceFlow id="Flow_048" sourceRef="CON_Bnd_LetterOverdue" targetRef="PCW_Auto_AddToMonitoring" />
    <bpmn:sequenceFlow id="Flow_049" sourceRef="PCW_Auto_AddToMonitoring" targetRef="End_LetterMonitoring" />
    <bpmn:sequenceFlow id="Flow_050" sourceRef="SEC_Task_ProcessLetter" targetRef="SEC_GW_LetterCheck" />
    <bpmn:sequenceFlow id="Flow_051" name="suspected clinical error" sourceRef="SEC_GW_LetterCheck" targetRef="CON_Task_CorrectLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalErrorSuspected = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_052" name="checks passed" sourceRef="SEC_GW_LetterCheck" targetRef="SEC_Auto_PrepareDispatch" />
    <bpmn:sequenceFlow id="Flow_053" sourceRef="SEC_Auto_PrepareDispatch" targetRef="SEC_Auto_DispatchClinicLetter" />
    <bpmn:sequenceFlow id="Flow_054" sourceRef="CON_Task_CorrectLetter" targetRef="SEC_Task_ProcessLetter" />
    <bpmn:sequenceFlow id="Flow_055" sourceRef="SEC_Auto_DispatchClinicLetter" targetRef="FIN_Task_DetermineFunding" />
    <bpmn:sequenceFlow id="Flow_056" sourceRef="FIN_Task_DetermineFunding" targetRef="FIN_Auto_AuditFunding" />
    <bpmn:sequenceFlow id="Flow_057" sourceRef="FIN_Auto_AuditFunding" targetRef="FIN_GW_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_058" name="funded or exempt" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "HOSPITAL_FUNDED" or fundingRoute = "INSURER_APPROVED" or fundingRoute = "EXEMPTION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_059" name="patient pays" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Auto_CalculateCharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "PATIENT_PAYS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_060" name="pre-auth outstanding" sourceRef="FIN_GW_FundingRoute" targetRef="FIN_Task_ChasePreAuthorisation" />
    <bpmn:sequenceFlow id="Flow_061" sourceRef="FIN_Task_ChasePreAuthorisation" targetRef="FIN_Auto_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_062" sourceRef="FIN_Bnd_FundingOverdue" targetRef="TRT_Task_ReviewFundingTimeout" />
    <bpmn:sequenceFlow id="Flow_063" sourceRef="TRT_Task_ReviewFundingTimeout" targetRef="FIN_Task_ChasePreAuthorisation" />
    <bpmn:sequenceFlow id="Flow_064" sourceRef="FIN_Auto_CalculateCharge" targetRef="FIN_Auto_PreparePayment" />
    <bpmn:sequenceFlow id="Flow_065" sourceRef="FIN_Bnd_ChargeFailed" targetRef="FIN_Task_ManualCharge" />
    <bpmn:sequenceFlow id="Flow_066" sourceRef="FIN_Task_ManualCharge" targetRef="FIN_Auto_PreparePayment" />
    <bpmn:sequenceFlow id="Flow_067" sourceRef="FIN_Auto_PreparePayment" targetRef="FIN_Auto_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_068" sourceRef="FIN_Auto_RecordApproval" targetRef="TRT_Auto_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_069" sourceRef="FIN_Auto_ProcessPayment" targetRef="FIN_GW_PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_070" sourceRef="FIN_Bnd_ConfirmationLost" targetRef="FIN_Task_InvestigatePayment" />
    <bpmn:sequenceFlow id="Flow_071" name="approved" sourceRef="FIN_GW_PaymentOutcome" targetRef="FIN_Auto_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_072" name="duplicate charge" sourceRef="FIN_GW_PaymentOutcome" targetRef="FIN_Auto_Deduplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "DUPLICATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_073" name="declined or cancelled" sourceRef="FIN_GW_PaymentOutcome" targetRef="TRT_Task_ReviewDeclinedPayment" />
    <bpmn:sequenceFlow id="Flow_074" sourceRef="FIN_Auto_RecordPayment" targetRef="TRT_Auto_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_075" sourceRef="FIN_Auto_Deduplicate" targetRef="TRT_Auto_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_076" sourceRef="TRT_Task_ReviewDeclinedPayment" targetRef="TRT_GW_DeclinedAction" />
    <bpmn:sequenceFlow id="Flow_077" name="try another payment" sourceRef="TRT_GW_DeclinedAction" targetRef="FIN_Auto_PreparePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= declinedAction = "RETRY_PAYMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_078" name="ask a clinician" sourceRef="TRT_GW_DeclinedAction" targetRef="CON_Task_AuthoriseUrgentTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= declinedAction = "SEEK_AUTHORISATION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_079" name="leave with Finance" sourceRef="TRT_GW_DeclinedAction" targetRef="FIN_Task_InvestigatePayment" />
    <bpmn:sequenceFlow id="Flow_080" sourceRef="CON_Task_AuthoriseUrgentTreatment" targetRef="CON_GW_UrgentAuthorised" />
    <bpmn:sequenceFlow id="Flow_081" name="clinician authorised" sourceRef="CON_GW_UrgentAuthorised" targetRef="TRT_Auto_ValidateRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentTreatmentAuthorised = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_082" name="not authorised" sourceRef="CON_GW_UrgentAuthorised" targetRef="FIN_Task_InvestigatePayment" />
    <bpmn:sequenceFlow id="Flow_083" sourceRef="FIN_Task_InvestigatePayment" targetRef="FIN_GW_InvestigationOutcome" />
    <bpmn:sequenceFlow id="Flow_084" name="money taken" sourceRef="FIN_GW_InvestigationOutcome" targetRef="FIN_Auto_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentFound = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_085" name="nothing was taken" sourceRef="FIN_GW_InvestigationOutcome" targetRef="End_PaymentUnresolved" />
    <bpmn:sequenceFlow id="Flow_086" sourceRef="TRT_Auto_ValidateRequest" targetRef="TRT_Auto_CreateSeries" />
    <bpmn:sequenceFlow id="Flow_087" sourceRef="TRT_Bnd_NotAuthorised" targetRef="End_RequestNotAuthorised" />
    <bpmn:sequenceFlow id="Flow_088" sourceRef="TRT_Auto_CreateSeries" targetRef="TRT_Auto_CheckExternalResources" />
    <bpmn:sequenceFlow id="Flow_089" sourceRef="TRT_Auto_CheckExternalResources" targetRef="TRT_GW_ExternalAvailable" />
    <bpmn:sequenceFlow id="Flow_090" sourceRef="TRT_Bnd_ExternalUnavailable" targetRef="TRT_Auto_RecordRetry" />
    <bpmn:sequenceFlow id="Flow_091" sourceRef="TRT_Auto_RecordRetry" targetRef="TRT_GW_CapacityCap" />
    <bpmn:sequenceFlow id="Flow_092" name="try again" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Auto_CheckExternalResources">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalResourceAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_093" name="release the series" sourceRef="TRT_GW_CapacityCap" targetRef="TRT_Auto_ReleaseSeries" />
    <bpmn:sequenceFlow id="Flow_094" sourceRef="TRT_Auto_ReleaseSeries" targetRef="End_BookingReleased" />
    <bpmn:sequenceFlow id="Flow_095" name="all resources held" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Auto_ConfirmAppointments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalResourcesAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_096" name="unavailable" sourceRef="TRT_GW_ExternalAvailable" targetRef="TRT_Auto_ReleaseSeries" />
    <bpmn:sequenceFlow id="Flow_097" sourceRef="TRT_Auto_ConfirmAppointments" targetRef="TRT_Auto_SendTreatmentLetter" />
    <bpmn:sequenceFlow id="Flow_098" sourceRef="TRT_Auto_SendTreatmentLetter" targetRef="TRT_Auto_ScheduleCycle" />
    <bpmn:sequenceFlow id="Flow_099" sourceRef="TRT_Auto_ScheduleCycle" targetRef="TRT_Auto_FindCycleSlots" />
    <bpmn:sequenceFlow id="Flow_100" sourceRef="TRT_Auto_FindCycleSlots" targetRef="TRT_GW_CycleSlots" />
    <bpmn:sequenceFlow id="Flow_101" name="slot found" sourceRef="TRT_GW_CycleSlots" targetRef="CON_Task_ReviewCycle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_102" name="nothing available" sourceRef="TRT_GW_CycleSlots" targetRef="TRT_Auto_ReleaseCycle" />
    <bpmn:sequenceFlow id="Flow_103" sourceRef="TRT_Auto_ReleaseCycle" targetRef="TRT_Task_RecordDelay" />
    <bpmn:sequenceFlow id="Flow_104" sourceRef="TRT_Task_RecordDelay" targetRef="TRT_Auto_ScheduleCycle" />
    <bpmn:sequenceFlow id="Flow_105" sourceRef="CON_Task_ReviewCycle" targetRef="CON_Auto_AuditCycle" />
    <bpmn:sequenceFlow id="Flow_106" sourceRef="CON_Auto_AuditCycle" targetRef="CON_GW_CycleOutcome" />
    <bpmn:sequenceFlow id="Flow_107" name="fit to continue" sourceRef="CON_GW_CycleOutcome" targetRef="TRT_GW_MoreCycles">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cycleReviewOutcome = "FIT_TO_CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_108" name="delay the cycle" sourceRef="CON_GW_CycleOutcome" targetRef="TRT_Task_RecordDelay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cycleReviewOutcome = "DELAY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_109" name="change the plan" sourceRef="CON_GW_CycleOutcome" targetRef="TRT_Throw_Compensate" />
    <bpmn:sequenceFlow id="Flow_110" sourceRef="TRT_Throw_Compensate" targetRef="TRT_Task_ReviewModification" />
    <bpmn:sequenceFlow id="Flow_111" name="more cycles" sourceRef="TRT_GW_MoreCycles" targetRef="TRT_Auto_ScheduleCycle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cycleNumber &lt; cycleCount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_112" name="course complete" sourceRef="TRT_GW_MoreCycles" targetRef="OUT_Auto_FindFollowUpSlots" />
    <bpmn:sequenceFlow id="Flow_113" sourceRef="TRT_Task_ReviewModification" targetRef="CON_Task_AuthoriseModification" />
    <bpmn:sequenceFlow id="Flow_114" sourceRef="CON_Task_AuthoriseModification" targetRef="CON_GW_ModificationAuthorised" />
    <bpmn:sequenceFlow id="Flow_115" name="authorised" sourceRef="CON_GW_ModificationAuthorised" targetRef="TRT_Auto_ApplyModification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= modificationAuthorised = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_116" name="not authorised" sourceRef="CON_GW_ModificationAuthorised" targetRef="End_ModificationRefused" />
    <bpmn:sequenceFlow id="Flow_117" sourceRef="TRT_Auto_ApplyModification" targetRef="TRT_GW_ModificationFinancial" />
    <bpmn:sequenceFlow id="Flow_118" name="money affected" sourceRef="TRT_GW_ModificationFinancial" targetRef="FIN_Task_ReviewImpact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= modificationAffectsFinance = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_119" name="no financial impact" sourceRef="TRT_GW_ModificationFinancial" targetRef="End_ModificationApplied" />
    <bpmn:sequenceFlow id="Flow_120" sourceRef="FIN_Task_ReviewImpact" targetRef="FIN_GW_ImpactAction" />
    <bpmn:sequenceFlow id="Flow_121" name="refund required" sourceRef="FIN_GW_ImpactAction" targetRef="FIN_Task_DecideRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= impactAction = "REFUND_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_122" name="no refund" sourceRef="FIN_GW_ImpactAction" targetRef="TRT_GW_MoreCycles" />
    <bpmn:sequenceFlow id="Flow_123" sourceRef="OUT_Auto_FindFollowUpSlots" targetRef="OUT_GW_FollowUpSlots" />
    <bpmn:sequenceFlow id="Flow_124" sourceRef="OUT_Bnd_FollowUpNoSlots" targetRef="OUT_GW_FollowUpSlots" />
    <bpmn:sequenceFlow id="Flow_125" name="inside the window" sourceRef="OUT_GW_FollowUpSlots" targetRef="OUT_Task_ConfirmFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_126" name="outside the window" sourceRef="OUT_GW_FollowUpSlots" targetRef="PCW_Task_ReviewDelay" />
    <bpmn:sequenceFlow id="Flow_127" sourceRef="OUT_Task_ConfirmFollowUp" targetRef="OUT_Auto_CreateFollowUp" />
    <bpmn:sequenceFlow id="Flow_128" sourceRef="OUT_Auto_CreateFollowUp" targetRef="OUT_Auto_SendFollowUpLetter" />
    <bpmn:sequenceFlow id="Flow_129" sourceRef="OUT_Auto_SendFollowUpLetter" targetRef="OUT_Task_DecideNextAction" />
    <bpmn:sequenceFlow id="Flow_130" sourceRef="OUT_Task_DecideNextAction" targetRef="OUT_Auto_RecordOutcome" />
    <bpmn:sequenceFlow id="Flow_131" sourceRef="OUT_Auto_RecordOutcome" targetRef="OUT_GW_OutcomeAction" />
    <bpmn:sequenceFlow id="Flow_132" name="offer another" sourceRef="OUT_GW_OutcomeAction" targetRef="OUT_Auto_FindRebookSlots">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cancellationAction = "REBOOK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_133" name="clinical review of the pathway" sourceRef="OUT_GW_OutcomeAction" targetRef="PCW_Task_ReviewDelay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cancellationAction = "CLINICAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_134" name="close pathway" sourceRef="OUT_GW_OutcomeAction" targetRef="OUT_Throw_ReferrerNotified" />
    <bpmn:sequenceFlow id="Flow_135" sourceRef="OUT_Throw_ReferrerNotified" targetRef="End_PathwayComplete" />
    <bpmn:sequenceFlow id="Flow_136" sourceRef="OUT_Bnd_RebookNoSlots" targetRef="End_CancellationHandled" />
    <bpmn:sequenceFlow id="Flow_137" sourceRef="OUT_Auto_FindRebookSlots" targetRef="End_Reoffered" />
    <bpmn:sequenceFlow id="Flow_138" sourceRef="PCW_Start_WeeklyReview" targetRef="PCW_Auto_FindOverdueLetters" />
    <bpmn:sequenceFlow id="Flow_139" sourceRef="PCW_Auto_FindOverdueLetters" targetRef="PCW_Task_ReviewOverdueList" />
    <bpmn:sequenceFlow id="Flow_140" sourceRef="PCW_Task_ReviewOverdueList" targetRef="PCW_GW_OverdueBand" />
    <bpmn:sequenceFlow id="Flow_141" name="1 week to 1 month" sourceRef="PCW_GW_OverdueBand" targetRef="PCW_Auto_SuppressDuplicates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueDays &lt;= 30</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_142" name="over one month" sourceRef="PCW_GW_OverdueBand" targetRef="ADM_Task_ContactConsultant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueDays &gt; 30 and letterOverdueDays &lt;= 90</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_143" name="over 3 months" sourceRef="PCW_GW_OverdueBand" targetRef="ADM_Task_ReferHigher" />
    <bpmn:sequenceFlow id="Flow_144" sourceRef="PCW_Auto_SuppressDuplicates" targetRef="PCW_Auto_SendReminder" />
    <bpmn:sequenceFlow id="Flow_145" sourceRef="PCW_Auto_SendReminder" targetRef="End_ReminderIssued" />
    <bpmn:sequenceFlow id="Flow_146" sourceRef="ADM_Task_ContactConsultant" targetRef="ADM_GW_ManagerOutcome" />
    <bpmn:sequenceFlow id="Flow_147" name="completed - close" sourceRef="ADM_GW_ManagerOutcome" targetRef="End_EscalationClosed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterNowCompleted = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_148" name="still outstanding" sourceRef="ADM_GW_ManagerOutcome" targetRef="ADM_Task_ReferHigher" />
    <bpmn:sequenceFlow id="Flow_149" sourceRef="ADM_Task_ReferHigher" targetRef="End_HigherEscalation" />
    <bpmn:sequenceFlow id="Flow_150" sourceRef="PCW_Task_ReviewDelay" targetRef="PCW_GW_DelayAction" />
    <bpmn:sequenceFlow id="Flow_151" name="search again" sourceRef="PCW_GW_DelayAction" targetRef="OUT_Auto_CheckPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= delayAction = "WIDEN_SEARCH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_152" name="inform the patient" sourceRef="PCW_GW_DelayAction" targetRef="PCW_Auto_SendDelayLetter" />
    <bpmn:sequenceFlow id="Flow_153" sourceRef="PCW_Auto_SendDelayLetter" targetRef="End_PatientInformed" />
    <bpmn:sequenceFlow id="Flow_154" sourceRef="Start_Enquiry" targetRef="CALL_Task_LogEnquiry" />
    <bpmn:sequenceFlow id="Flow_155" sourceRef="CALL_Task_LogEnquiry" targetRef="CALL_GW_Category" />
    <bpmn:sequenceFlow id="Flow_156" name="clinical" sourceRef="CALL_GW_Category" targetRef="CNS_Task_TriageEnquiry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryCategory = "CLINICAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_157" name="payment or funding" sourceRef="CALL_GW_Category" targetRef="FIN_Task_AnswerEnquiry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryCategory = "FINANCIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_158" name="administrative" sourceRef="CALL_GW_Category" targetRef="CALL_GW_Answerable" />
