<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_hospital_pathway_v16" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_referral_info_requested" name="referral.info-requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-referral-info&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_referral_info_received" name="referral.info-received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-referral-info&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_referral_outcome_sent" name="referral.outcome-sent">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-referral-outcome&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_letter_reminder" name="letter.reminder">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-letter-reminder&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_pathway_closed" name="pathway.closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-pathway&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_enquiry_received" name="enquiry.received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_enquiry_urgent_escalated" name="enquiry.urgent-escalated">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientRef + &#34;-enquiry-escalation&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_REFERRAL_PACK_INCOMPLETE" name="Referral pack failed the document checklist" errorCode="REFERRAL_PACK_INCOMPLETE" />
  <bpmn:error id="Error_REFERRAL_PACK_UNREADABLE" name="Referral documents could not be read" errorCode="REFERRAL_PACK_UNREADABLE" />
  <bpmn:error id="Error_SCHEDULING_SERVICE_UNAVAILABLE" name="External scheduling service unavailable" errorCode="SCHEDULING_SERVICE_UNAVAILABLE" />
  <bpmn:error id="Error_CORRESPONDENCE_SERVICE_FAILED" name="External correspondence service rejected the job" errorCode="CORRESPONDENCE_SERVICE_FAILED" />
  <bpmn:error id="Error_PAYMENT_PROVIDER_UNAVAILABLE" name="External payment provider unavailable" errorCode="PAYMENT_PROVIDER_UNAVAILABLE" />
  <bpmn:error id="Error_PAYMENT_CONFIRMATION_LOST" name="Payment taken but no confirmation returned" errorCode="PAYMENT_CONFIRMATION_LOST" />
  <bpmn:error id="Error_EXTERNAL_RESOURCE_UNAVAILABLE" name="External treatment or diagnostic resource unavailable" errorCode="EXTERNAL_RESOURCE_UNAVAILABLE" />
  <bpmn:error id="Error_TREATMENT_REQUEST_UNAUTHORISED" name="Treatment booking request is not authorised" errorCode="TREATMENT_REQUEST_UNAUTHORISED" />
  <bpmn:error id="Error_CHARGE_CALCULATION_FAILED" name="Applicable charge could not be calculated" errorCode="CHARGE_CALCULATION_FAILED" />
  <bpmn:error id="Error_INVALID_DATE" name="A recorded date is not allowed by the shared date rules" errorCode="INVALID_DATE" />
  <bpmn:collaboration id="Collaboration_HospitalPatientPathway">
    <bpmn:participant id="P_Hospital" name="Hospital Patient Referral, Treatment and Administration Service" processRef="hospital-patient-pathway" />
    <bpmn:participant id="P_Referrer" name="Referring organisation (GP or other hospital)" />
    <bpmn:participant id="P_Patient" name="Patient or authorised representative" />
    <bpmn:participant id="P_Scheduling" name="External scheduling service" />
    <bpmn:participant id="P_Correspondence" name="External correspondence service" />
    <bpmn:participant id="P_Payment" name="External payment service provider" />
    <bpmn:participant id="P_ClinicalServices" name="External treatment, laboratory and imaging services" />
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="P_Referrer" targetRef="SEC_Catch_InfoReceived" />
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="SEC_Throw_InfoRequested" targetRef="P_Referrer" />
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="SEC_Throw_OutcomeToReferrer" targetRef="P_Referrer" />
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="P_Patient" targetRef="Start_Enquiry" />
    <bpmn:messageFlow id="MessageFlow_05" sourceRef="OUT_Auto_DispatchAppointmentLetter" targetRef="P_Patient" />
    <bpmn:messageFlow id="MessageFlow_06" sourceRef="OUT_Auto_SendFollowUpLetter" targetRef="P_Patient" />
    <bpmn:messageFlow id="MessageFlow_07" sourceRef="OUT_Auto_FindSlots" targetRef="P_Scheduling" />
    <bpmn:messageFlow id="MessageFlow_08" sourceRef="P_Scheduling" targetRef="OUT_Auto_FindSlots" />
    <bpmn:messageFlow id="MessageFlow_09" sourceRef="OUT_Auto_DispatchAppointmentLetter" targetRef="P_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="SEC_Auto_DispatchClinicLetter" targetRef="P_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_11" sourceRef="FIN_Auto_PreparePayment" targetRef="P_Payment" />
    <bpmn:messageFlow id="MessageFlow_12" sourceRef="P_Payment" targetRef="FIN_Auto_ProcessPayment" />
    <bpmn:messageFlow id="MessageFlow_13" sourceRef="FIN_Auto_ProcessRefund" targetRef="P_Payment" />
    <bpmn:messageFlow id="MessageFlow_14" sourceRef="TRT_Auto_CheckExternalResources" targetRef="P_ClinicalServices" />
    <bpmn:messageFlow id="MessageFlow_15" sourceRef="P_ClinicalServices" targetRef="TRT_Auto_CheckExternalResources" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-patient-pathway" name="Hospital Patient Referral, Treatment and Administration Service" isExecutable="true">
    <bpmn:documentation>The hospital's operational patient pathway, drawn as one pool because one organisation owns it end to end. Lanes separate responsibility, not ownership: clinical decisions belong to Consultants and the Clinical Nurse Specialist Team, administrative work to Medical Secretaries, the booking teams, Call Handling, the Patient Pathway Coordinators and the Administrative Management Team, and money to the Finance Team. An activity in one lane may not be performed by another: clinical staff do not approve refunds, administrative staff do not judge clinical suitability, and the Finance Team does not decide clinical need. Steps that an external worker performs are service tasks; steps that need a person and a form are user tasks.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="16.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="hospital-patient-pathway_lanes">
      <bpmn:lane id="hospital-patient-pathway_P0" name="Clinical responsibility">
        <bpmn:childLaneSet id="hospital-patient-pathway_P0_child">
          <bpmn:lane id="hospital-patient-pathway_L6" name="Consultants">
            <bpmn:flowNodeRef>CON_Task_ReviewReferral</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Auto_AuditDecision</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_RecordConsent</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_GW_Consent</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Auto_AuthoriseRequest</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_DraftLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Auto_RecordReminder</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_ReminderRecorded</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_GW_LetterApproved</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_CorrectLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_GW_UrgentAuthorised</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_ReviewCycle</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Auto_AuditCycle</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_GW_CycleOutcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_AuthoriseModification</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_GW_ModificationAuthorised</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CON_Task_ClinicalReview</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L7" name="Clinical Nurse Specialist Team">
            <bpmn:flowNodeRef>CNS_Task_TriageEnquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CNS_GW_NeedsConsultant</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CNS_Auto_RecordAdvice</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CNS_Throw_UrgentEscalation</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_UrgentEscalated</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="hospital-patient-pathway_P1" name="Administrative responsibility">
        <bpmn:flowNodeRef>End_CancellationHandled</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="hospital-patient-pathway_P1_child">
          <bpmn:lane id="hospital-patient-pathway_L0" name="Medical Secretaries">
            <bpmn:flowNodeRef>Start_Referral</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Task_CheckPack</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Auto_ValidateDocuments</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_GW_PackComplete</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Throw_InfoRequested</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_EGW_InfoRequest</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Catch_InfoReceived</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Catch_InfoTimeout</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_InfoNotReceived</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Task_NotifyReferrer</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Throw_OutcomeToReferrer</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_GW_Outcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_ReferralNotAccepted</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Task_ProcessLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_GW_LetterCheck</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Auto_PrepareDispatch</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SEC_Auto_DispatchClinicLetter</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L1" name="Outpatient Bookings Team">
            <bpmn:flowNodeRef>OUT_Auto_CheckPriority</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_FindSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_SlotsFound</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_ReviewAvailability</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_AvailabilityAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_ChooseSlot</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_CreateAppointment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_NotifyChannels</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_DispatchAppointmentLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_ChaseLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_NotifyJoin</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_RecordAttendance</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_RecordDecline</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_TreatmentDeclined</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_FindFollowUpSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_FollowUpSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_ConfirmFollowUp</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_CreateFollowUp</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_SendFollowUpLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_DecideNextAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_RecordOutcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_GW_OutcomeAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Auto_FindRebookSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_Reoffered</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Throw_ReferrerNotified</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_PathwayComplete</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>OUT_Task_AnswerAdminEnquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_CancellationHandled</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L2" name="Treatment and Chemotherapy Bookings Team">
            <bpmn:flowNodeRef>TRT_Task_ReviewFundingTimeout</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Task_ReviewDeclinedPayment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_DeclinedAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ValidateRequest</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_RequestNotAuthorised</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_CreateSeries</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_CheckExternalResources</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_RecordRetry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_CapacityCap</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_ExternalAvailable</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ConfirmAppointments</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Comp_ReleaseSeries</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Throw_Compensate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ReleaseSeries</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_BookingReleased</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_SendTreatmentLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ScheduleCycle</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_FindCycleSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_CycleSlots</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ReleaseCycle</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Task_RecordDelay</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_MoreCycles</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Task_ReviewModification</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_ModificationRefused</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_Auto_ApplyModification</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>TRT_GW_ModificationFinancial</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_ModificationApplied</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L3" name="Call Handling Team">
            <bpmn:flowNodeRef>CALL_Task_ContactPatient</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_Auto_RecordContactAttempt</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Start_Enquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_Task_LogEnquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_GW_Category</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_GW_Answerable</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_Task_AnswerAdmin</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>CALL_Auto_CloseEnquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_EnquiryResolved</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L4" name="Patient Pathway Coordinators">
            <bpmn:flowNodeRef>PCW_Auto_AddToMonitoring</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_LetterMonitoring</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Start_WeeklyReview</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Auto_FindOverdueLetters</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Task_ReviewOverdueList</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_GW_OverdueBand</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Auto_SuppressDuplicates</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Auto_SendReminder</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_ReminderIssued</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Task_ReviewDelay</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_GW_DelayAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>PCW_Auto_SendDelayLetter</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_PatientInformed</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="hospital-patient-pathway_L5" name="Administrative Management Team">
            <bpmn:flowNodeRef>ADM_Task_ContactConsultant</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ADM_GW_ManagerOutcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_EscalationClosed</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ADM_Task_ReferHigher</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_HigherEscalation</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="hospital-patient-pathway_P2" name="Financial responsibility">
        <bpmn:flowNodeRef>End_NoRefundDue</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="hospital-patient-pathway_P2_child">
          <bpmn:lane id="hospital-patient-pathway_L8" name="Finance Team">
            <bpmn:flowNodeRef>FIN_Task_DetermineFunding</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_AuditFunding</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_GW_FundingRoute</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_ChasePreAuthorisation</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_CalculateCharge</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_RecordApproval</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_PreparePayment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_ManualCharge</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_ProcessPayment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_GW_PaymentOutcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_RecordPayment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_Deduplicate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_InvestigatePayment</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_GW_InvestigationOutcome</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_PaymentUnresolved</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_AnswerEnquiry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_ReviewImpact</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_GW_ImpactAction</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Task_DecideRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_AuditRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_GW_RefundDecision</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_PrepareRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_ProcessRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_RecordNoRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_RefundPending</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>FIN_Auto_RecordRefund</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_RefundRecorded</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_NoRefundDue</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Referral" name="Referral received">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="SEC_Task_CheckPack" name="Check the referral pack against the document checklist">
      <bpmn:documentation>Captures what arrived and what is missing. The task never records a view on whether the referral is clinically appropriate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="check-referral-pack" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:incoming>Flow_181</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SEC_Auto_ValidateDocuments" name="Validate the supporting documents">
      <bpmn:documentation>Checks the pack against the document checklist and raises REFERRAL_PACK_INCOMPLETE rather than letting an incomplete pack reach a Consultant.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.check-supporting-documents" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="SEC_Bnd_PackIncomplete" name="incomplete" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_001" errorRef="Error_REFERRAL_PACK_INCOMPLETE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="SEC_Bnd_PackUnreadable" name="unreadable" attachedToRef="SEC_Auto_ValidateDocuments">
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_002" errorRef="Error_REFERRAL_PACK_UNREADABLE" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="SEC_GW_PackComplete" name="Is the referral pack complete?" default="Flow_005">
      <bpmn:documentation>The only route to a clinical decision is a complete pack.</bpmn:documentation>
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="SEC_Throw_InfoRequested" name="Ask the referring organisation for what is missing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.info-requested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_001" messageRef="Message_referral_info_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="SEC_EGW_InfoRequest" name="Waiting for the missing information">
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoReceived" name="Information received">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_002" messageRef="Message_referral_info_received" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="SEC_Catch_InfoTimeout" name="No response after 14 days">
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_001">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_InfoNotReceived" name="Referral closed - information not received">
      <bpmn:incoming>Flow_012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CON_Task_ReviewReferral" name="Review the referral and record the clinical decision">
      <bpmn:documentation>The decision is accept, reject, redirect or request further detail. Only an authorised Consultant may accept a referral, and an appointment may not be arranged before that acceptance.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="review-referral" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:incoming>Flow_182</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_Auto_AuditDecision" name="Write the clinical decision to the audit trail">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-clinical-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="SEC_Task_NotifyReferrer" name="Record the decision and notify the referring organisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="notify-referrer-outcome" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="SEC_Throw_OutcomeToReferrer" name="Return the decision and the reason">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="referral.outcome-sent" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_003" messageRef="Message_referral_outcome_sent" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="SEC_GW_Outcome" name="Was the referral accepted?" default="Flow_018">
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ReferralNotAccepted" name="Referral not accepted or redirected; referrer informed">
      <bpmn:incoming>Flow_018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="OUT_Auto_CheckPriority" name="Work out the speciality, priority and contact rule">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.check-priority-and-contact-rule" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:incoming>Flow_025</bpmn:incoming>
      <bpmn:incoming>Flow_151</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OUT_Auto_FindSlots" name="Search the external scheduling service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OUT_Bnd_SchedulingUnavailable" name="Scheduling service unavailable" attachedToRef="OUT_Auto_FindSlots">
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_003" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="OUT_GW_SlotsFound" name="Did the service return anything usable?" default="Flow_022">
      <bpmn:incoming>Flow_020</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OUT_Task_ReviewAvailability" name="Decide what to do without a suitable slot">
      <bpmn:documentation>Urgent referrals that cannot wait for the normal administrative timescale, and requests with no slot in the clinically requested period, are escalated rather than booked outside the window.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="review-appointment-availability" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_022</bpmn:incoming>
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:incoming>Flow_191</bpmn:incoming>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="OUT_GW_AvailabilityAction" name="How should the booking gap be handled?" default="Flow_026">
      <bpmn:incoming>Flow_024</bpmn:incoming>
      <bpmn:outgoing>Flow_025</bpmn:outgoing>
      <bpmn:outgoing>Flow_026</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OUT_Task_ChooseSlot" name="Choose and confirm the appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="choose-appointment-slot" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:incoming>Flow_189</bpmn:incoming>
      <bpmn:outgoing>Flow_027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OUT_Auto_CreateAppointment" name="Create the appointment record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.create-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_027</bpmn:incoming>
      <bpmn:outgoing>Flow_028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="OUT_GW_NotifyChannels" name="Which contacts does this patient need?">
      <bpmn:documentation>The letter always goes; a telephone call is added when the appointment is inside two weeks.</bpmn:documentation>
      <bpmn:incoming>Flow_028</bpmn:incoming>
      <bpmn:outgoing>Flow_029</bpmn:outgoing>
      <bpmn:outgoing>Flow_030</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="OUT_Auto_DispatchAppointmentLetter" name="Send the appointment letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_029</bpmn:incoming>
      <bpmn:incoming>Flow_033</bpmn:incoming>
      <bpmn:outgoing>Flow_031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OUT_Bnd_LetterFailed" name="Rejected by the correspondence service" attachedToRef="OUT_Auto_DispatchAppointmentLetter">
      <bpmn:outgoing>Flow_032</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_004" errorRef="Error_CORRESPONDENCE_SERVICE_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="OUT_Task_ChaseLetter" name="Resolve the distribution problem and pick another channel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="resolve-dispatch-problem" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_032</bpmn:incoming>
      <bpmn:outgoing>Flow_033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CALL_Task_ContactPatient" name="Telephone the patient about the appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="call-handling" />
        <zeebe:formDefinition formId="record-telephone-contact-attempt" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_030</bpmn:incoming>
      <bpmn:incoming>Flow_193</bpmn:incoming>
      <bpmn:outgoing>Flow_034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CALL_Auto_RecordContactAttempt" name="Record the contact attempt and its outcome">
      <bpmn:documentation>Every attempt and its outcome is recorded, so a patient who cannot be reached is visible on the pathway rather than silently un-notified.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enquiry.record-contact-attempt" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_034</bpmn:incoming>
      <bpmn:outgoing>Flow_035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="OUT_GW_NotifyJoin" name="Patient notification complete">
      <bpmn:incoming>Flow_031</bpmn:incoming>
      <bpmn:incoming>Flow_035</bpmn:incoming>
      <bpmn:outgoing>Flow_036</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="OUT_Task_RecordAttendance" name="Record the patient&#39;s attendance at the new patient appointment">
      <bpmn:documentation>The patient came in. This records when and who marked them in, so the consultant on the next task is recording consent for an appointment that demonstrably took place. No clinical view is taken here.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="record-attendance" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_036</bpmn:incoming>
      <bpmn:outgoing>Flow_037</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CON_Task_RecordConsent" name="Record consent and complete the treatment booking request">
      <bpmn:documentation>Records the proposed treatment, the start date, the number and frequency of cycles, the reviews between cycles and any special resource the treatment needs.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="record-consent-and-treatment-request" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_037</bpmn:incoming>
      <bpmn:incoming>Flow_188</bpmn:incoming>
      <bpmn:outgoing>Flow_038</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_GW_Consent" name="Has the patient agreed to proceed?" default="Flow_040">
      <bpmn:incoming>Flow_038</bpmn:incoming>
      <bpmn:outgoing>Flow_039</bpmn:outgoing>
      <bpmn:outgoing>Flow_040</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CON_Auto_AuthoriseRequest" name="Authorise the treatment booking request">
      <bpmn:documentation>A request that an appropriate clinical professional has not authorised must not be processed by administrative staff.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.authorise-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_039</bpmn:incoming>
      <bpmn:outgoing>Flow_042</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="OUT_Task_RecordDecline" name="Record the decline and arrange clinical follow-up">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="record-treatment-decline" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_040</bpmn:incoming>
      <bpmn:outgoing>Flow_041</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_TreatmentDeclined" name="Patient does not proceed with treatment">
      <bpmn:incoming>Flow_041</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CON_Task_DraftLetter" name="Draft and approve the clinic letter">
      <bpmn:documentation>Every consultation produces a clinic letter. The first is the New Patient Clinic Letter and it must be completed, approved, processed and sent within seven days.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="draft-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_042</bpmn:incoming>
      <bpmn:incoming>Flow_045</bpmn:incoming>
      <bpmn:outgoing>Flow_043</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="CON_Bnd_LetterReminder" name="reminder" cancelActivity="false" attachedToRef="CON_Task_DraftLetter">
      <bpmn:outgoing>Flow_046</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_004" messageRef="Message_letter_reminder" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="CON_Bnd_LetterOverdue" name="day 7" cancelActivity="false" attachedToRef="CON_Task_DraftLetter">
      <bpmn:outgoing>Flow_048</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_002">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="CON_Auto_RecordReminder" name="Record the reminder against the letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="letter.record-reminder" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_046</bpmn:incoming>
      <bpmn:outgoing>Flow_047</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ReminderRecorded" name="Reminder recorded">
      <bpmn:incoming>Flow_047</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PCW_Auto_AddToMonitoring" name="Add the letter to pathway monitoring">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pathway.add-to-monitoring" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_048</bpmn:incoming>
      <bpmn:outgoing>Flow_049</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_LetterMonitoring" name="Letter under pathway monitoring">
      <bpmn:incoming>Flow_049</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CON_GW_LetterApproved" name="Has the Consultant approved the letter?" default="Flow_045">
      <bpmn:incoming>Flow_043</bpmn:incoming>
      <bpmn:outgoing>Flow_044</bpmn:outgoing>
      <bpmn:outgoing>Flow_045</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="SEC_Task_ProcessLetter" name="Check and process the approved clinic letter">
      <bpmn:documentation>Confirms the recipients and arranges distribution, may correct formatting and clear administrative errors, and must not change the clinical meaning.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="process-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_044</bpmn:incoming>
      <bpmn:incoming>Flow_054</bpmn:incoming>
      <bpmn:outgoing>Flow_050</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SEC_GW_LetterCheck" name="Does the letter need a clinical correction?" default="Flow_052">
      <bpmn:documentation>A suspected clinical error goes back to the Consultant rather than being corrected administratively.</bpmn:documentation>
      <bpmn:incoming>Flow_050</bpmn:incoming>
      <bpmn:outgoing>Flow_051</bpmn:outgoing>
      <bpmn:outgoing>Flow_052</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_Task_CorrectLetter" name="Correct and re-approve the clinic letter">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="correct-clinic-letter" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_051</bpmn:incoming>
      <bpmn:outgoing>Flow_054</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SEC_Auto_PrepareDispatch" name="Prepare the letter for dispatch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.prepare-dispatch" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_052</bpmn:incoming>
      <bpmn:outgoing>Flow_053</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SEC_Auto_DispatchClinicLetter" name="Dispatch the approved clinic letter">
      <bpmn:documentation>Records the drafting, approval, processing and distribution dates for the letter.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_053</bpmn:incoming>
      <bpmn:outgoing>Flow_055</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="FIN_Task_DetermineFunding" name="Establish the funding route and record the authorisation">
      <bpmn:documentation>Records the funding organisation, the authorisation reference, the approved amount and any limitation. The Finance Team does not decide clinical need.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="determine-funding-route" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_055</bpmn:incoming>
      <bpmn:incoming>Flow_186</bpmn:incoming>
      <bpmn:outgoing>Flow_056</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="FIN_Bnd_FundingOverdue" name="Authorisation still outstanding" cancelActivity="false" attachedToRef="FIN_Task_DetermineFunding">
      <bpmn:outgoing>Flow_062</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_003">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="FIN_Auto_AuditFunding" name="Record the funding decision for audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-financial-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_056</bpmn:incoming>
      <bpmn:outgoing>Flow_057</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TRT_Task_ReviewFundingTimeout" name="Chase the outstanding funding approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="chase-funding-approval" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_062</bpmn:incoming>
      <bpmn:outgoing>Flow_063</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FIN_GW_FundingRoute" name="Which funding route applies?" default="Flow_060">
      <bpmn:incoming>Flow_057</bpmn:incoming>
      <bpmn:outgoing>Flow_058</bpmn:outgoing>
      <bpmn:outgoing>Flow_059</bpmn:outgoing>
      <bpmn:outgoing>Flow_060</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="FIN_Task_ChasePreAuthorisation" name="Chase the insurer for pre-authorisation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="chase-pre-authorisation" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_060</bpmn:incoming>
      <bpmn:incoming>Flow_063</bpmn:incoming>
      <bpmn:outgoing>Flow_061</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_CalculateCharge" name="Work out the charge payable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.calculate-charge" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_059</bpmn:incoming>
      <bpmn:outgoing>Flow_064</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="FIN_Bnd_ChargeFailed" name="Pricing failed" attachedToRef="FIN_Auto_CalculateCharge">
      <bpmn:outgoing>Flow_065</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_005" errorRef="Error_CHARGE_CALCULATION_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="FIN_Auto_RecordApproval" name="Record the funding approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-funding-approval" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_058</bpmn:incoming>
      <bpmn:incoming>Flow_061</bpmn:incoming>
      <bpmn:outgoing>Flow_068</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_Auto_PreparePayment" name="Prepare the secure payment request">
      <bpmn:documentation>Complete card details are never stored by the hospital.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.prepare-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_064</bpmn:incoming>
      <bpmn:incoming>Flow_066</bpmn:incoming>
      <bpmn:incoming>Flow_077</bpmn:incoming>
      <bpmn:outgoing>Flow_067</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="FIN_Task_ManualCharge" name="Price the treatment manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="manual-charge-entry" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_065</bpmn:incoming>
      <bpmn:outgoing>Flow_066</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_Auto_ProcessPayment" name="Take the payment through the provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-transaction" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_067</bpmn:incoming>
      <bpmn:outgoing>Flow_069</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="FIN_Bnd_ConfirmationLost" name="No confirmation returned" attachedToRef="FIN_Auto_ProcessPayment">
      <bpmn:outgoing>Flow_070</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_006" errorRef="Error_PAYMENT_CONFIRMATION_LOST" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="FIN_GW_PaymentOutcome" name="What did the provider report?" default="Flow_073">
      <bpmn:incoming>Flow_069</bpmn:incoming>
      <bpmn:outgoing>Flow_071</bpmn:outgoing>
      <bpmn:outgoing>Flow_072</bpmn:outgoing>
      <bpmn:outgoing>Flow_073</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_Auto_RecordPayment" name="Record the payment against the account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.record-payment-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_071</bpmn:incoming>
      <bpmn:incoming>Flow_084</bpmn:incoming>
      <bpmn:outgoing>Flow_074</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_Auto_Deduplicate" name="Check the charge has not already been taken">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finance.check-duplicate-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_072</bpmn:incoming>
      <bpmn:outgoing>Flow_075</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TRT_Task_ReviewDeclinedPayment" name="Decide how to handle the failed payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-declined-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_073</bpmn:incoming>
      <bpmn:outgoing>Flow_076</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FIN_Task_InvestigatePayment" name="Investigate the unconfirmed payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
        <zeebe:formDefinition formId="investigate-unconfirmed-payment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_070</bpmn:incoming>
      <bpmn:incoming>Flow_079</bpmn:incoming>
      <bpmn:incoming>Flow_082</bpmn:incoming>
      <bpmn:outgoing>Flow_083</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TRT_GW_DeclinedAction" name="Try again, ask a clinician, or leave it with Finance?" default="Flow_079">
      <bpmn:incoming>Flow_076</bpmn:incoming>
      <bpmn:outgoing>Flow_077</bpmn:outgoing>
      <bpmn:outgoing>Flow_078</bpmn:outgoing>
      <bpmn:outgoing>Flow_079</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="FIN_GW_InvestigationOutcome" name="Was the money actually taken?" default="Flow_085">
      <bpmn:incoming>Flow_083</bpmn:incoming>
      <bpmn:outgoing>Flow_084</bpmn:outgoing>
      <bpmn:outgoing>Flow_085</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CON_Task_AuthoriseUrgentTreatment" name="Authorise urgent treatment without confirmed payment">
      <bpmn:documentation>The only way treatment may start without a recorded payment, funding approval or exemption.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="authorise-urgent-treatment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_078</bpmn:incoming>
      <bpmn:outgoing>Flow_080</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_GW_UrgentAuthorised" name="May treatment go ahead unconfirmed?" default="Flow_082">
      <bpmn:incoming>Flow_080</bpmn:incoming>
      <bpmn:outgoing>Flow_081</bpmn:outgoing>
      <bpmn:outgoing>Flow_082</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_PaymentUnresolved" name="Payment unresolved; booking not confirmed">
      <bpmn:incoming>Flow_085</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_ValidateRequest" name="Check the request is complete and authorised">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.validate-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_068</bpmn:incoming>
      <bpmn:incoming>Flow_074</bpmn:incoming>
      <bpmn:incoming>Flow_075</bpmn:incoming>
      <bpmn:incoming>Flow_081</bpmn:incoming>
      <bpmn:outgoing>Flow_086</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="TRT_Bnd_NotAuthorised" name="Not authorised" attachedToRef="TRT_Auto_ValidateRequest">
      <bpmn:outgoing>Flow_087</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_007" errorRef="Error_TREATMENT_REQUEST_UNAUTHORISED" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_RequestNotAuthorised" name="Request returned to the clinical team for authorisation">
      <bpmn:incoming>Flow_087</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_CreateSeries" name="Create the provisional appointment series">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.create-appointment-series" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_086</bpmn:incoming>
      <bpmn:outgoing>Flow_088</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_CheckExternalResources" name="Check external treatment and diagnostic capacity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="external-resources.check-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_088</bpmn:incoming>
      <bpmn:incoming>Flow_092</bpmn:incoming>
      <bpmn:outgoing>Flow_089</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="TRT_Bnd_ExternalUnavailable" name="Capacity unavailable" attachedToRef="TRT_Auto_CheckExternalResources">
      <bpmn:outgoing>Flow_090</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_008" errorRef="Error_EXTERNAL_RESOURCE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="TRT_Auto_RecordRetry" name="Record another capacity attempt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.record-capacity-retry" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_090</bpmn:incoming>
      <bpmn:outgoing>Flow_091</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CapacityCap" name="Have we tried long enough?" default="Flow_093">
      <bpmn:documentation>A capped retry: three attempts, then release what was provisionally held rather than leaving it committed.</bpmn:documentation>
      <bpmn:incoming>Flow_091</bpmn:incoming>
      <bpmn:outgoing>Flow_092</bpmn:outgoing>
      <bpmn:outgoing>Flow_093</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="TRT_GW_ExternalAvailable" name="Is everything available?" default="Flow_096">
      <bpmn:incoming>Flow_089</bpmn:incoming>
      <bpmn:outgoing>Flow_095</bpmn:outgoing>
      <bpmn:outgoing>Flow_096</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_ConfirmAppointments" name="Confirm the treatment appointments">
      <bpmn:documentation>Committing the series is the point of no return: from here the appointments are held against the hospital's capacity, so the activity carries a compensation handler that gives them back.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.confirm-appointments" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_095</bpmn:incoming>
      <bpmn:outgoing>Flow_097</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="TRT_Bnd_CompSeries" name="series committed" attachedToRef="TRT_Auto_ConfirmAppointments">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_001" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="TRT_Comp_ReleaseSeries" name="Release the confirmed series (compensation)" isForCompensation="true">
      <bpmn:documentation>Compensation handler. Has no incoming sequence flow: the engine reaches it only when something throws compensation for the confirmed series.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-series" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="TRT_Throw_Compensate" name="Give back the appointments already held">
      <bpmn:incoming>Flow_109</bpmn:incoming>
      <bpmn:outgoing>Flow_110</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_002" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="TRT_Auto_ReleaseSeries" name="Release the provisional series">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-series" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_093</bpmn:incoming>
      <bpmn:incoming>Flow_096</bpmn:incoming>
      <bpmn:outgoing>Flow_094</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_BookingReleased" name="Provisional series released; no capacity held">
      <bpmn:incoming>Flow_094</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_SendTreatmentLetter" name="Send the treatment confirmation letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_097</bpmn:incoming>
      <bpmn:outgoing>Flow_098</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_ScheduleCycle" name="Schedule the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.schedule-next-cycle" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="=nextCycleNumber" target="cycleNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_098</bpmn:incoming>
      <bpmn:incoming>Flow_104</bpmn:incoming>
      <bpmn:incoming>Flow_111</bpmn:incoming>
      <bpmn:outgoing>Flow_099</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TRT_Auto_FindCycleSlots" name="Look for a slot for the next cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_099</bpmn:incoming>
      <bpmn:outgoing>Flow_100</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_CycleSlots" name="Was a cycle slot found?" default="Flow_102">
      <bpmn:incoming>Flow_100</bpmn:incoming>
      <bpmn:outgoing>Flow_101</bpmn:outgoing>
      <bpmn:outgoing>Flow_102</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TRT_Auto_ReleaseCycle" name="Release the provisional cycle slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.release-cycle-booking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_102</bpmn:incoming>
      <bpmn:outgoing>Flow_103</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TRT_Task_RecordDelay" name="Record the delay and re-plan the cycle">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="record-cycle-delay" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_103</bpmn:incoming>
      <bpmn:incoming>Flow_108</bpmn:incoming>
      <bpmn:incoming>Flow_192</bpmn:incoming>
      <bpmn:outgoing>Flow_104</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CON_Task_ReviewCycle" name="Review the blood results and decide on the next cycle">
      <bpmn:documentation>A patient receiving several cycles is reviewed before each subsequent cycle to decide whether to continue, delay or change the plan.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="review-chemotherapy-cycle" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_101</bpmn:incoming>
      <bpmn:incoming>Flow_184</bpmn:incoming>
      <bpmn:outgoing>Flow_105</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CON_Auto_AuditCycle" name="Record the cycle review decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit.record-clinical-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_105</bpmn:incoming>
      <bpmn:outgoing>Flow_106</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CON_GW_CycleOutcome" name="Is the patient fit to continue?" default="Flow_109">
      <bpmn:incoming>Flow_106</bpmn:incoming>
      <bpmn:outgoing>Flow_107</bpmn:outgoing>
      <bpmn:outgoing>Flow_108</bpmn:outgoing>
      <bpmn:outgoing>Flow_109</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="TRT_GW_MoreCycles" name="Are there further cycles in this course?" default="Flow_112">
      <bpmn:incoming>Flow_107</bpmn:incoming>
      <bpmn:incoming>Flow_122</bpmn:incoming>
      <bpmn:outgoing>Flow_111</bpmn:outgoing>
      <bpmn:outgoing>Flow_112</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TRT_Task_ReviewModification" name="Review the treatment change request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
        <zeebe:formDefinition formId="review-treatment-change" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_110</bpmn:incoming>
      <bpmn:outgoing>Flow_113</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CON_Task_AuthoriseModification" name="Authorise the treatment modification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="authorise-treatment-modification" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_113</bpmn:incoming>
      <bpmn:incoming>Flow_187</bpmn:incoming>
      <bpmn:outgoing>Flow_114</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CON_GW_ModificationAuthorised" name="Has the Consultant authorised the change?" default="Flow_116">
      <bpmn:incoming>Flow_114</bpmn:incoming>
      <bpmn:outgoing>Flow_115</bpmn:outgoing>
      <bpmn:outgoing>Flow_116</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ModificationRefused" name="Change not authorised; schedule unchanged">
      <bpmn:incoming>Flow_116</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TRT_Auto_ApplyModification" name="Apply the treatment change to the schedule">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.apply-modification" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_115</bpmn:incoming>
      <bpmn:outgoing>Flow_117</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TRT_GW_ModificationFinancial" name="Does the change affect money already handled?" default="Flow_119">
      <bpmn:incoming>Flow_117</bpmn:incoming>
      <bpmn:outgoing>Flow_118</bpmn:outgoing>
      <bpmn:outgoing>Flow_119</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ModificationApplied" name="Treatment change applied">
      <bpmn:incoming>Flow_119</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="OUT_Auto_FindFollowUpSlots" name="Look for a follow-up slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_112</bpmn:incoming>
      <bpmn:outgoing>Flow_123</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OUT_Bnd_FollowUpNoSlots" name="No slot in the clinical window" attachedToRef="OUT_Auto_FindFollowUpSlots">
      <bpmn:outgoing>Flow_124</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_009" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="OUT_GW_FollowUpSlots" name="Was a follow-up slot found inside the window?" default="Flow_126">
      <bpmn:incoming>Flow_123</bpmn:incoming>
      <bpmn:incoming>Flow_124</bpmn:incoming>
      <bpmn:outgoing>Flow_125</bpmn:outgoing>
      <bpmn:outgoing>Flow_126</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OUT_Task_ConfirmFollowUp" name="Confirm the follow-up appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="confirm-follow-up-appointment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_125</bpmn:incoming>
      <bpmn:incoming>Flow_190</bpmn:incoming>
      <bpmn:outgoing>Flow_127</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OUT_Auto_CreateFollowUp" name="Create the follow-up appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.create-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_127</bpmn:incoming>
      <bpmn:outgoing>Flow_128</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OUT_Auto_SendFollowUpLetter" name="Tell the patient about the follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_128</bpmn:incoming>
      <bpmn:outgoing>Flow_129</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="OUT_Task_DecideNextAction" name="Decide whether another appointment is offered">
      <bpmn:documentation>Cancellations, declines and non-attendance are recorded and a decision is taken on offering another appointment, reviewing the pathway or informing the referring organisation. Continuing, delaying or ending treatment stays with authorised clinical professionals.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        <zeebe:formDefinition formId="decide-cancellation-action" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_129</bpmn:incoming>
      <bpmn:outgoing>Flow_130</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OUT_Auto_RecordOutcome" name="Record the appointment outcome">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking.record-appointment-outcome" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_130</bpmn:incoming>
      <bpmn:outgoing>Flow_131</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OUT_GW_OutcomeAction" name="What happens after the appointment?" default="Flow_134">
      <bpmn:incoming>Flow_131</bpmn:incoming>
      <bpmn:outgoing>Flow_132</bpmn:outgoing>
      <bpmn:outgoing>Flow_133</bpmn:outgoing>
      <bpmn:outgoing>Flow_134</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OUT_Auto_FindRebookSlots" name="Look for a replacement appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.find-appointment-slots" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_132</bpmn:incoming>
      <bpmn:outgoing>Flow_137</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OUT_Bnd_RebookNoSlots" name="No replacement slot" attachedToRef="OUT_Auto_FindRebookSlots">
      <bpmn:outgoing>Flow_136</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_010" errorRef="Error_SCHEDULING_SERVICE_UNAVAILABLE" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Reoffered" name="Replacement appointment offered">
      <bpmn:incoming>Flow_137</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="OUT_Throw_ReferrerNotified" name="Inform the referring organisation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="pathway.closed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=patientRef" target="correlationKey" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_134</bpmn:incoming>
      <bpmn:outgoing>Flow_135</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_005" messageRef="Message_pathway_closed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_PathwayComplete" name="Pathway complete">
      <bpmn:incoming>Flow_135</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="PCW_Start_WeeklyReview" name="Weekly correspondence review">
      <bpmn:outgoing>Flow_138</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_004">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT168H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PCW_Auto_FindOverdueLetters" name="Find the letters that are overdue">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pathway.find-overdue-clinic-letters" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_138</bpmn:incoming>
      <bpmn:outgoing>Flow_139</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PCW_Task_ReviewOverdueList" name="Review the outstanding correspondence list">
      <bpmn:documentation>The sweep produces the management view of referral volumes, outstanding referrals, waiting times, unsuccessful contact attempts, delayed letters, unresolved enquiries, booking delays, outstanding funding approvals, failed payments and refunds awaiting processing.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
        <zeebe:formDefinition formId="review-outstanding-correspondence" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_139</bpmn:incoming>
      <bpmn:outgoing>Flow_140</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PCW_GW_OverdueBand" name="How far overdue is the letter?" default="Flow_143">
      <bpmn:incoming>Flow_140</bpmn:incoming>
      <bpmn:outgoing>Flow_141</bpmn:outgoing>
      <bpmn:outgoing>Flow_142</bpmn:outgoing>
      <bpmn:outgoing>Flow_143</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PCW_Auto_SuppressDuplicates" name="Drop letters that no longer need chasing">
