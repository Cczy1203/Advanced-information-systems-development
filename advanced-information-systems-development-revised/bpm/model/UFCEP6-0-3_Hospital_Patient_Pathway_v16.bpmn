      </bpmn:extensionElements>
      <bpmn:incoming>Flow_174</bpmn:incoming>
      <bpmn:outgoing>Flow_175</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_Auto_ProcessRefund" name="Send the refund to the payment provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.process-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_175</bpmn:incoming>
      <bpmn:outgoing>Flow_177</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="FIN_Bnd_RefundFailed" name="Provider rejected the refund" attachedToRef="FIN_Auto_ProcessRefund">
