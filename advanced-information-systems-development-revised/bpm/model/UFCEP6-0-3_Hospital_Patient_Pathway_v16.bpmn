      <bpmn:outgoing>Flow_180</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_RefundPending" name="Refund still with the provider; patient informed">
      <bpmn:incoming>Flow_178</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_Auto_RecordRefund" name="Record the refund against the patient account">
